	async Task OnDeleteUserCompany(MTL_GetAllUserCompanyResult context)
	{
		var parameters = new DialogParameters<DeleteDialog>();
		parameters.Add(x => x.NoiDung, $"NHÂN VIÊN: {context.Fullname}");
		string tieude = $"XÓA NHÂN VIÊN CÔNG TY [{_Company.Name}]";
		var dialog = await DialogService.ShowEx<DeleteDialog>(tieude, parameters, options);
		var result = await dialog.Result;
		if (!result.Canceled)
		{
			User _userdelete = new User();
			_userdelete.UserId = context.userid;
			await userService.DeleteUserFromCompanyAsync(_userdelete, _Company.Id);
			string mess = $"XÓA NHÂN VIÊN [{_userdelete.Fullname}] CÔNG TY [{_Company.Name}] THÀNH CÔNG";
			_HandleCommon.OpenSusscessSnackbarDialog(SnackbarService, mess);
			ListUser = await userService.GetAllUserSettingAsync(_Company.Id);
		}
