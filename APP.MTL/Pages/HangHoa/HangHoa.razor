	async Task OnSelectWooButtonClick(GridCommandColumnCellDisplayTemplateContext context)
	{
		product_woo = ((APP.WooRestAPI.Product)context.DataItem);
		if (product_woo.sale_price == "") product_woo.sale_price = "0";
		if (product_woo.regular_price == "") product_woo.regular_price = "0";
		PopupVisible_DongBo = true;
	}

	async Task OnConfirm_DongBoWoo()
	{
		product_woo_id = int.Parse(product_woo.id);
		mtl_product.woo_id = int.Parse(product_woo.id);
		mtl_product.tensp = product_woo.name;
		mtl_product.giaban = double.Parse(product_woo.sale_price);
		mtl_product.giathuong = double.Parse(product_woo.regular_price);
		mtl_product.link = product_woo.permalink;
		if (product_woo.images.Count != 0)
			image_product = product_woo.images[0].src.ToString();
		if (product_woo.stock_status == "outofstock")
			mtl_product.hethang = true;
		else if (product_woo.stock_status == "instock")
			mtl_product.hethang = false;
		editorOptions_motangan.InitialText = product_woo.short_description;
		editorOptions_motachitiet.InitialText = product_woo.description;
		PopupVisible_DongBo = false;
	}
	void OnCancel_DongBoWoo()
	{
		product_woo_id = 0;
		PopupVisible_DongBo = false;
	}

