    protected override void OnInitialized()
    {
        AppTheme.ThemeChanged += OnAppThemeChanged;
        base.OnInitialized();
    }

    void OnAppThemeChanged()
    {
        SyncMonthlyPieUiFromTheme(bumpChartKey: true);
        _ = InvokeAsync(StateHasChanged);
    }
    int _monthlyChartVersion;
    int _monthlyPieSelectedIndex = -1;

    int _thuHangChartVersion;
    int _thuHangPieSelectedIndex = -1;
    string[] _thuHangPiePalette = MonthlyPiePaletteBlue;

    // Hover state for custom pie charts (kept for MudChart integration)
    int _hoveredPieDt = -1;
    int _hoveredPieTh = -1;

    // Click event handler for Doanh Thu pie chart
    void OnPieDtClick()
