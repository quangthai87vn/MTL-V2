@page "/tinnhan/facebook"
@layout MainLayout
@attribute [Authorize]
@using MTL.APP.Models
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime
@inject IConfiguration Configuration

<PageStandardHeader Icon="@Icons.Material.Filled.Message" Title="TIN NHẮN FACEBOOK">
    <Actions>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudSelect T="string" @bind-Value="selectedPageId" Label="Fanpage" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width: 200px;">
                @foreach (var fanpage in Fanpages)
                {
                    <MudSelectItem T="string" Value="@fanpage.FanpageId">@fanpage.FanpageName</MudSelectItem>
                }
            </MudSelect>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" OnClick="RefreshData" Title="Làm mới" />
            <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" OnClick="OpenSettings" Title="Cấu hình" />
        </MudStack>
    </Actions>
</PageStandardHeader>

<div class="mtl-page-wrapper">
    <div class="mtl-page-body">
        <MudGrid>
            <!-- Danh sách cuộc trò chuyện -->
            <MudItem xs="12" md="4" lg="3">
                <MudPaper Elevation="2" Class="rounded-lg" Style="height: calc(100vh - 180px); overflow: hidden;">
                    <!-- Search -->
                    <div class="pa-2" style="border-bottom: 1px solid var(--mud-palette-lines-default);">
                        <MudTextField @bind-Value="searchString"
                                      Placeholder="Tìm kiếm cuộc trò chuyện..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Clearable="true"
                                      FullWidth="true" />
                    </div>

                    <!-- Conversation List -->
                    <div style="height: calc(100% - 60px); overflow-y: auto;">
                        @if (IsLoading)
                        {
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height: 200px;">
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                                <MudText Class="mt-2">Đang tải...</MudText>
                            </MudStack>
                        }
                        else if (!Conversations?.Any() ?? true)
                        {
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height: 200px;">
                                <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Style="opacity: 0.3;" />
                                <MudText Color="Color.Default">Không có cuộc trò chuyện nào</MudText>
                            </MudStack>
                        }
                        else
                        {
                            @foreach (var conv in FilteredConversations)
                            {
                                <div class="conversation-item @(SelectedConversation?.ConversationId == conv.ConversationId ? "selected" : "")"
                                     @onclick="() => SelectConversation(conv)">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-wrapper">
                                            @if (!string.IsNullOrEmpty(conv.SenderAvatar))
                                            {
                                                <img src="@conv.SenderAvatar" alt="@conv.SenderName" class="avatar-img" />
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Medium" />
                                            }
                                        </div>
                                        <div class="conversation-info">
                                            <div class="d-flex justify-space-between align-center">
                                                <span class="sender-name">@conv.SenderName</span>
                                                <span class="time-ago">@FormatTimeAgo(conv.LastMessageTime)</span>
                                            </div>
                                            <div class="d-flex justify-space-between align-center">
                                                <span class="last-message @(conv.UnreadCount > 0 ? "unread" : "")">
                                                    @(conv.LastMessage.Length > 40 ? conv.LastMessage.Substring(0, 40) + "..." : conv.LastMessage)
                                                </span>
                                                @if (conv.UnreadCount > 0)
                                                {
                                                    <MudBadge Content="@conv.UnreadCount" Color="Color.Error" Overlap="false" />
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </MudPaper>
            </MudItem>

            <!-- Khung chat -->
            <MudItem xs="12" md="8" lg="9">
                <MudPaper Elevation="2" Class="rounded-lg" Style="height: calc(100vh - 180px); overflow: hidden;">
                    @if (SelectedConversation == null)
                    {
                        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height: 100%;">
                            <MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline" Size="Size.Large" Style="opacity: 0.3;" />
                            <MudText Typo="Typo.h6" Color="Color.Default">Chọn một cuộc trò chuyện để xem</MudText>
                            <MudText Color="Color.Default">Tin nhắn từ khách hàng sẽ hiển thị ở đây</MudText>
                        </MudStack>
                    }
                    else
                    {
                        <!-- Chat Header -->
                        <div class="chat-header" style="border-bottom: 1px solid var(--mud-palette-lines-default);">
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-wrapper">
                                    @if (!string.IsNullOrEmpty(SelectedConversation.SenderAvatar))
                                    {
                                        <img src="@SelectedConversation.SenderAvatar" alt="@SelectedConversation.SenderName" class="avatar-img" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Medium" />
                                    }
                                </div>
                                <div>
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">@SelectedConversation.SenderName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Default">
                                        @SelectedConversation.TotalMessages tin nhắn
                                    </MudText>
                                </div>
                            </div>
                            <MudStack Row="true" Spacing="1">
                                <MudIconButton Icon="@Icons.Material.Filled.History" Color="Color.Default" Title="Lịch sử" OnClick="ShowConversationHistory" />
                                <MudIconButton Icon="@Icons.Material.Filled.PersonSearch" Color="Color.Default" Title="Thông tin khách hàng" OnClick="ShowCustomerInfo" />
                            </MudStack>
                        </div>

                        <!-- Messages -->
                        <div class="chat-messages" id="chatMessages">
                            @if (IsLoadingMessages)
                            {
                                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height: 200px;">
                                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                                </MudStack>
                            }
                            else
                            {
                                @foreach (var msg in Messages)
                                {
                                    <div class="message-wrapper @(msg.IsFromCustomer ? "customer" : "page")">
                                        @if (!msg.IsFromCustomer)
                                        {
                                            <div class="avatar-wrapper">
                                                <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Small" />
                                            </div>
                                        }
                                        <div class="message-bubble">
                                            @if (msg.MessageType == "text")
                                            {
                                                <div class="message-text">@msg.Message</div>
                                            }
                                            else if (msg.MessageType == "image")
                                            {
                                                <img src="@msg.MediaUrl" alt="Hình ảnh" class="message-image" @onclick="() => OpenImage(msg.MediaUrl)" />
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center gap-1">
                                                    <MudIcon Icon="@GetMessageTypeIcon(msg.MessageType)" Size="Size.Small" />
                                                    <a href="@msg.MediaUrl" target="_blank">@msg.MessageType</a>
                                                </div>
                                            }
                                            <div class="message-time">@msg.Timestamp.ToString("HH:mm")</div>
                                        </div>
                                        @if (msg.IsFromCustomer)
                                        {
                                            <div class="avatar-wrapper">
                                                @if (!string.IsNullOrEmpty(msg.SenderAvatar))
                                                {
                                                    <img src="@msg.SenderAvatar" alt="@msg.SenderName" class="avatar-img" />
                                                }
                                                else
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>

                        <!-- Reply Input -->
                        <div class="chat-input" style="border-top: 1px solid var(--mud-palette-lines-default);">
                            <MudGrid Gutter="0">
                                <MudItem xs="12">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                                        <MudTextField @bind-Value="replyText"
                                                      Placeholder="Nhập tin nhắn..."
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Immediate="true"
                                                      OnKeyPress="HandleKeyPress"
                                                      Class="flex-grow-1" />
                                        <MudButton Color="Color.Primary"
                                                   Variant="Variant.Filled"
                                                   OnClick="SendReply"
                                                   Disabled="@(string.IsNullOrWhiteSpace(replyText) || IsSending)"
                                                   StartIcon="@Icons.Material.Filled.Send">
                                            Gửi
                                        </MudButton>
                                    </MudStack>
                                </MudItem>
                            </MudGrid>
                        </div>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </div>
</div>

<style>
    .conversation-item {
        padding: 12px 16px;
        cursor: pointer;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        transition: background-color 0.2s;
    }

    .conversation-item:hover {
        background-color: var(--mud-palette-action-default-hover);
    }

    .conversation-item.selected {
        background-color: var(--mud-palette-primary-hover);
    }

    .avatar-wrapper {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 50%;
        overflow: hidden;
        background-color: var(--mud-palette-action-disabled-background);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .conversation-info {
        flex: 1;
        min-width: 0;
    }

    .sender-name {
        font-weight: 600;
        font-size: 0.9rem;
    }

    .last-message {
        font-size: 0.8rem;
        color: var(--mud-palette-text-secondary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .last-message.unread {
        font-weight: 600;
        color: var(--mud-palette-text-primary);
    }

    .time-ago {
        font-size: 0.7rem;
        color: var(--mud-palette-text-disabled);
    }

    .chat-header {
        padding: 12px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--mud-palette-surface);
    }

    .chat-messages {
        height: calc(100% - 130px);
        overflow-y: auto;
        padding: 16px;
        background: #f5f5f5;
    }

    .message-wrapper {
        display: flex;
        gap: 8px;
        margin-bottom: 16px;
        max-width: 75%;
    }

    .message-wrapper.customer {
        margin-right: auto;
    }

    .message-wrapper.page {
        margin-left: auto;
        flex-direction: row-reverse;
    }

    .message-bubble {
        padding: 10px 14px;
        border-radius: 16px;
        max-width: 100%;
    }

    .message-wrapper.customer .message-bubble {
        background-color: #fff;
        border-bottom-left-radius: 4px;
    }

    .message-wrapper.page .message-bubble {
        background-color: var(--mud-palette-primary);
        color: #fff;
        border-bottom-right-radius: 4px;
    }

    .message-text {
        font-size: 0.9rem;
        word-wrap: break-word;
        white-space: pre-wrap;
    }

    .message-image {
        max-width: 250px;
        max-height: 200px;
        border-radius: 8px;
        cursor: pointer;
    }

    .message-time {
        font-size: 0.7rem;
        opacity: 0.7;
        text-align: right;
        margin-top: 4px;
    }

    .chat-input {
        padding: 12px 16px;
        background: var(--mud-palette-surface);
    }
</style>

@code {
    private List<FacebookConversation> Conversations = new();
    private List<FacebookConversation> FilteredConversations = new();
    private FacebookConversation? SelectedConversation;
    private List<FacebookMessage> Messages = new();
    private string searchString = "";
    private string selectedPageId = "";
    private string replyText = "";
    private bool IsLoading = false;
    private bool IsLoadingMessages = false;
    private bool IsSending = false;

    private List<FanpageInfo> Fanpages = new();

    protected override async Task OnInitializedAsync()
    {
        // Load fanpages từ config
        await LoadFanpages();
        
        if (Fanpages.Any())
        {
            selectedPageId = Fanpages.First().FanpageId;
            await LoadConversations();
        }
    }

    private async Task LoadFanpages()
    {
        // Load fanpages từ appsettings.json
        var facebookSettings = Configuration.GetSection("FacebookSettings").Get<FacebookSettingsConfig>();

        if (facebookSettings?.Fanpages != null && facebookSettings.Fanpages.Any())
        {
            Fanpages = facebookSettings.Fanpages;
        }
        else
        {
            // Fallback: demo data
            Fanpages = new List<FanpageInfo>
            {
                new FanpageInfo { FanpageId = "YOUR_PAGE_ID_1", FanpageName = "Mỹ Tho Laptop", UnreadCount = 0 },
                new FanpageInfo { FanpageId = "YOUR_PAGE_ID_2", FanpageName = "MTL Technology", UnreadCount = 0 }
            };
        }
    }

    private async Task LoadConversations()
    {
        if (string.IsNullOrEmpty(selectedPageId)) return;

        IsLoading = true;
        try
        {
            var response = await Http.GetAsync($"api/facebook/messages/conversations/{selectedPageId}");
            if (response.IsSuccessStatusCode)
            {
                Conversations = await response.Content.ReadFromJsonAsync<List<FacebookConversation>>() ?? new();
                FilteredConversations = Conversations;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi tải cuộc trò chuyện: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SelectConversation(FacebookConversation conversation)
    {
        SelectedConversation = conversation;
        await LoadMessages();
        await MarkAsRead();
    }

    private async Task LoadMessages()
    {
        if (SelectedConversation == null || string.IsNullOrEmpty(selectedPageId)) return;

        IsLoadingMessages = true;
        try
        {
            var response = await Http.GetAsync(
                $"api/facebook/messages/conversations/{selectedPageId}/{SelectedConversation.ConversationId}");
            
            if (response.IsSuccessStatusCode)
            {
                Messages = await response.Content.ReadFromJsonAsync<List<FacebookMessage>>() ?? new();
                StateHasChanged();
                
                // Scroll to bottom
                await Task.Delay(100);
                await JsRuntime.InvokeVoidAsync("scrollToBottom", "chatMessages");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi tải tin nhắn: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsLoadingMessages = false;
        }
    }

    private async Task MarkAsRead()
    {
        if (SelectedConversation == null || string.IsNullOrEmpty(selectedPageId)) return;

        try
        {
            await Http.PostAsync(
                $"api/facebook/messages/conversations/{selectedPageId}/{SelectedConversation.ConversationId}/read",
                null);

            // Update local state
            SelectedConversation.UnreadCount = 0;
            var conv = Conversations.FirstOrDefault(c => c.ConversationId == SelectedConversation.ConversationId);
            if (conv != null) conv.UnreadCount = 0;
        }
        catch { }
    }

    private async Task SendReply()
    {
        if (SelectedConversation == null || string.IsNullOrWhiteSpace(replyText)) return;

        IsSending = true;
        try
        {
            var request = new
            {
                RecipientId = SelectedConversation.ConversationId,
                PageId = selectedPageId,
                MessageText = replyText,
                Idcompany = 1
            };

            var response = await Http.PostAsJsonAsync("api/facebook/messages/send", request);
            
            if (response.IsSuccessStatusCode)
            {
                var sentMessage = await response.Content.ReadFromJsonAsync<FacebookMessage>();
                if (sentMessage != null)
                {
                    Messages.Add(sentMessage);
                    replyText = "";
                    StateHasChanged();
                }
            }
            else
            {
                Snackbar.Add("Gửi tin nhắn thất bại", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi gửi tin nhắn: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsSending = false;
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendReply();
        }
    }

    private async Task RefreshData()
    {
        await LoadConversations();
        if (SelectedConversation != null)
        {
            await LoadMessages();
        }
        Snackbar.Add("Đã làm mới dữ liệu", Severity.Success);
    }

    private void OpenSettings()
    {
        // TODO: Mở dialog cấu hình
        Snackbar.Add("Chức năng đang phát triển", Severity.Info);
    }

    private void ShowConversationHistory()
    {
        // TODO: Mở dialog lịch sử cuộc trò chuyện
    }

    private void ShowCustomerInfo()
    {
        // TODO: Mở dialog thông tin khách hàng
    }

    private void OpenImage(string? url)
    {
        if (!string.IsNullOrEmpty(url))
        {
            JsRuntime.InvokeVoidAsync("window.open", url, "_blank");
        }
    }

    private string GetMessageTypeIcon(string messageType)
    {
        return messageType switch
        {
            "image" => Icons.Material.Filled.Image,
            "audio" => Icons.Material.Filled.AudioFile,
            "video" => Icons.Material.Filled.VideoFile,
            "file" => Icons.Material.Filled.InsertDriveFile,
            "sticker" => Icons.Material.Filled.EmojiEmotions,
            _ => Icons.Material.Filled.Description
        };
    }

    private string FormatTimeAgo(DateTime dateTime)
    {
        var timeSpan = DateTime.Now - dateTime;
        
        if (timeSpan.TotalMinutes < 1) return "Vừa xong";
        if (timeSpan.TotalMinutes < 60) return $"{(int)timeSpan.TotalMinutes} phút";
        if (timeSpan.TotalHours < 24) return $"{(int)timeSpan.TotalHours} giờ";
        if (timeSpan.TotalDays < 7) return $"{(int)timeSpan.TotalDays} ngày";
        
        return dateTime.ToString("dd/MM/yyyy");
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }
}
