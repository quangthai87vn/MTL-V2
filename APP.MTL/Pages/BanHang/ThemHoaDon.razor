	void HydratePaymentFromLegacy()
	{
		if (hdbh == null) return;
		// Gộp quẹt thẻ (cũ) với chuyển khoản trên giao diện
		if (hdbh.Idhinhthucthanhtoan == MTLEnum.HinhThucThanhToan.Quetthe)
			hdbh.Idhinhthucthanhtoan = MTLEnum.HinhThucThanhToan.ChuyenKhoan;
		var tm = hdbh.Tienmat ?? 0;
		var ck = hdbh.Tienchuyenkhoan ?? 0;
		var dk = hdbh.Tienchuyenkhoandukien ?? 0;
		if (tm < 0.01 && ck < 0.01 && dk < 0.01 && (hdbh.Thanhtoan ?? 0) > 0.01)
		{
			var htt = hdbh.Idhinhthucthanhtoan ?? MTLEnum.HinhThucThanhToan.TienMat;
			if (htt == MTLEnum.HinhThucThanhToan.TienMat)
				hdbh.Tienmat = hdbh.Thanhtoan;
			else if (htt == MTLEnum.HinhThucThanhToan.ChuyenKhoan || htt == MTLEnum.HinhThucThanhToan.Quetthe)
				hdbh.Tienchuyenkhoan = hdbh.Thanhtoan;
			else if (htt == MTLEnum.HinhThucThanhToan.Tragop)
			{
				hdbh.Tienmat = hdbh.Thanhtoan;
				hdbh.Tienchuyenkhoandukien = hdbh.Conlai;
			}
		}
	}

	void ApplyPaymentModeToAmounts()
	{
		var total = hdbh.Tongtiensauvat ?? 0;
		var id = hdbh.Idhinhthucthanhtoan ?? MTLEnum.HinhThucThanhToan.TienMat;
		switch (id)
		{
			case MTLEnum.HinhThucThanhToan.TienMat:
				hdbh.Tienmat = total;
				hdbh.Tienchuyenkhoan = 0;
				hdbh.Tienchuyenkhoandukien = 0;
				hdbh.Ngaydukienchuyenkhoan = null;
				hdbh.Thanhtoan = total;
				hdbh.Conlai = 0;
				break;
			case MTLEnum.HinhThucThanhToan.ChuyenKhoan:
			case MTLEnum.HinhThucThanhToan.Quetthe:
				hdbh.Tienmat = 0;
				hdbh.Tienchuyenkhoan = total;
				hdbh.Tienchuyenkhoandukien = 0;
				hdbh.Ngaydukienchuyenkhoan = null;
				hdbh.Thanhtoan = total;
				hdbh.Conlai = 0;
				break;
			case MTLEnum.HinhThucThanhToan.TienMatVaChuyenKhoan:
			{
				var ck0 = hdbh.Tienchuyenkhoan ?? 0;
				if (ck0 < 0.01 && (hdbh.Tienmat ?? 0) < 0.01)
					ck0 = Math.Round(total / 2, 0);
				if (ck0 > total) ck0 = total;
				hdbh.Tienchuyenkhoan = ck0;
				hdbh.Tienmat = total - ck0;
				hdbh.Tienchuyenkhoandukien = 0;
				hdbh.Ngaydukienchuyenkhoan = null;
				hdbh.Thanhtoan = total;
				hdbh.Conlai = 0;
				break;
			}
			case MTLEnum.HinhThucThanhToan.Tragop:
			{
				var ckPart = hdbh.Tienchuyenkhoandukien ?? hdbh.Conlai ?? 0;
				if (ckPart < 0.01 && (hdbh.Tienmat ?? 0) < 0.01)
					ckPart = Math.Round(total / 2, 0);
				if (ckPart > total) ckPart = total;
				hdbh.Tienchuyenkhoan = 0;
				hdbh.Tienchuyenkhoandukien = ckPart;
				hdbh.Tienmat = total - ckPart;
				hdbh.Thanhtoan = hdbh.Tienmat;
				hdbh.Conlai = ckPart;
				hdbh.Ngaydukienchuyenkhoan = null;
				break;
			}
		}
	}

	void OnTienCkMixedChanged(double? v)
	{
		hdbh.Idhinhthucthanhtoan = MTLEnum.HinhThucThanhToan.TienMatVaChuyenKhoan;
		var total = hdbh.Tongtiensauvat ?? 0;
		var ck = Math.Max(0, v ?? 0);
		if (ck > total) ck = total;
		hdbh.Tienchuyenkhoan = ck;
		hdbh.Tienmat = total - ck;
		hdbh.Thanhtoan = total;
		hdbh.Conlai = 0;
		hdbh.Tienchuyenkhoandukien = 0;
		StateHasChanged();
	}

	void OnTienCkTraGopChanged(double? v)
	{
		hdbh.Idhinhthucthanhtoan = MTLEnum.HinhThucThanhToan.Tragop;
		var total = hdbh.Tongtiensauvat ?? 0;
