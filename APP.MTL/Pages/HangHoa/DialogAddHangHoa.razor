@using Blazored.Toast
@using Blazored.Toast.Services
@using MTL.APP.Models;
@using MTL.APP.Pages.ThuongHieu
@using MTL.APP.Services
@using System.ComponentModel.DataAnnotations
@using FluentValidation;
@using System.Globalization
@using MTL.APP.Utils
@using MudBlazor.Extensions.Options
@using MudBlazor.Extensions.Core
@using MudBlazor.Extensions
@using MudBlazor.Utilities
@using MudExRichTextEditor
@using static MTL.APP.MTLEnum
@inject IJSRuntime JSRuntime
@inject HangHoaService hangHoaService
@inject UserService userService
@inject IToastService toastService
@inject APIWooService wooAPIService
@inject ISnackbar SnackbarService
@inject Configs configs
@inject MudBlazor.IDialogService DialogService
@attribute [Authorize]
<MudDialog Class="blur dialog-background"
		   TitleClass="blur dialog-background-title"
		   ContentClass="dialog-background-surface pa-4"
		   ActionsClass="dialog-background-surface mtl-themdon-dialog-actions">
	<DialogContent>
		<MudForm @ref="form" Model="@model" Validation=@(Validator.ValidateValue)>
			<SpinLoader IsLoading=@IsLoadingSave Spinner="SpinnerType.Chase">
				<LoadingTemplate>
					<Loading />
				</LoadingTemplate>
				<ContentTemplate>
					<MudGrid Spacing=1>
						<MudItem xs="12" sm="12" md="12">
							<MudSelect Required="true"
									   T=int?
									   @bind-Value=model.Idloaihanghoadichvu
									   Label="Chọn loại hình KD"
									   Margin="Margin.Dense"
									   Variant="Variant.Outlined"
									   AnchorOrigin="Origin.BottomCenter">
								@foreach (var loai in LoaiHHDVList)
								{
									<MudSelectItem T=int? Value="@loai.Id">@loai.Loaihinhkinhdoanh</MudSelectItem>
								}
							</MudSelect>
						</MudItem>
						<MudItem xs="12" sm="12" md="12">
							<MudTabs Elevation="4" Rounded="true" Centered="true" Color="@Color.Primary">
								<MudTabPanel Disabled=IsLoadingAPI Icon="@Icons.Material.Filled.List" Text="THÔNG TIN">
									<br />
									<MudGrid>
										<MudItem xs="12" sm="12" md="3">
											<MudPaper Class="pa-4" Elevation="4">
												<SpinLoader IsLoading=@IsLoadingAPI Spinner="SpinnerType.Chase">
													<LoadingTemplate>
														<Loading />
													</LoadingTemplate>
													<ContentTemplate>
														<MudGrid Spacing=1>
															<MudItem xs="12" sm="12" md="12">
																<MudImage Fluid="true" Src="@model.Pic00" Alt="@model.Tensp" />

															</MudItem>
														</MudGrid>
													</ContentTemplate>
												</SpinLoader>
											</MudPaper>
										</MudItem>
										<MudItem xs="12" sm="12" md="9">
											<MudPaper Class="pa-4" Elevation="4">
												<MudGrid Spacing=1>
													<MudItem xs="12" sm="12" md="12">
														<MudTextField T="string" Label="Tên hàng" For="@(() => model.Tensp)"
														HelperTextOnFocus="true" ReadOnly=IsLoadingAPI
														@bind-Text=@model.Tensp />
													</MudItem>
													<MudItem xs="12" sm="12" md="12">
														<MudExGradientText Typo="Typo.body1" style="color:var(--mud-palette-primary); font-weight: bold;"><a target="_blank" href=@model.Link>@model.Link</a></MudExGradientText>
													</MudItem>
													<MudItem xs="12" sm="12" md="12">
														<MudAutocomplete T="MTL_GetAllNhomHangResult" Label="Chọn nhóm hàng"
														Disabled=IsLoadingAPI Clearable="true"
														SearchFunc="@SearchNhomHangAsync" MaxItems="100"
														Value=@mtl_nhomhang
														ResetValueOnEmptyText=true
														ValueChanged="NhomHangValueChanged"
														ToStringFunc="@(e=> e==null?null : $"{e.nhomhang}")">
														</MudAutocomplete>
													</MudItem>
													@if ((bool)userSession.company.IsThuongHieu)
													{
														<MudItem xs="7" sm="7" md="10">
															@if(mtl_thuonghieu!=null)
															{
																<MudAutocomplete T="MTL_GetAllThuongHieuResult" Label="Chọn thương hiệu"
																Disabled=IsLoadingAPI Clearable="true"
																SearchFunc="@SearchThuongHieuAsync"
																Value=@mtl_thuonghieu MaxItems="100"
																ResetValueOnEmptyText=true
																ValueChanged="ThuongHieuValueChanged"
																ToStringFunc="@(e=> e==null?null : $"{e.thuonghieu} - ({e.viettat?.Trim()})")" >																			
																</MudAutocomplete>
															}

														</MudItem>
													<MudItem xs="5" sm="5" md="2">
														<MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
														Disabled=IsLoadingAPI
														OnClick="ThemThuongHieuDialog" Color="Color.Primary">THÊM T.HIỆU</MudButton>
													</MudItem>
													}
													<MudItem xs="4" sm="4" md="4">
														<MudTextField T="string" Label="Mã hàng"
														HelperTextOnFocus="true" Disabled=IsLoadingAPI
														@bind-Text=model.Masp />
													</MudItem>
													<MudItem xs="4" sm="4" md="4">
														<MudTextField T="string" Label="Model"
														HelperTextOnFocus="true" Disabled=IsLoadingAPI
														TextChanged="OnTextChanged_Model"
														Text=@model.Model />
													</MudItem>
													<MudItem xs="4" sm="4" md="4">
														<MudSwitch Value=!model.Active
														Disabled=IsLoadingAPI Label="Hết hàng"
														ValueChanged="isHetHang_CheckedChanged"
														T="bool?" Color="Color.Primary" />
													</MudItem>
													<MudItem xs="4" sm="4" md="4">
														<MudNumericField HideSpinButtons="true"
														Label="Nhập giá mua vào"
														@bind-Value=model.Giavon
														Format="N0"
														Class="curency"
														Disabled=IsLoadingAPI />
													</MudItem>
													<MudItem xs="4" sm="4" md="4">
														<MudNumericField HideSpinButtons="true"
														Label="Nhập giá bán lẻ"
														@bind-Value=model.Giaban
														Format="N0"
														Class="curency"
														Disabled=IsLoadingAPI />
													</MudItem>
													<MudItem xs="4" sm="4" md="4">
														<MudNumericField HideSpinButtons="true"
														Label="Nhập giá chưa khuyến mãi"
														@bind-Value=model.Giathuong
														Format="N0"
														Class="curency"
														Disabled=IsLoadingAPI />
													</MudItem>
													@if ((bool)userSession.company.IsKhoHang)
													{
														<MudItem xs="4" sm="4" md="4" Class="d-flex align-start justify-center">
													<MudSelect Label="Kho hàng" T="int?"
														@bind-Value=model.Idvitri
														Disabled=IsLoadingAPI
														AnchorOrigin="Origin.BottomCenter">
																@if (ViTriList != null)
																{
																	foreach (var item in ViTriList)
																	{
																		<MudSelectItem T="int?" Value="@item.Id">@item.Vitri</MudSelectItem>
																	}
																}
															</MudSelect>
														</MudItem>
													}
													@if ((bool)userSession.company.IsBaoHanh)
													{
														<MudItem xs="4" sm="4" md="4">
													<MudSelect Label="Bảo hành" T="int?"
														@bind-Value=model.IdBaoHanh
														Disabled=IsLoadingAPI
														AnchorOrigin="Origin.BottomCenter">
																@if (BaoHanhList != null)
																{
																	foreach (var item in BaoHanhList)
																	{
																		<MudSelectItem T="int?" Value="@item.Id">@item.Baohanh</MudSelectItem>
																	}
																}
															</MudSelect>
														</MudItem>
													}
													<MudItem xs="4" sm="4" md="4">
														<MudSelect Label="Đơn vị tính" T="int?"
														@bind-Value=model.Iddonvitinh
														Disabled=IsLoadingAPI
														AnchorOrigin="Origin.BottomCenter">
															@if (DVTList != null)
															{
																foreach (var item in DVTList)
																{
																	<MudSelectItem T="int?" Value="@item.Id">@item.Donvitinh</MudSelectItem>
																}
															}
														</MudSelect>
													</MudItem>

													@if (model.Idloaihanghoadichvu == 1)
													{
														<MudItem xs="12" sm="12" md="12">
															<MudTextField T="string" Label="Block Woo Sản phẩm" Disabled=IsLoadingAPI 
															HelperTextOnFocus="true"
															@bind-Text=model.WooBlockSanpham />
														</MudItem>
													}
													else if (model.Idloaihanghoadichvu == 3)
													{
														<MudItem xs="12" sm="12" md="12">
															<MudExRichTextEdit @bind-Value=@block_woo_sanpham_ghepnoi ReadOnly=IsLoadingAPI
															EnableResize="true" Height="400"
															Class="m-2">
															</MudExRichTextEdit>
														</MudItem>
													}





												</MudGrid>
											</MudPaper>
										</MudItem>
									</MudGrid>
								</MudTabPanel>
								@if (model.Idloaihanghoadichvu == 3) // Là thành phần *@
								{
									int SLHHTP = 0;
									if (@ListHangHoaThanhPhan != null)
									{
										SLHHTP = ListHangHoaThanhPhan.Count;
									}
									<MudTabPanel Disabled=IsLoadingAPI Icon="@Icons.Material.Filled.AddBox" Text="THÀNH PHẦN" BadgeData="@SLHHTP">
										<br />
										<MudPaper Class="pa-4" Elevation="4">
											<MudGrid>
												<MudItem xs="12" sm="12" md="6">
													<MudButton Variant="Variant.Filled"
													FullWidth=true StartIcon="@Icons.Material.Filled.Add"
													Disabled=IsLoadingAPI
													OnClick="ThemHangHoaThanhPhan"
													Color="Color.Secondary">THÊM MỚI THÀNH PHẦN</MudButton>
												</MudItem>
												<MudItem xs="12" sm="12" md="6">
													<MudButton Variant="Variant.Filled"
													FullWidth=true StartIcon="@Icons.Material.Filled.Add"
													Disabled=IsLoadingAPI
													OnClick="NhanBanThanhPhan"
													Color=Color.Tertiary>NHÂN BẢN THÀNH PHẦN</MudButton>
												</MudItem>
												<MudItem xs="12" sm="12" md="12">
													<MudTable Items="@ListHangHoaThanhPhan"
													Hover="true"
													Striped="true"
													Bordered="false"
													RowsPerPage="50"
													Class="mudtable-center-header">
														<HeaderContent>
															<MudTh Style="width:40px; text-align:center;">T.TÁC</MudTh>
															<MudTh Style="width:40px; text-align:center;">ẢNH</MudTh>
															<MudTh>SẢN PHẨM THÀNH PHẦN</MudTh>
															<MudTh Style="width:250px; text-align:right;">BlOCK</MudTh>
															<MudTh Style="width:50px; text-align:right;">SL</MudTh>
															<MudTh Style="width:80px; text-align:right;">Đ.GIÁ</MudTh>
															<MudTh Style="width:80px; text-align:right;">T.TIỀN</MudTh>
															<MudTh Style="width:90px; text-align:center;">B.HÀNH</MudTh>
														</HeaderContent>
														<RowTemplate Context="sanphamthanhphan">
															<MudTd DataLabel="T.TÁC">
																<MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" OverrideStyles=false>
																	<MudIconButton @onclick="@(() => SuaHangHoaThanhPhan(sanphamthanhphan))"
																	Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled"
																	Color="Color.Primary" Size="Size.Medium" />
																	<MudIconButton @onclick="@(() => Delete_HangHoaThanhPhan(sanphamthanhphan))"
																	Icon="@Icons.Material.Filled.Delete" Variant="Variant.Filled"
																	Color="Color.Error" Size="Size.Medium" />
																</MudButtonGroup>
															</MudTd>
															<MudTd DataLabel="ẢNH">
																@{
																	string url_anhdaidien = userSession.company.Logourl;
																	if (((MTL_GetSanPhamThanhPhanResult)sanphamthanhphan).pic00 != null)
																	{
																		url_anhdaidien = ((MTL_GetSanPhamThanhPhanResult)sanphamthanhphan).pic00;
																	}
																	<img src=@url_anhdaidien alt="" width="30px" height="30px">
																}
															</MudTd>
															<MudTd DataLabel="SẢN PHẨM THÀNH PHẦN">
																@{
																	var webUrl = ((MTL_GetSanPhamThanhPhanResult)sanphamthanhphan).linksanpham;

																	if (webUrl != null)
																	{
																		if (webUrl != "")
																		{
																			<a target="_blank" href=@webUrl>@sanphamthanhphan.tensp</a>
																		}
																		else
																		{
																			<a target="_blank">@sanphamthanhphan.tensp</a>
																		}
																	}
																	else
																	{
																		<a target="_blank">@sanphamthanhphan.tensp</a>
																	}
																}
															</MudTd>
															<MudTd DataLabel="SL">
																<p style="color:black ;text-align:right;">@sanphamthanhphan.woo_block_sanpham</p>
															</MudTd>
															<MudTd DataLabel="SL">
																<p style="color:black ;text-align:right;">@sanphamthanhphan.sl</p>
															</MudTd>
															<MudTd DataLabel="Đ.GIÁ">
																<p style="color:var(--mud-palette-primary) ;text-align:right;">@FormatCurrency(sanphamthanhphan.giaban)</p>
															</MudTd>
															<MudTd DataLabel="T.TIỀN">
																<p style="font-weight: bold; color:red ;text-align:right;">@FormatCurrency(sanphamthanhphan.thanhtien)</p>
															</MudTd>
															<MudTd DataLabel="B.HÀNH">
																<p style="color:black ;text-align:right;">
																	@BaoHanhList.Where(p => p.Id == sanphamthanhphan.idbaohanh).FirstOrDefault().Baohanh
																</p>
															</MudTd>
														</RowTemplate>
														<FooterContent>
															<MudTd ColSpan="2" Style="text-align:right; font-weight:bold;">Chủng loại SP: @ListHangHoaThanhPhan.Count</MudTd>
															<MudTd ColSpan="2" Style="text-align:right; font-weight:bold;">Số lượng: @ListHangHoaThanhPhan.Sum(x => x.sl)</MudTd>
															<MudTd ColSpan="2" Style="text-align:right; font-weight:bold;">Tổng cộng:</MudTd>
															<MudTd Style="text-align:center; font-weight:bold; color:red;">
																@FormatCurrency(ListHangHoaThanhPhan.Sum(x => x.thanhtien))
															</MudTd>
														</FooterContent>
														<PagerContent>
															<MudTablePager PageSizeOptions="new int[] { 20,50 }" />
														</PagerContent>
													</MudTable>
												</MudItem>
											</MudGrid>
										</MudPaper>
									</MudTabPanel>
								}
								@{
									var tenWoo = "WOO - " + @model.WooId.ToString();
									<MudTabPanel Disabled=IsLoadingAPI Icon="@Icons.Material.Filled.Web" Text=@tenWoo>
										<br />
										<MudPaper Class="pa-4" Elevation="4">
											@{
												CultureInfo Culture_vn = new CultureInfo("vn-VN", false);
												Culture_vn.DateTimeFormat.ShortDatePattern = "dd/MM/yyyy";
												Culture_vn.DateTimeFormat.DateSeparator = "/";
												Culture_vn.NumberFormat.PercentDecimalSeparator = ".";
											}
											<MudGrid Spacing=1>
												<MudItem xs="6" sm="6" md="2">
													<MudTextField T="DateTime" @bind-Value=@_filterAPI.date_created
													Format="s" Label="Ngày tạo" InputType="InputType.DateTimeLocal" />
												</MudItem>
												<MudItem xs="6" sm="6" md="2">
													<MudTextField T="DateTime" @bind-Value=@_filterAPI.date_modified
													Format="s" Label="Ngày cập nhật" InputType="InputType.DateTimeLocal" />
												</MudItem>
												<MudItem xs="12" sm="12" md="8">
													<MudTextField T="string" Label="Gõ hàng hóa cần tìm"
													style="color:blue; font-weight: bold;"
													TextChanged="OnSearchAPITextChanged"
													HelperTextOnFocus="true" Disabled=IsLoadingAPI
													Text=@_filterAPI.v_timhanghoa />
												</MudItem>
												<MudItem xs="12" sm="12" md="5">
													<MudRadioGroup T="string" Value="@_filterAPI.v_tonkho" SelectedOptionChanged="OnRadioTonKhoChange">
														<MudRadio Value=MTLEnum.TonKhoAPI.TatCa Color="Color.Primary">TẤT CẢ</MudRadio>
														<MudRadio Value=MTLEnum.TonKhoAPI.ConHang Color="Color.Secondary">CÒN HÀNG</MudRadio>
														<MudRadio Value=MTLEnum.TonKhoAPI.ChoHang Color="Color.Success">CHỜ HÀNG</MudRadio>
														<MudRadio Value=MTLEnum.TonKhoAPI.HetHang Color="Color.Primary">HẾT HÀNG</MudRadio>
													</MudRadioGroup>
												</MudItem>
												<MudItem xs="3" sm="3" md="1">
													<MudButton Size=Size.Small Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Pageview"
													FullWidth="true" Disabled=IsLoadingAPI
													OnClick="@Trang1" Color="Color.Primary">Trang 1</MudButton>
												</MudItem>
												<MudItem xs="3" sm="3" md="1">
													<MudButton Size=Size.Small Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Pageview"
													FullWidth="true" Disabled=IsLoadingAPI
													OnClick="@Trang2" Color="Color.Primary">Trang 2</MudButton>
												</MudItem>
												<MudItem xs="3" sm="3" md="1">
													<MudButton Size=Size.Small Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Pageview"
													FullWidth="true" Disabled=IsLoadingAPI
													OnClick="@Trang3" Color="Color.Primary">Trang 3</MudButton>
												</MudItem>
												<MudItem xs="3" sm="3" md="1">
													<MudButton Size=Size.Small Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Pageview"
													FullWidth="true" Disabled=IsLoadingAPI
													OnClick="@Trang4" Color="Color.Primary">Trang 4</MudButton>
												</MudItem>
												<MudItem xs="3" sm="3" md="1">
													<MudButton Size=Size.Small Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Pageview"
													FullWidth="true" Disabled=IsLoadingAPI
													OnClick="@Trang5" Color="Color.Primary">Trang 5</MudButton>
												</MudItem>
												<MudItem xs="3" sm="3" md="1">
													<MudButton Size=Size.Small Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Pageview"
													FullWidth="true" Disabled=IsLoadingAPI
													OnClick="@Trang6" Color="Color.Primary">Trang 6</MudButton>
												</MudItem>
												<MudItem xs="3" sm="3" md="1">
													<MudButton Size=Size.Small Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Pageview"
													FullWidth="true" Disabled=IsLoadingAPI
													OnClick="@Trang7" Color="Color.Primary">Trang 7</MudButton>
												</MudItem>
												<MudItem xs="12" sm="12" md="12">
													<SpinLoader IsLoading="IsLoadingAPI" Spinner="SpinnerType.Chase">
														<LoadingTemplate>
															<Loading />
														</LoadingTemplate>
														<ContentTemplate>
															@if (productlist_API != null)
															{
																<MudTable Items="@productlist_API"
																Hover="true"
																Striped="true"
																Bordered="false"
																RowsPerPage="50"
																Class="mudtable-center-header">
																	<HeaderContent>
																		<MudTh Style="width:40px; text-align:center;">T.TÁC</MudTh>
																		<MudTh Style="width:40px; text-align:center;">WOO</MudTh>
																		<MudTh Style="width:40px; text-align:center;">ẢNH</MudTh>
																		<MudTh>SẢN PHẨM</MudTh>
																		<MudTh Style="width:90px; text-align:center;">TỒN</MudTh>
																		<MudTh Style="width:90px; text-align:center;">GIÁ SALE</MudTh>
																		<MudTh Style="width:90px; text-align:center;">GIÁ BÁN</MudTh>
																	</HeaderContent>
																	<RowTemplate Context="contextWoo">
																		<MudTd DataLabel="T.TÁC">
																			<MudIconButton OnClick="@(() => DongBoWoo(contextWoo))" Icon="@Icons.Material.Filled.Check"
																			Variant="Variant.Filled" Color="Color.Error" Size="Size.Medium" />
																		</MudTd>
																		<MudTd DataLabel="WOO">
																			@{
																				var permalink = ((APP.WooRestAPI.Product)contextWoo).permalink;
																				string product_id = ((APP.WooRestAPI.Product)contextWoo).id.ToString();
																				<a target="_blank" href=@permalink style="color: red">@product_id</a>
																			}
																		</MudTd>
																		<MudTd DataLabel="ẢNH">
																			@{
																				List<MTL.APP.WooRestAPI.image> images = ((APP.WooRestAPI.Product)contextWoo).images;
																				string url_image = "";
																				if (images.Count > 0)
																					url_image = images[0].src;
																				else url_image = userSession.company.Logourl;
																				<img src=@url_image alt="MTL Technology" width="30px" height="30px">
																			}
																		</MudTd>
																		<MudTd DataLabel="SẢN PHẨM">@contextWoo.name</MudTd>
																		<MudTd DataLabel="TỒN">
																			@{
																				string stock = ((APP.WooRestAPI.Product)contextWoo).stock_status;
																				if (stock == "instock") stock = "Còn";
																				else if (stock == "outofstock") stock = "Hết";
																				else if (stock == "onbackorder") stock = "Chờ";
																				<p style="font-weight: bold; color: red;text-align:right;">@stock</p>
																			}
																		</MudTd>
																		<MudTd DataLabel="GIÁ SALE">
