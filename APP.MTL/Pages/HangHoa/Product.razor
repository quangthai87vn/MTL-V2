	/// <summary>Thẻ sản phẩm: hiển thị giá bán + giá thường (niêm yết) cùng một dòng khi khác nhau.</summary>
	static bool ProductShowDualCardPrices(MTL_GetAllProductsInCompanyResult p)
	{
		if (p is null) return false;
		if (p.giaban is null) return false;
		if (p.giathuong is null || p.giathuong <= 0) return false;
		return Math.Abs(p.giathuong.Value - p.giaban.Value) > 0.01;
	}

