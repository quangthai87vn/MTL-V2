	MudForm form;

	string url_anhdaidien = "";
	MarkupString AlertMessage = new MarkupString("<strong>No file selected</strong>");
	string AlertClass = "alert alert-info";
	int ProgressPercentage = 0;
	IBrowserFile selectedFile;
	long maxFileSize = 1024L * 1024L * 1024L * 2L;
	string[] allowedExtensions = { ".jpg", ".png", ".jpeg", ".mp4" };
	bool IsUploadDisabled = true;
	private Guid inputFileId = Guid.NewGuid();
	IList<IBrowserFile> files = new List<IBrowserFile>();



	DialogOptionsEx options = new DialogOptionsEx
	{
		MaxWidth = MaxWidth.ExtraExtraLarge,
		MaximizeButton = true,
		CloseButton = true,
		Position = DialogPosition.Center,
		DragMode = MudDialogDragMode.Simple,
		CloseOnEscapeKey = true,

	};
	DialogOptionsEx options_dialog = new DialogOptionsEx
		{
			MaxWidth = MaxWidth.ExtraLarge,
			MaximizeButton = false,
			CloseButton = true,
			Position = DialogPosition.Center,
			DragMode = MudDialogDragMode.Simple,
			CloseOnEscapeKey = true,
			FullScreen = false
		};

	private async void UploadProductImage(IBrowserFile file)
	{
		files.Add(file);
		//TODO upload the files to the server
		await OnSubmit();
	}
	private async Task OnSubmit()
	{
		if (files != null)
		{
			IsUploadDisabled = true;
			selectedFile = files[0];
			Stream stream = selectedFile.OpenReadStream(maxFileSize);
			//string path_saveimage = "/uploads/GYM/members";// mtlsettings.urluploadGame;// userSession.company.UploadProductUrl;
			//var path = $"{env.WebRootPath}\\{path_saveimage}\\{selectedFile.Name}";
			var path = $"{env.WebRootPath}\\uploads\\{userSession.company.UploadUrl}\\customer\\{selectedFile.Name}";
			//var path = $"{env.WebRootPath}\\Uploads\\GYM\\members\\{selectedFile.Name}";
			//var path = $"{path_saveimage}/{selectedFile.Name}";
			using FileStream fs = File.Create(path);
			// Set buffer size to 512 KB.
			int bufferSize = 512 * 1024;
			byte[] buffer = System.Buffers.ArrayPool<byte>.Shared.Rent(bufferSize);
			int bytesRead;
			long totalBytesRead = 0;
			long fileSize = selectedFile.Size;
			// Use a timer to update the UI every few hundred milliseconds.
			using var timer = new Timer(_ => InvokeAsync(() => StateHasChanged()));
			timer.Change(TimeSpan.FromMilliseconds(500), TimeSpan.FromMilliseconds(500));
			try
			{
				while ((bytesRead = await stream.ReadAsync(buffer)) != 0)
				{
					totalBytesRead += bytesRead;
					ProgressPercentage = (int)(100 * totalBytesRead / fileSize);
					await fs.WriteAsync(buffer, 0, bytesRead);
				}
			}
			finally
			{
				System.Buffers.ArrayPool<byte>.Shared.Return(buffer);
			}
			// Stop the timer and update the UI with the final progress.
			timer.Change(Timeout.Infinite, Timeout.Infinite);
			ProgressPercentage = 100;
			// inputFileId = Guid.NewGuid();
			// var uri = $"{navigationManager.BaseUri}Uploads/ChoVietJapan/products";
			// url_anhdaidien = $"{uri}/{selectedFile.Name}";
			model.Picture = selectedFile.Name;
			files.Clear();
			this.StateHasChanged();
		}
	}

	string GetImageProductFileName(TblUser pd)
	{
		string url_anhdaidien = "/images/icons/nopicture.png";//mtlsettings.defaultimage;
		if (pd.Picture != null)
		{
			string path_saveimage = $"/uploads/{userSession.company.UploadUrl}/customer/{pd.Picture}";
			//mtlsettings.urluploadGame;
			//var path_saveimage = $"{env.WebRootPath}{userSession.company.UploadUrl}\\members";

			//var path = $"{path_saveimage}\\{pd.Picture}";
			url_anhdaidien = path_saveimage;
		}
		return url_anhdaidien;
	}


	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			IsLoading = true;
			ListNhomKhachHang = await khachHangService.GetAllNhomKhachHang();
			LoaiChamSocKhachHang = await khachHangService.GetAllLoaiChamSocKhachHangAsync();
			if (isNew)
			{
				model = new TblUser();
				model.Id = 0;
				model.Active = true;
				model.Idnhomkhachhang = Idnhomkhachhang;// Là Khách hàng
				model.Idcompany = idcompany;
				model.Idusercreate = model.Iduserlastupdate = userSession.user.UserId;
				// Gộp dữ liệu từ caller (vd: phiếu thu — SĐT đã gõ trước khi mở popup)
				if (KhachHang != null)
				{
					if (!string.IsNullOrWhiteSpace(KhachHang.Dienthoai))
						model.Dienthoai = KhachHang.Dienthoai.Trim();
					if (!string.IsNullOrWhiteSpace(KhachHang.Fullname))
						model.Fullname = KhachHang.Fullname;
					if (!string.IsNullOrWhiteSpace(KhachHang.Diachi))
						model.Diachi = KhachHang.Diachi;
					if (!string.IsNullOrWhiteSpace(KhachHang.Makh))
						model.Makh = KhachHang.Makh;
				}
				if (string.IsNullOrWhiteSpace(model.Fullname))
					model.Fullname = "";
			}
			else
			{
				//update
				model = KhachHang;
				model.Iduserlastupdate = userSession.user.UserId;
				SDT_Enable = true;
				await LoadZnsHistoryAsync();
			}
			await LayDuLieuKhachHang();
			IsLoading = false;
			StateHasChanged();
		}
		await base.OnAfterRenderAsync(firstRender);
	}

