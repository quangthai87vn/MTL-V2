	async Task LoadHoaDonTagMap()
	{
		HoaDonTagMap = await hangHoaService.GetHoaDonTagMapAsync(MaHD);
		List<MTL.APP.Models.Tag>? listTag = new List<Tag>();
		foreach (MTL.APP.Models.TblHoaDonBanHangTagMap tag in HoaDonTagMap.ToList())
		{
			MTL.APP.Models.Tag? _tag = new MTL.APP.Models.Tag();
			_tag = ListTag.Where(p => p.Id == tag.Tagid).FirstOrDefault();
			listTag.Add(_tag);
		}
		SelectedTag = listTag.AsEnumerable();
		StateHasChanged();
	}


