			|| htt == MTLEnum.HinhThucThanhToan.TienMatVaChuyenKhoan
			|| htt == MTLEnum.HinhThucThanhToan.Tragop;
	}

	bool ValidateThanhToanNguon()
	{
		var tm = hdbh.Tienmat ?? 0;
		var ck = hdbh.Tienchuyenkhoan ?? 0;
		var dk = hdbh.Tienchuyenkhoandukien ?? 0;
		var tt = hdbh.Thanhtoan ?? 0;
		var total = hdbh.Tongtiensauvat ?? 0;
		var cl = hdbh.Conlai ?? 0;
		var htt = hdbh.Idhinhthucthanhtoan ?? MTLEnum.HinhThucThanhToan.TienMat;
		if (tm < -0.01 || ck < -0.01 || dk < -0.01)
		{
			SnackbarService.Add("Số tiền không hợp lệ.", Severity.Warning);
			return false;
		}
		if (Math.Abs(tm + ck - tt) > 1.0)
		{
			SnackbarService.Add("Tiền mặt + CK đã thu phải khớp với ô Thanh toán (footer).", Severity.Warning);
			return false;
		}
		if (htt != MTLEnum.HinhThucThanhToan.Tragop && dk > 0.01)
		{
			SnackbarService.Add("CK dự kiến chỉ dùng cho trả góp.", Severity.Warning);
			return false;
		}
		if (htt == MTLEnum.HinhThucThanhToan.Tragop)
		{
			if (Math.Abs(tt + cl - total) > 1.0)
			{
				SnackbarService.Add("Trả góp: Thanh toán + Còn lại phải bằng tổng tiền.", Severity.Warning);
				return false;
			}
			if (dk > 0.01 && Math.Abs(dk - cl) > 1.0)
			{
				SnackbarService.Add("CK dự kiến nên bằng công nợ (còn lại).", Severity.Warning);
				return false;
			}
		}
		if (NeedsChonNganHang() && hdbh.Idbank == null)
		{
			SnackbarService.Add("Vui lòng chọn tài khoản nhận CK.", Severity.Warning);
			return false;
		}
		return true;
	}
}