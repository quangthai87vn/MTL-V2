    {
      "parameters": {
        "jsCode": "// Doc access_token va refresh_token tu row 2\nconst sheetData = $input.all();\n\nif (!sheetData || sheetData.length === 0) {\n  throw new Error('Khong co du lieu tu Google Sheet');\n}\n\nconst rows = sheetData.map(item => item.json);\n\nlet tokenRow = null;\nfor (let i = 0; i < rows.length; i++) {\n  const row = rows[i];\n  if (row.access_token && row.access_token.trim() !== '') {\n    tokenRow = row;\n    break;\n  }\n}\n\nif (!tokenRow) {\n  throw new Error('Khong tim thay access_token trong Sheet');\n}\n\nreturn {\n  json: {\n    access_token: tokenRow.access_token,\n    refresh_token: tokenRow.refresh_token || '',\n    expires_in: tokenRow.expires_in || 3600,\n    note: tokenRow.note || ''\n  }\n};"
      },
