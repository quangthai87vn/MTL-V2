	async Task<MTL.APP.WooRestAPI.Product> SaveWoocommerce(bool isUpdate)
	{
		MTL.APP.WooRestAPI.Product product_return = new APP.WooRestAPI.Product();
		int? wooid = mtl_product.woo_id;
		List<string> url_image = new List<string>();
		List<string> WooidCategory = new List<string>();
		double sale_price = (double)mtl_product.giaban;
		string stock_status = "";
		double regular_price = (double)mtl_product.giathuong;
		if ((bool)mtl_product.hethang) stock_status = "outofstock";
		else stock_status = "instock";
		//int idNhomhang = Convert.ToInt32(cbNhomHang.SelectedValue);
		MTL.APP.WooRestAPI.Product new_pr = new MTL.APP.WooRestAPI.Product();
		new_pr.name = mtl_product.tensp;
		new_pr.sale_price = sale_price.ToString();
		new_pr.stock_status = stock_status;
		new_pr.regular_price = regular_price.ToString();
		//new_pr.short_description = html_motangan.Document.InvokeScript("getValue").ToString();
		//new_pr.description = html_motachitiet.Document.InvokeScript("getValue").ToString();
		new_pr.slug = _HandleCommon.RemoveIllegalCharacters(mtl_product.tensp);
		new_pr.categories = this.GetWooIdCategory(_filterAPI.v_wooid_all);

		// List<API.WooRestAPI.image> List_Image = WooProduct_Return.images;
		// API.WooRestAPI.image im = new API.WooRestAPI.image();
		// im.src = image_product;
		// im.name="mytholaptop";
		// im.position = 0;
		// im.id = 678;
		// List_Image[0] = im;
		// new_pr.images = List_Image;

		// new_pr.date_modified = DateTime.Now;
		// new_pr.date_modified_gmt = DateTime.Now;
		// new_pr.date_created = _filterAPI.date_created;
		// new_pr.date_created_gmt = _filterAPI.date_created;

		if (isUpdate == true)
		{
			if (wooid != null && wooid != 0)
			{
				new_pr.id = wooid.ToString();
				product_return = await wooAPIService.UpdateProductAsync(new_pr, Wookey, Woosecret, Woourl);
				mtl_product.link = product_return.permalink;
				if (product_return.images.Count > 0)
					mtl_product.hinhanh1 = product_return.images[0].src.ToString();
			}
		}
		else
		{
			if (product_woo_id == 0)
			{
				// tạo mới , chưa có lần nào
				// new_pr.date_created = DateTime.Now;
				// new_pr.date_created_gmt = DateTime.Now;
				product_return = await wooAPIService.CreateProductAsync(new_pr, Wookey, Woosecret, Woourl);
			}
			else
			{
				// cập nhật,
				product_return = await wooAPIService.UpdateProductAsync(new_pr, Wookey, Woosecret, Woourl);
			}
			mtl_product.link = product_return.permalink;
			if (product_return.images.Count > 0)
				mtl_product.hinhanh1 = product_return.images[0].src.ToString();
		}
		return product_return;
	}

	List<MTL.APP.WooRestAPI.Category> GetWooIdCategory(string wooid_all)
	{
		List<string> WooidCategory = new List<string>();
		string[] arrayStr = wooid_all.Split(new string[] { "-" }, StringSplitOptions.RemoveEmptyEntries);
		for (int i = 0; i < arrayStr.Length; i++)
		{
			WooidCategory.Add(arrayStr[i]);
		}

		List<MTL.APP.WooRestAPI.Category> ct = new List<MTL.APP.WooRestAPI.Category> { };
		foreach (string phantu in WooidCategory)
		{
			ct.Add(new MTL.APP.WooRestAPI.Category { id = phantu });
		}

		return ct;
	}

