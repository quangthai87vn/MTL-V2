	void Grid_CustomizeCellDisplayText(GridCustomizeCellDisplayTextEventArgs e)
	{
		try
		{
			if (e.FieldName == "idnhomhang")
			{
				if (e.Value != null)
				{
					if (NhomHangParentList != null)
						e.DisplayText = NhomHangParentList.Where(p => p.id == (int)e.Value).FirstOrDefault().v_nhomhang;
				}
			}
			else if (e.FieldName == "idthuonghieu")
			{
				if (e.Value != null)
				{
					if (ThuongHieuList != null)
						e.DisplayText = ThuongHieuList.Where(p => p.id == (int)e.Value).FirstOrDefault().thuonghieu;
				}
			}
			else if (e.FieldName == "idBaoHanh")
			{
				if (e.Value != null)
				{
					if (BaoHanhList != null)
						e.DisplayText = BaoHanhList.Where(p => p.Id == (int)e.Value).FirstOrDefault().Baohanh;
				}
			}
			else if (e.FieldName == "idvitri")
			{
				if (e.Value != null)
				{
					if (ViTriList != null)
						e.DisplayText = ViTriList.Where(p => p.Id == (int)e.Value).FirstOrDefault().Vitri;
				}
			}
			else if (e.FieldName == "iddonvitinh")
			{
				if (e.Value != null)
				{
					if (DVTList != null)
						e.DisplayText = DVTList.Where(p => p.Id == (int)e.Value).FirstOrDefault().Donvitinh;
				}
			}
			else if (e.FieldName == "iduserlastupdate" || e.FieldName == "iduserlastcreate")
			{
				if (e.Value != null)
				{
					if (UserList != null)
						e.DisplayText = UserList.Where(p => p.userid == (int)e.Value).FirstOrDefault().Fullname;
