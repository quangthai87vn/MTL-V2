	async Task<IEnumerable<MTL_GetAllThuongHieuResult>> SearchThuongHieuAsync(string searchTerm, CancellationToken token)
	{
		if (string.IsNullOrEmpty(searchTerm))
		{
			return ThuongHieuList;
		}
		var products = ThuongHieuList?
			.Where(product => product.thuonghieu.Contains(searchTerm, StringComparison.InvariantCultureIgnoreCase))
