      "parameters": {
        "jsCode": "// Xu ly ket qua refresh token\nconst refreshResult = $input.first().json;\n\nif (refreshResult.error !== 0) {\n  throw new Error('Refresh token failed: ' + refreshResult.message + ' (error ' + refreshResult.error + ')');\n}\n\nreturn {\n  json: {\n    access_token: refreshResult.access_token,\n    refresh_token: refreshResult.refresh_token,\n    expires_in: refreshResult.expires_in || 3600,\n    note: 'Auto-refreshed at ' + new Date().toISOString(),\n    source: 'refreshed',\n    valid: true\n  }\n};"
