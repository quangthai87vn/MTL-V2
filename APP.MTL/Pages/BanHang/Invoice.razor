	/// <summary>Trả về (tên loại phiếu, mã HD, hình thức TT, tên NH) — đều in hoa.</summary>
	(string tenLoaiPhieu, string maHD, string httt, string tenNH) GetInvoiceMeta(MTL_GetAllInvoiceResult inv)
	{
		var idLp = inv.idLoaiPhieu ?? 0;
		var lpRow = MTLEnum.GetListLoaiPhieu().FirstOrDefault(p => p.Id == idLp);
		var tenLP = (lpRow?.Loaiphieu ?? "").ToUpperInvariant();
		var ma = (inv.mahd ?? "").ToUpperInvariant();

		var htttStr = "";
		var tenNHStr = "";
		int? httId = inv.idhinhthucthanhtoan;
		if (httId == null && !string.IsNullOrEmpty(inv.mahd) && _paymentBreakdownByMahd.TryGetValue(inv.mahd!, out var brInfer))
		{
			var tmI = brInfer.Tienmat ?? 0;
			var ckI = brInfer.Tienchuyenkhoan ?? 0;
			var dkI = brInfer.Tienchuyenkhoandukien ?? 0;
			if (dkI >= 0.01) httId = MTLEnum.HinhThucThanhToan.Tragop;
			else if (tmI >= 0.01 && ckI >= 0.01) httId = MTLEnum.HinhThucThanhToan.TienMatVaChuyenKhoan;
			else if (ckI >= 0.01) httId = MTLEnum.HinhThucThanhToan.ChuyenKhoan;
			else if (tmI >= 0.01) httId = MTLEnum.HinhThucThanhToan.TienMat;
		}
		if (httId != null)
		{
			var htttRow = MTLEnum.GetListHinhThucThanhToan().FirstOrDefault(p => p.Id == httId);
			htttStr = (htttRow?.Mota ?? "").ToUpperInvariant();
			if (inv.idbank != null && (httId == 2 || httId == 3 || httId == 4 || httId == 5))
				_bankNameById.TryGetValue(inv.idbank.Value, out tenNHStr);
		}
		return (tenLP, ma, htttStr, tenNHStr.ToUpperInvariant());
	}

	async Task RefreshPaymentBreakdownCacheAsync()
	{
		_paymentBreakdownByMahd.Clear();
		if (data == null || data.Count == 0) return;
		var map = await invoiceService.GetInvoicePaymentBreakdownsAsync(idcompany, data.Select(x => x.mahd));
		foreach (var kv in map)
			_paymentBreakdownByMahd[kv.Key] = kv.Value;
	}

	/// <summary>Tiền mặt / CK đã thu / CK dự kiến — ưu tiên cột DB; fallback giống HydratePaymentFromLegacy (ThemHoaDon).</summary>
	(double tm, double ck, double ckDuKien) ResolvePaymentAmounts(MTL_GetAllInvoiceResult inv)
	{
		var tt = inv.thanhtoan ?? 0;
		var cl = inv.conlai ?? 0;

		if (!string.IsNullOrEmpty(inv.mahd) && _paymentBreakdownByMahd.TryGetValue(inv.mahd!, out var br))
		{
			var tmB = br.Tienmat ?? 0;
			var ckB = br.Tienchuyenkhoan ?? 0;
			var dkB = br.Tienchuyenkhoandukien ?? 0;
			if (tmB >= 0.01 || ckB >= 0.01 || dkB >= 0.01)
				return (tmB, ckB, dkB);
		}

		if (tt < 0.01 && cl < 0.01)
			return (0, 0, 0);

		var htt = inv.idhinhthucthanhtoan ?? MTLEnum.HinhThucThanhToan.TienMat;
		if (htt == MTLEnum.HinhThucThanhToan.Quetthe)
			htt = MTLEnum.HinhThucThanhToan.ChuyenKhoan;

		if (htt == MTLEnum.HinhThucThanhToan.TienMat)
			return (tt, 0, 0);
		if (htt == MTLEnum.HinhThucThanhToan.ChuyenKhoan)
			return (0, tt, 0);
		if (htt == MTLEnum.HinhThucThanhToan.Tragop)
			return (tt, 0, cl >= 0.01 ? cl : 0);
		return (0, 0, 0);
	}

	string FormatPaymentOneLine(MTL_GetAllInvoiceResult inv)
	{
		var m = GetInvoiceMeta(inv);
		var nh = string.IsNullOrWhiteSpace(m.tenNH) ? "" : m.tenNH;
		var (tm, ck, dk) = ResolvePaymentAmounts(inv);
		var htt = inv.idhinhthucthanhtoan ?? 0;
		if (htt == MTLEnum.HinhThucThanhToan.Quetthe)
			htt = MTLEnum.HinhThucThanhToan.ChuyenKhoan;

		if (htt == MTLEnum.HinhThucThanhToan.TienMatVaChuyenKhoan && tm < 0.01 && ck < 0.01 && dk < 0.01)
			return string.IsNullOrEmpty(nh) ? m.httt : $"{m.httt} · {nh}";

		var parts = new List<string>();
		if (tm >= 0.01) parts.Add($"TM {FormatCurrency(tm)}");
		if (ck >= 0.01) parts.Add($"CK {FormatCurrency(ck)}");
		if (dk >= 0.01)
			parts.Add(htt == MTLEnum.HinhThucThanhToan.Tragop
				? $"Còn lại trả góp (theo TK) {FormatCurrency(dk)}"
				: $"CK dự kiến {FormatCurrency(dk)}");
		if ((ck >= 0.01 || dk >= 0.01) && !string.IsNullOrEmpty(nh))
			parts.Add(nh);
		if (parts.Count > 0)
			return string.Join(" · ", parts);
		return string.IsNullOrWhiteSpace(m.httt) ? "—" : m.httt;
	}

	IReadOnlyList<(string Text, Color Color, string Icon)> GetPaymentDetailChips(MTL_GetAllInvoiceResult inv)
	{
		var list = new List<(string Text, Color Color, string Icon)>();
		var m = GetInvoiceMeta(inv);
		if (string.IsNullOrWhiteSpace(m.httt))
			list.Add(("Hình thức: —", Color.Default, Icons.Material.Filled.HelpOutline));
		else
			list.Add(($"Hình thức: {m.httt}", Color.Primary, Icons.Material.Filled.Payments));

		var (tm, ck, dk) = ResolvePaymentAmounts(inv);
		if (tm >= 0.01)
			list.Add(($"Tiền mặt: {FormatCurrency(tm)}", Color.Primary, Icons.Material.Filled.Payments));
		if (ck >= 0.01)
			list.Add(($"CK đã thu: {FormatCurrency(ck)}", Color.Success, Icons.Material.Filled.AccountBalance));
		if (dk >= 0.01)
		{
			var httChip = inv.idhinhthucthanhtoan ?? 0;
			var tragopChip = httChip == MTLEnum.HinhThucThanhToan.Tragop;
			list.Add((tragopChip
					? $"Còn lại trả góp (CK theo TK): {FormatCurrency(dk)}"
					: $"CK dự kiến: {FormatCurrency(dk)}",
				Color.Warning, Icons.Material.Filled.Schedule));
		}

		if (!string.IsNullOrWhiteSpace(m.tenNH))
			list.Add(($"TK: {m.tenNH}", Color.Info, Icons.Material.Filled.AccountBalanceWallet));

		var htt = inv.idhinhthucthanhtoan ?? 0;
		if (htt == MTLEnum.HinhThucThanhToan.TienMatVaChuyenKhoan && tm < 0.01 && ck < 0.01 && dk < 0.01)
			list.Add(("Chưa có tách TM/CK trên DB — mở sửa HĐ để cập nhật", Color.Default, Icons.Material.Filled.Info));

		return list;
	}

