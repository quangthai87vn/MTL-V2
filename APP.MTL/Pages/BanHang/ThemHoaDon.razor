		{
			Mahd = hdbh.Mahd,
			Chietkhau = 0,
			Ghichu = "",
			Idbaohanh = _filter.v_baohanh,
			Sl = _filter.v_sl,
			Dongia = _filter.v_dongia,
			Thanhtien = _filter.v_sl * _filter.v_dongia,
			Issanphamao = _filter.v_SPAo,
			Tensp = _filter.v_tenspEdit,
			Idsanpham = _filter.v_tensp,
			Lastupdate = DateTime.Now,
			Beginupdate = DateTime.Now,
		};

		if (ThemXoaSP == 2) // THÊM: 0 - SỬA 1 - XÓA 2
			hdbhct.Id = id_sp;
		else if (ThemXoaSP == 0)
		{
			// thêm
		}
		else if (ThemXoaSP == 1)
		{
			//sửa
		}
		HoaDonBanHangResult hdbh_rs = new HoaDonBanHangResult
			{
				HoaDonBanHang = hdbh,
				HoaDonBanHangChiTiet = hdbhct,
				
			};
		return hdbh_rs;
	}

