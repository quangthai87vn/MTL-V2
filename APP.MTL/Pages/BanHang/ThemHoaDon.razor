	private async Task ProcessQRCode(string qrCodeValue)
	{
		if (!string.IsNullOrWhiteSpace(qrCodeValue))
		{
			bool isNumber = Regex.IsMatch(qrCodeValue, @"^\d+$");
			if (isNumber)
			{
				int id = int.Parse(qrCodeValue);
				product_mtl = ListProduct.Where(p => p.id == id).FirstOrDefault();
				if (product_mtl != null) // có hàng hóa theo QRCODE
				{
					await HangHoaValueChanged(product_mtl);
					if (_mudButtonThemHangHoa != null)
					{
						await _mudButtonThemHangHoaCallback.InvokeAsync(null);

					}
				}
			}
			// Đảm bảo giao diện người dùng được cập nhật lại
			await InvokeAsync(StateHasChanged);
		}
	}

	async Task ScanResultQRCodeHangHoa(string e)
