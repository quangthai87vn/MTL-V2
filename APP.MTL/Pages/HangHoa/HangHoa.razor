			_sanpham.Iduserlastcreate = _sanpham.Iduserlastupdate = userSession.user.UserId;
			_sanpham.Beginupdate = _sanpham.Lastupdate = DateTime.Now;
		}
		return _sanpham;
	}

	async Task OnEditModelSaving(GridEditModelSavingEventArgs e)
	{
		try
		{
			IsLoadingSave = true;
			await Task.Delay(5);
			var mtl_edit_sanpham = (MTL_GetAllProductsResult)e.EditModel;
			TblSanpham edit_sanpham;//= this.convertMTL(mtl_edit_sanpham);
			MTL.APP.WooRestAPI.Product reurn_product = new APP.WooRestAPI.Product();
			bool isUpdate = false;
			if (e.IsNew)
			{
				isUpdate = false;
				edit_sanpham = this.convertMTL(mtl_edit_sanpham, e.IsNew);
				if (userSession.company.IsActiveApi)
				{
					if (mtl_product.woo_id != null && mtl_product.woo_id != 0) // chọn WooID có sẳn, ko tạo WooID mới
					{
						edit_sanpham.WooId = mtl_product.woo_id;
						edit_sanpham.Link = mtl_product.link;
					}
					else
					{
						reurn_product = await SaveWoocommerce(isUpdate);
						edit_sanpham.WooId = int.Parse(reurn_product.id);
						edit_sanpham.Link = reurn_product.permalink;
					}
				}
				edit_sanpham = await hangHoaService.CreateProductAsync(edit_sanpham);//.SaveAsync("Product/CreateProduct", edit_sanpham);
				bool result = await hangHoaService.SaveHangHoaThanhPhanAsync(ListHangHoaThanhPhan, edit_sanpham.Id);
				this.ShowToastMessagebox(1, "Hàng hóa", edit_sanpham.Tensp);
			}
			else
			{
				isUpdate = true;
				edit_sanpham = this.convertMTL(mtl_edit_sanpham, e.IsNew);
				if (userSession.company.IsActiveApi)
				{
					reurn_product = await SaveWoocommerce(isUpdate);
					if (reurn_product.id != null)
					{
						edit_sanpham.WooId = int.Parse(reurn_product.id);
						edit_sanpham.Link = reurn_product.permalink;
						if (reurn_product.images.Count > 0)
							edit_sanpham.Hinhanh1 = reurn_product.images[0].src.ToString();
					}
				}
				int id = edit_sanpham.Id;
				edit_sanpham = await hangHoaService.UpdateProductAsync(edit_sanpham);
				bool result = await hangHoaService.SaveHangHoaThanhPhanAsync(ListHangHoaThanhPhan, edit_sanpham.Id);
				this.ShowToastMessagebox(3, "Hàng hóa", edit_sanpham.Tensp);
			}
			await FilterDataList();
			IsLoadingSave = false;
		}
		catch (Exception)
		{
			IsLoadingSave = false;
		}
	}

