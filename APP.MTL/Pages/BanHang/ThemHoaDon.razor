@page "/Invoice/Add/{IdLoaiPhieu:int}"
@page "/ThemHoaDon/{MaHD}"
@using System.Collections;
@using System.Globalization
@using Blazored.LocalStorage;
@using Blazored.Toast
@using Blazored.Toast.Services
@using MTL.APP.Models;
@using MTL.APP.Pages.KhachHang
@using MTL.APP.Services
@using MTL.APP.Utils
@using MudBlazor
@using MudBlazor.Extensions.Options
@using System.Text.RegularExpressions;
@inject IJSRuntime JSRuntime
@inject InvoiceService invoiceService
@inject UserService userService
@inject KhachHangService khachHangService
@inject HangHoaService hangHoaService
@inject Configs configs
@inject ISnackbar SnackbarService
@inject MudBlazor.IDialogService DialogService
@attribute [Authorize]
<MudDialog Class="blur dialog-background"
		   TitleClass="blur dialog-background-title"
		   ContentClass="dialog-background-surface pa-4"
		   ActionsClass="dialog-background-surface mtl-themdon-dialog-actions">
	<DialogContent>
		@if (IsLoading)
		{
			<Loading IsFullPage="false" HideText="true" />
		}
		else
		{
		<MudGrid Spacing=1>

					<MudItem xs="12" sm="12" md="8">
						<MudPaper Class="pa-4" Elevation="4">
							<MudExGradientText Animate="false" Typo="Typo.h6" style="font-weight: bold; text-align:left">1. CHI TIẾT @TenLoaiPhieu.ToUpper()</MudExGradientText>
							<MudGrid Spacing=1>
								<MudItem xs="12" sm="12" md="6">
									<MudSelect Label="Loại Hàng" T="int"
											   Value="_filter.v_loaihh" ReadOnly=!spAo_enable
											   ValueChanged="LoaiHHDVValueChanged"
											   AnchorOrigin="Origin.BottomCenter" Required="true">
										@foreach (var item in LoaiHHDVList)
										{
											<MudSelectItem T="int" Value="@item.Id">@item.Loaihanghoadichvu</MudSelectItem>
										}
									</MudSelect>
								</MudItem>

								<MudItem xs="12" sm="12" md="3">
									@if (userSession.company.IsActiveSpao != null)
									{
										if ((bool)userSession.company.IsActiveSpao)
										{
											<MudSwitch Value=@_filter.v_SPAo
											Label="Sản phẩm ảo"
											ValueChanged="isSPAo_CheckedChanged"
											T="bool" Color="Color.Primary" />
										}
									}
								</MudItem>
								<MudItem xs="12" sm="12" md="3">
									<MudButton Variant="Variant.Filled" FullWidth=true StartIcon="@Icons.Material.Filled.Add" Disabled=IsLoading
									OnClick="ThemDichVuNhanhDialog" Color="Color.Primary">THÊM NHANH</MudButton>
								</MudItem>
								<MudItem xs="12" sm="12" md="12">
									@if (spAo_enable)
									{
										<MudAutocomplete T="MTL_GetAllProductsResult" Label="Chọn hàng hóa cần bán "
										Disabled=!spAo_enable Clearable="true"
										SearchFunc="@SearchHangHoaAsync"
										MaxItems="100"
										Value=@product_mtl @ref="_HangHoaAutoComplete"
										ResetValueOnEmptyText=true
										ValueChanged="HangHoaValueChanged"
										ToStringFunc="@(e=> e==null?null : $"{e.tensp} ({e.giaban})")">
											<ItemTemplate Context="pd">
												<div class="combobox-item-template">
													@* 	<MudIconButton Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled"
												Color="Color.Primary" Size="Size.Medium" /> *@
													<img src=@GetImageFileName(pd) width="120px" height="120px" />
													<div class="combobox-item-template-text">
														<span class="combobox-item-tensp">@pd.tensp </span>
														<span>Nhóm hàng: @pd.nhomhang</span>
														<span>Bảo hành: @pd.baohanh</span>
														<span class="combobox-item-price">Giá bán: @String.Format("{0:n0}", @pd.giaban) </span>
														<span class="combobox-item-price" style=" text-decoration: line-through;">Giá thường: @String.Format("{0:n0}", @pd.giathuong) </span>
													</div>
												</div>
											</ItemTemplate>
										</MudAutocomplete>
									}
									else
									{
										<MudTextField T="string" Label="Nhập sản phẩm ảo cần bán" Disabled=spAo_enable
										@bind-Text=_filter.v_tenspEdit />
									}
								</MudItem>
								<MudItem xs="6" sm="6" md="3">
									<MudNumericField HideSpinButtons="true"
									Label="Số lượng" @bind-Value="_filter.v_sl"
									style="color:red; font-weight: bold;"
									Format="N0" />
								</MudItem>
								<MudItem xs="6" sm="6" md="3">
									<MudNumericField HideSpinButtons="true"
									Label="Đơn giá" @bind-Value="_filter.v_dongia"
									style="color:red; font-weight: bold;"
									Format="N0" />
								</MudItem>
								<MudItem xs="6" sm="6" md="3">
									<MudSelect Label="Bảo hành" T="int"
									style="color:red; font-weight: bold;"
									@bind-SelectedValues=id_baohanh
									@bind-Value=_filter.v_baohanh
									AnchorOrigin="Origin.BottomCenter" Required="true">
										@foreach (var item in BaoHanhList)
										{
											<MudSelectItem T="int" Value="@item.Id">@item.Baohanh</MudSelectItem>
										}
									</MudSelect>
								</MudItem>
								<MudItem xs="6" sm="6" md="3">
									<MudButton @ref="_mudButtonThemHangHoa" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" FullWidth="true"
									OnClick="ThemHangClick" Color="Color.Primary">THÊM</MudButton>
								</MudItem>
								<MudItem xs="12" sm="12" md="12">
									<MudTable Items="@ListHoaDonChiTiet"
									Hover="true"
									Striped="true"
									Bordered="false"
									RowsPerPage="50"
									Class="mudtable-center-header">
										<HeaderContent>
											<MudTh Style="width:40px; text-align:center;">T.TÁC</MudTh>
											<MudTh Style="width:40px; text-align:center;">ẢNH</MudTh>
											<MudTh>SẢN PHẨM</MudTh>
											<MudTh Style="width:50px; text-align:right;">SL</MudTh>
											<MudTh Style="width:80px; text-align:right;">Đ.GIÁ</MudTh>
											<MudTh Style="width:80px; text-align:right;">T.TIỀN</MudTh>
											<MudTh Style="width:90px; text-align:center;">B.HÀNH</MudTh>
										</HeaderContent>
										<RowTemplate Context="HoaDonChiTiet">
											<MudTd DataLabel="T.TÁC">
												<MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" OverrideStyles=false>
													<MudIconButton @onclick="@(() => SuaHangHoaDialog(HoaDonChiTiet))"
													Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled"
													Color="Color.Primary" Size="Size.Medium" />
													<MudIconButton @onclick="@(() => XoaHangHoaDialog(HoaDonChiTiet))"
													Icon="@Icons.Material.Filled.Delete" Variant="Variant.Filled"
													Color="Color.Error" Size="Size.Medium" />
												</MudButtonGroup>
											</MudTd>
											<MudTd DataLabel="ẢNH">
												@{
													string url_anhdaidien = userSession.company.Logourl;
													if (((MTL_GetHoaDonChiTietResult)HoaDonChiTiet).anhsanpham != null)
													{
														url_anhdaidien = ((MTL_GetHoaDonChiTietResult)HoaDonChiTiet).anhsanpham;
													}
													<img src=@url_anhdaidien alt="" width="30px" height="30px">
												}
											</MudTd>
											<MudTd DataLabel="SẢN PHẨM">
												@{
													var webUrl = ((MTL_GetHoaDonChiTietResult)HoaDonChiTiet).linksanpham;
													var tensp = ((MTL_GetHoaDonChiTietResult)HoaDonChiTiet).tensp;
													if (webUrl != null)
													{
														if (webUrl != "")
														{
															<a target="_blank" href=@webUrl>@tensp</a>
														}
														else
														{
															<a target="_blank">@tensp</a>
														}
													}
													else
													{
														<a target="_blank">@tensp</a>
													}

												}
											</MudTd>
											<MudTd DataLabel="SL">
												<p style="color:black ;text-align:right;">@HoaDonChiTiet.sl</p>
											</MudTd>
											<MudTd DataLabel="Đ.GIÁ">
												<p style="color:var(--mud-palette-primary) ;text-align:right;">@FormatCurrency(HoaDonChiTiet.dongia)</p>
											</MudTd>
											<MudTd DataLabel="T.TIỀN">
												<p style="font-weight: bold; color:red ;text-align:right;">@FormatCurrency(HoaDonChiTiet.thanhtien)</p>
											</MudTd>
											<MudTd DataLabel="B.HÀNH">
												<p style="color:black ;text-align:right;">
													@if (HoaDonChiTiet.idbaohanh != null)
													{
														if (HoaDonChiTiet.idbaohanh != 0)
															@BaoHanhList.Where(p => p.Id == HoaDonChiTiet.idbaohanh).FirstOrDefault().Baohanh
													}
												</p>
											</MudTd>
										</RowTemplate>
										<!-- FooterContent để hiển thị tổng -->
										<FooterContent>
											<MudTd ColSpan="2" Style="text-align:right; font-weight:bold;">Chủng loại SP: @ListHoaDonChiTiet.Count</MudTd>
											<MudTd ColSpan="2" Style="text-align:right; font-weight:bold;">Số lượng: @ListHoaDonChiTiet.Sum(x => x.sl)</MudTd>
											<MudTd ColSpan="2" Style="text-align:right; font-weight:bold;">Tổng cộng:</MudTd>
											<MudTd Style="text-align:center; font-weight:bold; color:red;">
												@FormatCurrency(ListHoaDonChiTiet.Sum(x => x.thanhtien))
											</MudTd>
										</FooterContent>
										<PagerContent>
											<MudTablePager PageSizeOptions="new int[] { 50, 100 }" />
										</PagerContent>
									</MudTable>
								</MudItem>
							</MudGrid>
						</MudPaper>
					</MudItem>

					<MudItem xs="12" sm="12" md="4">
						<MudPaper Class="pa-4" Elevation="4">
							<MudExGradientText Animate="false" Typo="Typo.h6" style="font-weight: bold; text-align:left">2. THÔNG TIN @TenLoaiPhieu.ToUpper()</MudExGradientText>
							<MudGrid Spacing=1>
								<MudItem xs="6" sm="6" md="3">
									<MudSelect Required="true"
									Value="@hdbh.IdLoaiPhieu"
									T=int?
									ValueChanged="LoaiPhieuValueChanged"
									Label="Loại phiếu"
									AnchorOrigin="Origin.BottomCenter">
										@foreach (var loai in MTLEnum.GetListLoaiPhieu().Where(p => p.Id != 1))
										{
											<MudSelectItem T=int? Value="@loai.Id">@loai.Loaiphieu</MudSelectItem>
										}
									</MudSelect>
								</MudItem>
								<MudItem xs="6" sm="6" md="3">
									<MudTextField T="string" Label="Mã phiếu" Required="true"
									HelperTextOnFocus="true"
									@bind-Text=hdbh.Mahd ReadOnly="true" />
								</MudItem>
								<MudItem xs="6" sm="6" md="3">
									<MudSelect @bind-Value="@hdbh.Idnguoixuat" Label="Người xuất" ReadOnly=true
									AnchorOrigin="Origin.BottomCenter" Required="true">
										@foreach (var user in UserList)
										{
											<MudSelectItem T=int? Value="@user.userid">@user.Fullname</MudSelectItem>
										}
									</MudSelect>
								</MudItem>

								<MudItem xs="6" sm="6" md="3">
									<MudSwitch @bind-Value="hdbh.IsDichVuDaXuLy"
											   Label="Đã xữ lý"
											   T="bool?"
											   Color="Color.Primary" />
								</MudItem>




								<MudItem xs="6" sm="6" md="6">
									<MudDatePicker Label="Ngày xuất"
									Mask="@(new DateMask("dd/MM/yyyy"))" DateFormat="dd/MM/yyyy"
									@bind-Date=hdbh.Ngaylapphieu />
								</MudItem>
								<MudItem xs="6" sm="6" md="6">
									<MudDatePicker Label="Ngày trả (HĐ)"
									Mask="@(new DateMask("dd/MM/yyyy"))" DateFormat="dd/MM/yyyy"
									@bind-Date=hdbh.Ngaytraphieu />
								</MudItem>
								<MudItem xs="12" sm="12" md="12">
									<MudText Typo="Typo.caption" Class="mud-text-secondary">Hình thức &amp; nguồn tiền</MudText>
									<MudRadioGroup T="int"
												   Value="@(hdbh.Idhinhthucthanhtoan ?? MTLEnum.HinhThucThanhToan.TienMat)"
												   ValueChanged="@OnPaymentModeValueChanged"
												   Color="Color.Primary">
										<MudRadio Value="@MTLEnum.HinhThucThanhToan.TienMat">Tiền mặt</MudRadio>
										<MudRadio Value="@MTLEnum.HinhThucThanhToan.ChuyenKhoan">Chuyển khoản</MudRadio>
										<MudRadio Value="@MTLEnum.HinhThucThanhToan.TienMatVaChuyenKhoan">Tiền mặt + chuyển khoản</MudRadio>
										<MudRadio Value="@MTLEnum.HinhThucThanhToan.Tragop">Trả góp</MudRadio>
									</MudRadioGroup>
								</MudItem>

								@if ((hdbh.Idhinhthucthanhtoan ?? 0) == MTLEnum.HinhThucThanhToan.TienMatVaChuyenKhoan
									 || (hdbh.Idhinhthucthanhtoan ?? 0) == MTLEnum.HinhThucThanhToan.Tragop)
								{
									var _tragopUi = (hdbh.Idhinhthucthanhtoan ?? 0) == MTLEnum.HinhThucThanhToan.Tragop;
									<MudItem xs="6" sm="6" md="6">
										<MudNumericField HideSpinButtons="true"
														 Label="@(_tragopUi ? "Còn lại trả góp (theo TK)" : "Số tiền chuyển khoản")"
														 HelperText="@(_tragopUi ? "Số còn lại gắn TK đã chọn; báo cáo nguồn tiền phân bổ theo ngân hàng đó." : "Nhập số tiền CK; tiền mặt = tổng − CK")"
														 Value="@CkSoNhapHienThi"
														 ValueChanged="@((double? v) => OnCkSoNhapValueChanged(v))"
														 Format="N0" Culture="@CultureInfo.GetCultureInfo("vi-VN")"
														 Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.AccountBalance"
														 Class="curency" FullWidth="true" />
									</MudItem>
									<MudItem xs="6" sm="6" md="6">
										<MudNumericField HideSpinButtons="true"
														 Label="Tiền mặt"
														 HelperText="Tự tính"
														 Value="hdbh.Tienmat"
														 ReadOnly="true"
														 Format="N0" Culture="@CultureInfo.GetCultureInfo("vi-VN")"
														 Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Payments"
														 Class="curency" FullWidth="true" />
									</MudItem>
								}

								@if (NeedsChonNganHang())
								{
									var _tragopBankLbl = (hdbh.Idhinhthucthanhtoan ?? 0) == MTLEnum.HinhThucThanhToan.Tragop;
									<MudItem xs="12" sm="12" md="12">
										<MudSelect @bind-Value="@hdbh.Idbank" Label="@(_tragopBankLbl ? "TK nhận phần trả góp (CK)" : "Tài khoản nhận CK")"
												   AnchorOrigin="Origin.BottomCenter" Required="true">
											@if (BankList != null)
											{
												@foreach (var bank in BankList)
												{
													<MudSelectItem T="int?" Value="@bank.Id">@bank.BankingName — @bank.AccountName</MudSelectItem>
												}
											}
										</MudSelect>
									</MudItem>
								}



								<MudItem xs="12" sm="12" md="6">
									<MudTextField T="string" Label="Model máy tính nhận (tuỳ chọn)"
									HelperTextOnFocus="true"
									@bind-Text=hdbh.Model />
								</MudItem>

								<MudItem xs="12" sm="12" md="6">
									<MudExChipSelect Label="Định danh hóa đơn theo thẻ"
									ChipSize=Size.Medium
									SearchBoxAutoFocus=true
									Adornment=Adornment.Start
									AdornmentIcon="@Icons.Material.Filled.FilterList"
									ItemCollection="@ListTag"
									MultiSelection="true"
									ValuePresenter="ValuePresenter.Chip"
									@bind-SelectedValues="SelectedTag"
									ToStringFunc="@(e=> e==null?null : $"{e.Name}")">
									</MudExChipSelect>
								</MudItem>
								<MudItem xs="12" sm="12" md="12">
									<MudAutocomplete T="TblUser" Label="Chọn khách hàng cần tìm "
									Clearable="true"
									SearchFunc=@SearchKhachHangAsync
									MaxItems="100"
									Value=@khachhangsearch
									@ref="_KhachHangAutoComplete"
									ResetValueOnEmptyText=true
									ValueChanged="KhachHangValueChanged"
									ToStringFunc="@(e=> e==null?null : $"{e.Fullname} ({e.Dienthoai})")">
									</MudAutocomplete>
								</MudItem>
								<MudItem xs="6" sm="6" md="4">
									<MudButton Variant="Variant.Filled" FullWidth="true" Disabled=IsLoading StartIcon="@Icons.Material.Filled.AddBusiness"
									OnClick=@ThemKhachHangDialog Color="Color.Primary">THÊM K.HÀNG</MudButton>
								</MudItem>
								<MudItem xs="6" sm="6" md="4">
									<MudButton Variant="Variant.Filled" FullWidth="true" Disabled=IsLoading StartIcon="@Icons.Material.Filled.Edit"
									OnClick=@SuaKhachHangDialog Color="Color.Error">SỬA K.HÀNG</MudButton>
								</MudItem>
								<MudItem xs="6" sm="6" md="4">
									<MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.History" FullWidth="true" Disabled=IsLoading
									OnClick=@ThemNhatKyKhachHangDialog Color="Color.Success">THÊM NHẬT KÝ</MudButton>
								</MudItem>

								<MudItem xs="12" sm="12" md="12">
									<MudTextField T="string" Label="Ghi chú phiếu không hiện bill"
									HelperTextOnFocus="true"
									@bind-Text=hdbh.Ghichukohienbill
									Lines="2" Margin="Margin.Dense" Variant="Variant.Outlined" />
								</MudItem>
								<MudItem xs="12" sm="12" md="12">
									<MudTextField T="string" Label="Ghi chú phiếu trên bill"
									HelperTextOnFocus="true"
									@bind-Text=hdbh.Ghichu
									Lines="2" Margin="Margin.Dense" Variant="Variant.Outlined" />
								</MudItem>
							</MudGrid>
							<MudExGradientText Animate="false" Typo="Typo.h6" style="font-weight: bold; text-align:left">NHẬT KÝ KHÁCH HÀNG</MudExGradientText>
							<MudGrid Spacing=1>
								<MudItem xs="12" sm="12" md="12">
									@if (ListGhiChuKhachHang != null)
									{
										<MudTable Items="@ListGhiChuKhachHang"
										Hover="true"
										Striped="true"
										Bordered="false"
										RowsPerPage="50"
										Class="mudtable-center-header">
											<RowTemplate Context="contextGhiChu">
												<MudTd DataLabel="Ngày">
													<MudGrid Spacing=1>
														<MudItem xs="12" sm="12" md="12">
															<MudStack Row="true">
																<MudItem xs="8" sm="8" md="11">
																	<p Style="color: red; font-weight:bold; ">@Convert.ToDateTime(contextGhiChu.Ngayghichu).ToString("dd/MM/yyyy")</p>																	
																</MudItem>
																<MudItem xs="4" sm="4" md="1">
																	<MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" OverrideStyles=false>
																		<MudIconButton @onclick="@(() => XoaGhiChuDialog(contextGhiChu))"
																		Icon="@Icons.Material.Filled.Delete"
																		Variant="Variant.Filled"
																		Color="Color.Error" Size="Size.Medium" />
																	</MudButtonGroup>
																</MudItem>
															</MudStack>
														</MudItem>
														<MudItem xs="12" sm="12" md="12">
															<p>@contextGhiChu.Noidung</p>													
														</MudItem>			
													</MudGrid>
												</MudTd>											
											</RowTemplate>
										</MudTable>
									}
								</MudItem>
							</MudGrid>
							<MudExGradientText Animate="false" Typo="Typo.h6" style="font-weight: bold; text-align:left">CÓ @HoaDonKhachHang.Count HOÁ ĐƠN ĐÃ THANH TOÁN: TRỊ GIÁ @FormatCurrency(HoaDonKhachHang.Sum(x => x.thanhtoan)) VNĐ</MudExGradientText>

							<MudGrid Spacing=1>
								<MudItem xs="12" sm="12" md="12">
									@if (HoaDonKhachHang != null)
									{
										<MudTable Items="@HoaDonKhachHang"
										Hover="true"
										Striped="true"
										Bordered="false"
										RowsPerPage="50"
										Class="mudtable-center-header">

											<RowTemplate Context="contextInvoice">
												@{
													string rowStyle = "";
													if (!(bool)contextInvoice.isDichVuDaXuLy) // chưa xữ lý
													{
														rowStyle = "background-color:rgb(248, 187, 187);";
													}
													else if (contextInvoice.idLoaiPhieu == 4) // báo giá
													{
														rowStyle = "background-color:rgb(181, 237, 234);";
													}
													string tenloaiphieu = @MTLEnum.GetListLoaiPhieu().Where(p => p.Id == (int)@contextInvoice.idLoaiPhieu).FirstOrDefault().Loaiphieu.ToUpper();
													string MaHD = @contextInvoice.mahd.ToUpper();
												}
												<MudTd DataLabel="THÔNG TIN ĐƠN HÀNG" Style="@rowStyle">
													<MudGrid Spacing=1>
														<MudItem xs="12" sm="12" md="12">
															@{
																string LinkURLA4 = string.Format("/HoaDon/A4/{0}", contextInvoice.mahd);
															}

															<MudStack Row="true">
																<MudItem xs="6" sm="6" md="8">
