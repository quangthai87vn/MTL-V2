	async Task ShowEditForm(GridCommandColumnCellDisplayTemplateContext context)
	{
		try
		{
			MyGrid.BeginUpdate();
			IsLoadingAPI = true;
			MyGrid.PopupEditFormHeaderText = string.Format("CHỈNH SỬA: {0}", (context.DataItem as MTL_GetAllProductsResult).tensp.ToUpper());
			string woo_id = (context.DataItem as MTL_GetAllProductsResult).woo_id.ToString();
			MyGrid.StartEditRowAsync(context.VisibleIndex);
			string woo_id_nhomhang = ((MTL_GetAllProductsResult)context.DataItem).woo_id_nhomhang;
			if (woo_id_nhomhang != null)
				_filterAPI.v_wooid_all = ((MTL_GetAllProductsResult)context.DataItem).woo_id_nhomhang.Trim();
			int idsanpham = ((MTL_GetAllProductsResult)context.DataItem).id;
			if (mtl_product.idloaihanghoadichvu == 3)
			{
				await LoadLoaiHangHoaThanhPhanAsync();
			}
			ListHangHoaThanhPhan = await hangHoaService.GetHangHoaThanhPhanAsync(idsanpham, idcompany);
			await this.LoadWooProduct(woo_id);
			IsLoadingAPI = false;
			MyGrid.EndUpdate();
		}
		catch (Exception)
