@page "/zalo-messenger"
@using MTL.APP.Models
@using MTL.APP.Services

<PageStandardHeader Icon="@Icons.Material.Filled.Chat" Title="Tin nhan / Zalo OA Messenger">
 <Actions>
 <MudChip T="string" Size="Size.Small"
 Color="@(ZaloService.ZaloOaStatus == "Connected" ? Color.Success : Color.Warning)"
 Icon="@(ZaloService.ZaloOaStatus == "Connected" ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)"
 Variant="Variant.Outlined">
 @ZaloService.ZaloOaStatus
 </MudChip>
 <MudBadge Content="TotalUnreadCount" Color="Color.Error" Overlap="true" Bordered="true">
 <MudButton Variant="Variant.Outlined" Size="Size.Small"
 StartIcon="@Icons.Material.Filled.Notifications"
 OnClick="RequestNotificationPermission"
 Color="@(IsNotificationEnabled ? Color.Success : Color.Default)"
 Disabled="!IsNotificationSupported">
 THONG BAO
 </MudButton>
 </MudBadge>
 <MudButton Variant="Variant.Filled" Size="Size.Small"
 StartIcon="@Icons.Material.Filled.Refresh"
 OnClick="RefreshMessages"
 Color="Color.Primary">
 LAM MOI
 </MudButton>
 </Actions>
</PageStandardHeader>

<div class="mtl-page-body">
 @if (IsLoading)
 {
 <Loading IsFullPage="true" PageName="Zalo Messenger" />
 }
 else
 {
@if (!string.IsNullOrEmpty(ErrorMessage))
{
 <MudPaper Elevation="3" Class="pa-4 mb-3 rounded-lg" Style="border-left:5px solid var(--mud-palette-error);">
 <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
 <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" />
 <div style="flex:1;">
 <MudText Color="Color.Error" Typo="Typo.body1" Style="font-weight:500;">@ErrorMessage</MudText>
 @if (!string.IsNullOrEmpty(DebugAccessToken))
 {
 <MudText Color="Color.Default" Typo="Typo.caption" Class="mt-2">
 Access Token: <code style="font-size:0.7rem; word-break:break-all;">@DebugAccessToken</code>
 </MudText>
 }
 </div>
 <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default"
 OnClick="@(() => { ErrorMessage = null; })">
 Dong
 </MudButton>
 </MudStack>
 </MudPaper>
}

<!-- N8N Token Status Panel -->
@if (N8NTokenResult != null)
{
    <MudPaper Elevation="2" Class="pa-3 mb-3 rounded-lg" Style="@("border-left:5px solid " + N8NTokenBorderColor)">
        <MudStack Spacing="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@(N8NTokenResult.Success ? Icons.Material.Filled.Token : Icons.Material.Filled.Error)" Color="@(N8NTokenResult.Success ? Color.Success : Color.Error)" />
                    <MudText Typo="Typo.subtitle2" Style="font-weight:600;">
                        N8N Token: @(N8NTokenResult.Success ? "Thanh cong" : "That bai")
                    </MudText>
                </MudStack>
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    @if (!N8NTokenResult.Success && !string.IsNullOrEmpty(N8NTokenResult.Error))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">
                            @N8NTokenResult.Error
                        </MudChip>
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                        Size="Size.Small" Color="Color.Primary"
                        Title="Lay lai token tu N8N"
                        OnClick="FetchN8NToken"
                        Disabled="IsFetchingToken" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                        Size="Size.Small" Color="Color.Default"
                        Title="Dong"
                        OnClick="@(() => N8NTokenResult = null)" />
                </MudStack>
            </MudStack>

            @if (N8NTokenResult.Success && !string.IsNullOrEmpty(N8NTokenResult.AccessToken))
            {
                <MudDivider />
                <MudSimpleTable Dense="true" Striped="true" Bordered="false" Style="font-size:0.8rem;">
                    <thead>
                        <tr>
                            <th style="width:140px;">Thuoc tinh</th>
                            <th>Gia tri</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><MudText Typo="Typo.caption" Style="font-weight:600;">Access Token</MudText></td>
                            <td>
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <code style="font-size:0.7rem; word-break:break-all; flex:1;">@N8NTokenResult.AccessToken</code>
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                        Size="Size.Small" Color="Color.Default"
                                        Title="Copy"
                                        OnClick="@(() => CopyToClipboard(N8NTokenResult.AccessToken ?? ""))" />
                                </MudStack>
                            </td>
                        </tr>
                        @if (!string.IsNullOrEmpty(N8NTokenResult.RefreshToken))
                        {
                            <tr>
                                <td><MudText Typo="Typo.caption" Style="font-weight:600;">Refresh Token</MudText></td>
                                <td>
                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                        <code style="font-size:0.7rem; word-break:break-all; flex:1;">@N8NTokenResult.RefreshToken</code>
                                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                            Size="Size.Small" Color="Color.Default"
                                            Title="Copy"
                                            OnClick="@(() => CopyToClipboard(N8NTokenResult.RefreshToken ?? ""))" />
                                    </MudStack>
                                </td>
                            </tr>
                        }
                        <tr>
                            <td><MudText Typo="Typo.caption" Style="font-weight:600;">Expires In</MudText></td>
                            <td><MudText Typo="Typo.caption">@N8NTokenResult.ExpiresIn?.ToString() giay</MudText></td>
                        </tr>
                        <tr>
                            <td><MudText Typo="Typo.caption" Style="font-weight:600;">N8N Raw Response</MudText></td>
                            <td>
                                @if (N8NTokenResult.ExpandRawResponse)
                                {
                                    <code style="font-size:0.65rem; word-break:break-all; display:block; max-height:200px; overflow:auto;">
                                        @N8NTokenResult.RawResponse
                                    </code>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @N8NTokenResult.RawResponse?.Substring(0, Math.Min(100, N8NTokenResult.RawResponse?.Length ?? 0))...
                                    </MudText>
                                }
                                <MudLink Typo="Typo.caption" Underline="Underline.None"
                                    OnClick="@(() => N8NTokenResult = N8NTokenResult with { ExpandRawResponse = !N8NTokenResult.ExpandRawResponse })">
                                    @(N8NTokenResult.ExpandRawResponse ? "Thu gon" : "Xem them")
                                </MudLink>
                            </td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            }
        </MudStack>
    </MudPaper>
}

 <div class="zalo-messenger-layout">
 <!-- Left Panel: Conversation List -->
 <div class="zalo-conversation-list">
 <div class="zalo-conversation-header">
 <MudTextField @bind-Value="SearchText"
 Placeholder="Tim kiem cuoc tro chuyen..."
 Adornment="Adornment.Start"
 Variant="Variant.Outlined"
 Margin="Margin.Dense"
 Clearable="true"
 Immediate="true"
 AdornmentIcon="@Icons.Material.Filled.Search"
 Class="zalo-search-field" />
 </div>

 <div class="zalo-conversation-items">
 @if (!FilteredConversations.Any() && string.IsNullOrEmpty(ErrorMessage))
 {
 <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-8">
 <MudIcon Icon="@Icons.Material.Filled.PersonOff" Size="Size.Large" Style="opacity:0.3" />
 <MudText Color="Color.Secondary" Typo="Typo.body2">Chua co cuoc tro chuyen nao</MudText>
 </MudStack>
 }

        @foreach (var conv in FilteredConversations)
        {
        <div class="zalo-conversation-item @(SelectedConversation?.Id == conv.Id ? "active" : "")"
        @onclick="() => SelectConversation(conv)">
        <div class="zalo-conv-avatar">
        <MudAvatar Size="Size.Small" Color="Color.Primary" Class="zalo-msg-avatar">
        @if (!string.IsNullOrEmpty(conv.AvatarUrl))
        {
        <img src="@conv.AvatarUrl" alt="avatar"
        style="width:100%;height:100%;object-fit:cover;border-radius:50%;"
        onerror="this.style.display='none';this.nextElementSibling&&(this.nextElementSibling.style.display='')">
        <span style="display:none">@conv.Name?.FirstOrDefault()</span>
        }
        else
        {
        @conv.Name?.FirstOrDefault()
        }
        </MudAvatar>
        @if (conv.UnreadCount > 0)
        {
        <span class="zalo-unread-badge">@conv.UnreadCount</span>
        }
        </div>
 <div class="zalo-conv-content">
 <div class="zalo-conv-name">@conv.Name</div>
 <div class="zalo-conv-preview">@(string.IsNullOrEmpty(conv.LastMessage) ? "Chua co tin nhan" : conv.LastMessage)</div>
 </div>
 <div class="zalo-conv-meta">
 <div class="zalo-conv-time">@conv.Time</div>
 @if (conv.IsOnline)
 {
 <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small"
 Style="color:#2b9ae4;font-size:10px;" />
 }
 </div>
 </div>
 }
 </div>
 </div>

 <!-- Right Panel: Chat Area -->
 <div class="zalo-chat-area">
 @if (SelectedConversation != null)
 {
 <div class="zalo-chat-header">
 <div class="zalo-chat-header-info">
 <MudAvatar Size="Size.Medium" Color="Color.Primary" Class="zalo-msg-avatar">
 @if (!string.IsNullOrEmpty(SelectedConversation.AvatarUrl))
 {
 <img src="@SelectedConversation.AvatarUrl" alt="avatar"
 style="width:100%;height:100%;object-fit:cover;border-radius:50%;"
 onerror="this.style.display='none';this.nextElementSibling&&(this.nextElementSibling.style.display='')">
 <span style="display:none">@SelectedConversation.Name?.FirstOrDefault()</span>
 }
 else
 {
 @SelectedConversation.Name?.FirstOrDefault()
 }
 </MudAvatar>
 <div>
 <div class="zalo-chat-name">@SelectedConversation.Name</div>
 <div class="zalo-chat-status">
 @(SelectedConversation.IsOnline ? "Dang hoat dong" : "Offline")
 </div>
 </div>
 </div>
 <div class="zalo-chat-actions">
 <MudIconButton Icon="@Icons.Material.Filled.MoreVert"
 Color="Color.Default" Size="Size.Small" />
 </div>
 </div>

 <div class="zalo-messages-container" id="zalo-messages-container">
 @if (IsLoadingMessages)
 {
 <div class="zalo-loading-more">
 <MudProgressCircular Size="Size.Small" Indeterminate="true" />
 <MudText Typo="Typo.caption">Dang tai tin nhan...</MudText>
 </div>
 }
 @if (!Messages.Any() && !IsLoadingMessages)
 {
 <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-8 full-height-center">
 <MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline" Size="Size.Large" Style="opacity:0.3" />
 <MudText Color="Color.Secondary" Typo="Typo.body2">Chua co tin nhan nao</MudText>
 <MudText Color="Color.Secondary" Typo="Typo.caption">
 Tin nhan se hien thi khi nguoi dung nhan tin den Zalo OA
 </MudText>
 </MudStack>
 }

 @if (HasMoreMessages)
 {
 <div class="zalo-load-more-container">
 @if (IsLoadingMore)
 {
 <MudProgressLinear Color="Color.Primary" Indeterminate="true" Rounded="true" />
 }
 else
 {
 <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
 OnClick="LoadMoreMessages" Class="zalo-load-more-btn">
 <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" />
 Xem them tin nhan (@(Messages.Count - DisplayedMessages.Count) tin nhan cu hon)
 </MudButton>
 }
 </div>
 }

@foreach (var msg in DisplayedMessages)
{
 @* Customer message (IsFromUser=true): ben TRAI, avatar trai, background trang *@
 @* Store message (IsFromUser=false): ben PHAI, avatar phai, background xanh *@
 <div class="zalo-message @(msg.IsFromUser ? "received" : "sent")">
 @if (msg.IsFromUser)
 {
 <MudAvatar Size="Size.Small" Color="Color.Secondary" Class="zalo-msg-avatar">
 @if (!string.IsNullOrEmpty(SelectedConversation.AvatarUrl))
 {
 <img src="@SelectedConversation.AvatarUrl" alt="avatar"
 style="width:100%;height:100%;object-fit:cover;border-radius:50%;"
 onerror="this.style.display='none';this.nextElementSibling&&(this.nextElementSibling.style.display='')">
 <span style="display:none">@SelectedConversation.Name?.FirstOrDefault()</span>
 }
 else
 {
 @SelectedConversation.Name?.FirstOrDefault()
 }
 </MudAvatar>
 }
 <div class="zalo-message-bubble">
 @if (msg.Type == "text")
 {
 <div class="zalo-msg-text">@msg.Content</div>
 }
 else if (msg.Type == "image")
 {
 <img src="@msg.FileUrl" class="zalo-msg-image" alt="image"
 onerror="this.style.display='none';this.nextElementSibling&&(this.nextElementSibling.style.display='')">
 <div class="zalo-msg-text mud-text-secondary" style="display:none">Hinh anh khong the tai</div>
 }
 else if (msg.Type == "file")
 {
 <div class="zalo-msg-file">
 <MudIcon Icon="@Icons.Material.Filled.AttachFile" />
 <span>@msg.FileName</span>
 <a href="@msg.FileUrl" target="_blank" class="zalo-msg-file-link">Tai xuong</a>
 </div>
 }
 else
 {
 <div class="zalo-msg-text">@msg.Content</div>
 }
 <div class="zalo-msg-time">
 @msg.Time
 @if (!string.IsNullOrEmpty(msg.Status) && msg.Status != "read")
 {
 <span class="zalo-msg-status @(msg.Status)">@(msg.Status == "sent" ? "" : msg.Status == "delivered" ? "\u2713" : "\u2713\u2713")</span>
 }
 </div>
 </div>
 @if (!msg.IsFromUser)
 {
 <MudAvatar Size="Size.Small" Color="Color.Primary" Class="zalo-msg-avatar">ME</MudAvatar>
 }
 </div>
}
 </div>

 <div class="zalo-chat-input-area">
 <div class="zalo-chat-input-wrapper">
 <MudTextField @bind-Value="NewMessage"
 Placeholder="Nhap tin nhan..."
 Immediate="true"
 Variant="Variant.Outlined"
 Margin="Margin.Dense"
 Adornment="Adornment.End"
 OnKeyUp="HandleKeyUp"
 Class="zalo-message-input">
 <AdornmentEnd>
 <MudIconButton Icon="@Icons.Material.Filled.Send"
 OnClick="SendMessage"
 Color="Color.Primary"
 Size="Size.Small"
 Disabled="@string.IsNullOrWhiteSpace(NewMessage)" />
 </AdornmentEnd>
 </MudTextField>
 <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
 OnClick="AttachFile"
 Color="Color.Default"
 Size="Size.Small"
 Class="zalo-attach-btn" />
 </div>
 <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="padding: 4px 0;">
 Nhan Enter de gui, Shift+Enter de xuong dong
 </MudText>
 </div>
 }
 else
 {
 <div class="zalo-empty-chat">
 <MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline"
 Size="Size.Large"
 Style="opacity:0.3;" />
 <MudText Typo="Typo.body1" Class="mud-text-secondary">
 Chon mot cuoc tro chuyen de bat dau
 </MudText>
 </div>
 }
 </div>
 </div>
 }
</div>
