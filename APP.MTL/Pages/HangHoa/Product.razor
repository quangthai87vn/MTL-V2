	/// <summary>Lấy URL ảnh: ưu tiên cache localStorage → server file cache → URL gốc.</summary>
	string GetImageUrl(MTL_GetAllProductsInCompanyResult product)
	{
		var rawUrl = product.pic00;
		if (string.IsNullOrWhiteSpace(rawUrl))
			return "/images/logo.png";
		if (_urlImageCache.TryGetValue(rawUrl, out var cached))
			return cached;
		return rawUrl;
	}

	/// <summary>Background preload tất cả ảnh của tab hiện tại sau khi render xong.</summary>
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await PreloadTabImagesAsync();
		}
	}

	/// <summary>Preload ảnh khi tab thay đổi.</summary>
	async Task PreloadTabImagesAsync()
	{
		var urls = ActiveProductTabItems
			.Select(p => p.pic00)
			.Where(u => !string.IsNullOrWhiteSpace(u))
			.Distinct()
			.Cast<string>()
			.ToList();

		if (!urls.Any()) return;

		var batchResult = await JSRuntime.InvokeAsync<Dictionary<string, ImageCacheResult>>(
			"MTLImageCache.cacheImagesBatch", urls!, "", 6);

		foreach (var kv in batchResult)
		{
			if (kv.Value.data != null && !_urlImageCache.ContainsKey(kv.Key))
				_urlImageCache[kv.Key] = kv.Value.data;
		}
		StateHasChanged();
	}

