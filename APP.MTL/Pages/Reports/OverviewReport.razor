    // RevenuePieChart data
    List<MTL.APP.Shared.PieSegment> RevenuePieDtSegments { get; set; } = new();
    List<MTL.APP.Shared.PieSegment> RevenuePieThSegments { get; set; } = new();

    decimal RevenuePieDtTotal => RevenuePieDtSegments.Sum(s => s.Value);
    decimal RevenuePieThTotal => RevenuePieThSegments.Sum(s => s.Value);

    string RevenuePieDtCenterValue => FormatShortVND((double)RevenuePieDtTotal);
    string RevenuePieThCenterValue => FormatShortVND((double)RevenuePieThTotal);

    void BuildRevenuePieChartData()
    {
        // Build Doanh Thu pie segments
        RevenuePieDtSegments = new();
        var lastM = GetLastComparisonMonth(YearSelect);
        var totalDt = TongDoanhThuKySoSanh;

        for (int i = 0; i < lastM; i++)
        {
            var val = (decimal)MonthlyComparisonData[i];
            var pct = totalDt > 0 ? (double)(val / (decimal)totalDt * 100) : 0;
            var seg = new MTL.APP.Shared.PieSegment
            {
                Name = $"Tháng {i + 1}",
                Value = val,
                Percent = pct,
                Color = _activePiePalette[i % _activePiePalette.Length],
                Month = i + 1
            };
            RevenuePieDtSegments.Add(seg);
        }

        // Build Thu Hang pie segments
        RevenuePieThSegments = new();
        var totalTh = TongThuHangKySoSanh;

        for (int i = 0; i < lastM; i++)
        {
            var val = (decimal)MonthlyThuHangComparisonData[i];
            var pct = totalTh > 0 ? (double)(val / (decimal)totalTh * 100) : 0;
            var seg = new MTL.APP.Shared.PieSegment
            {
                Name = $"Tháng {i + 1}",
                Value = val,
                Percent = pct,
                Color = _thuHangPiePalette[i % _thuHangPiePalette.Length],
                Month = i + 1
            };
            RevenuePieThSegments.Add(seg);
        }
    }

    ChartOptions _thuHangPieChartOptions = new()
    {
        ShowLegend = false,
        ChartPalette = MonthlyPiePaletteBlue
    };

    /// <summary>Tháng cuối cùng đưa vào so sánh: năm hiện tại → đến tháng hôm nay; năm trước → 12; năm sau → 0.</summary>
    int LastComparisonMonth => GetLastComparisonMonth(YearSelect);

    static int GetLastComparisonMonth(int year)
    {
        var now = DateTime.Now;
        if (year > now.Year) return 0;
        if (year < now.Year) return 12;
        return now.Month;
    }

    string MonthlyComparisonRangeText
    {
        get
        {
            var last = LastComparisonMonth;
            if (last < 1) return "";
            if (last == 12 && YearSelect < DateTime.Now.Year) return "Tháng 1–Tháng 12";
            return last == 1 ? "Tháng 1" : $"Tháng 1–Tháng {last}";
        }
    }

    double TongDoanhThuKySoSanh
    {
        get
        {
            var last = LastComparisonMonth;
            if (last < 1) return 0;
            return Enumerable.Range(1, last).Sum(m => MonthRevenues.GetValueOrDefault(m) ?? 0);
        }
    }

    double TongThuHangKySoSanh
    {
        get
        {
            var last = LastComparisonMonth;
            if (last < 1) return 0;
            return Enumerable.Range(1, last).Sum(m => MonthThuHangRevenues.GetValueOrDefault(m) ?? 0);
        }
    }

    double[] MonthlyComparisonData
    {
        get
        {
            var last = LastComparisonMonth;
            if (last < 1) return Array.Empty<double>();
            return Enumerable.Range(1, last)
                .Select(m => (double)(MonthRevenues.GetValueOrDefault(m) ?? 0))
                .ToArray();
        }
    }

    double[] MonthlyThuHangComparisonData
    {
        get
        {
            var last = LastComparisonMonth;
            if (last < 1) return Array.Empty<double>();
            return Enumerable.Range(1, last)
                .Select(m => (double)(MonthThuHangRevenues.GetValueOrDefault(m) ?? 0))
                .ToArray();
        }
    }

    string[] MonthlyComparisonLabels
    {
        get
        {
            var last = LastComparisonMonth;
            if (last < 1) return Array.Empty<string>();
            return Enumerable.Range(1, last).Select(m => MonthLabels[m - 1]).ToArray();
        }
    }

    /// <summary>Nhãn thu hàng theo tháng — dùng cùng MonthLabels nhưng chỉ đến LastComparisonMonth.</summary>
    string[] MonthlyThuHangLabels
    {
        get
        {
            var last = LastComparisonMonth;
            if (last < 1) return Array.Empty<string>();
            return Enumerable.Range(1, last).Select(m => MonthLabels[m - 1]).ToArray();
        }
    }

    double MaxDayTotalForSelectedMonth =>
        data == null || !data.Any() ? 0 : data.Max(DayTotal);

    static double DayTotal(MTL_ThongKeDoanhThuResult x)
        => (x.doanhthudichvu ?? 0) + (x.doanhthu ?? 0);

    private void Tick(object? _)
    {
        theTime = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
        _welcome = $"HÔM NAY {theTime} — {_TenUser?.ToUpper()} — {_Hethong?.ToUpper()}";
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AppTheme.ThemeChanged -= OnAppThemeChanged;
        aTimer?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        await AppTheme.InitializeAsync();
        SyncMonthlyPieUiFromTheme(bumpChartKey: false);
        try
        {
            IsLoading = true;
            userSession = await configs.LoadAllConfig();
            _TenUser = userSession?.user?.Fullname ?? "";
            _Hethong = userSession?.company?.Name ?? "";
            idcompany = userSession?.company?.Id ?? 0;
            YearSelect = DateTime.Now.Year;
            MonthSelect = DateTime.Now.Month;
            NgayHienTai = DateTime.Now.ToString("MM/dd/yyyy");

            aTimer = new Timer(Tick, null, 0, 1000);

            await LoadReportDoanhThuCoBan(NgayHienTai, isTienThucCo);
            await LoadMonthlyTotalsForYearAsync(YearSelect);
            await LoadMonthlyThuHangForYearAsync(YearSelect);
            await LoadNguonTienTheoQuyForYearAsync(YearSelect);
            await LoadChartDoanhThu(YearSelect, MonthSelect, isTienThucCo);
            BuildRevenuePieChartData();

            MaxDayRevenue = data == null || !data.Any() ? 0 : data.Max(DayTotal);
        }
        catch { }
        finally
        {
            IsLoading = false;
        }
    }

    async Task SelectMonth(int month)
    {
        MonthSelect = month;
        IsLoading = true;
        await LoadChartDoanhThu(YearSelect, MonthSelect, isTienThucCo);
        BuildRevenuePieChartData();
        MaxDayRevenue = data == null || !data.Any() ? 0 : data.Max(DayTotal);
        IsLoading = false;
    }

    async Task OnYearChanged(int year)
    {
        YearSelect = year;
        IsLoading = true;
        await LoadReportDoanhThuCoBan(NgayHienTai, isTienThucCo);
        await LoadMonthlyTotalsForYearAsync(YearSelect);
        await LoadMonthlyThuHangForYearAsync(YearSelect);
        await LoadNguonTienTheoQuyForYearAsync(YearSelect);
        await LoadChartDoanhThu(YearSelect, MonthSelect, isTienThucCo);
        BuildRevenuePieChartData();
        MaxDayRevenue = data == null || !data.Any() ? 0 : data.Max(DayTotal);
        IsLoading = false;
    }

    private async Task LoadChartDoanhThu(int Nam, int Thang, bool isTienThucCo)
    {
        try
        {
            DoanhThuThang = 0;
            data = await reportService.GetDoanhThuAsync(idcompany, Nam, Thang, isTienThucCo) ?? new();
            if (data.Any())
            {
                DoanhThuThang = data.Sum(DayTotal);
                if (Thang >= 1 && Thang <= 12)
                    MonthRevenues[Thang] = DoanhThuThang;
            }
            else if (Thang >= 1 && Thang <= 12)
                MonthRevenues[Thang] = 0;
            try
            {
                thuTheoNguonThang = await reportService.GetThuTheoNguonTrongThangAsync(idcompany, Nam, Thang);
            }
            catch
            {
                thuTheoNguonThang = new ThuTheoNguonThoiGianSummary();
            }
            try
            {
                thuDaVaoTheoNguon = await reportService.GetThuDaVaoTheoNguonTrongThangAsync(idcompany, Nam, Thang);
            }
            catch
            {
                thuDaVaoTheoNguon = new ThuDaVaoTheoNguonResult();
            }
            try
            {
                thuDaVaoTheoNguonTheoNgay = await reportService.GetThuDaVaoTheoNguonTheoNgayTrongThangAsync(idcompany, Nam, Thang, thuDaVaoTheoNguon);
            }
            catch
            {
                thuDaVaoTheoNguonTheoNgay = new ThuDaVaoTheoNguonTheoNgayResult();
            }
            _nguonTienBarSelectedIndex = -1;
            // Nhập hàng theo ngày
            try
            {
                NhapHangTheoNgay = await reportService.GetNhapHangTheoNgayTrongThangAsync(idcompany, Nam, Thang);
            }
            catch
            {
                NhapHangTheoNgay = new NhapHangTheoNgayResult();
            }
        }
        catch
        {
            data = new();
            thuTheoNguonThang = new ThuTheoNguonThoiGianSummary();
            thuDaVaoTheoNguon = new ThuDaVaoTheoNguonResult();
            thuDaVaoTheoNguonTheoNgay = new ThuDaVaoTheoNguonTheoNgayResult();
            NhapHangTheoNgay = new NhapHangTheoNgayResult();
        }
    }

    /// <summary>
    /// Gọi tuần tự từ T1 đến tháng cuối kỳ so sánh (năm nay: đến tháng hiện tại; năm cũ: đủ 12).
    /// Các tháng sau (cùng năm tương lai trong lịch) giữ 0 — vẫn load khi user bấm tháng đó.
    /// </summary>
    private async Task LoadMonthlyTotalsForYearAsync(int year)
    {
        MonthRevenues = Enumerable.Range(1, 12).ToDictionary(m => m, _ => (double?)0);
        if (idcompany <= 0)
        {
            _monthlyPieSelectedIndex = -1;
            _monthlyChartVersion++;
            return;
        }
        var lastM = GetLastComparisonMonth(year);
        if (lastM < 1)
        {
            _monthlyPieSelectedIndex = -1;
            _monthlyChartVersion++;
            return;
        }
        for (var m = 1; m <= lastM; m++)
        {
            try
            {
                var rows = await reportService.GetDoanhThuAsync(idcompany, year, m, isTienThucCo) ?? new();
                MonthRevenues[m] = rows.Sum(DayTotal);
            }
            catch
            {
                MonthRevenues[m] = 0;
            }
        }
        _monthlyPieSelectedIndex = -1;
        _monthlyChartVersion++;
    }

    /// <summary>Nạp tổng thu hàng theo tháng (năm) từ SP uf_ThongKeThuHangHoa_Nam.</summary>
    private async Task LoadMonthlyThuHangForYearAsync(int year)
    {
        MonthThuHangRevenues = Enumerable.Range(1, 12).ToDictionary(m => m, _ => (double?)0);
        if (idcompany <= 0)
        {
            _thuHangPieSelectedIndex = -1;
            _thuHangChartVersion++;
            return;
        }
        var lastM = GetLastComparisonMonth(year);
        if (lastM < 1)
        {
            _thuHangPieSelectedIndex = -1;
            _thuHangChartVersion++;
            return;
        }
        try
        {
            var rows = await thuHangHoaService.ThongKeNamAsync(idcompany, year) ?? new();
            foreach (var g in rows.GroupBy(r => r.thang))
            {
                var month = g.Key;
                if (month >= 1 && month <= 12)
                    MonthThuHangRevenues[month] = g.Sum(x => x.tongsotien ?? 0);
            }
        }
        catch
        {
            for (var m = 1; m <= 12; m++)
                MonthThuHangRevenues[m] = 0;
        }
        _thuHangPieSelectedIndex = -1;
        _thuHangChartVersion++;
    }

    private async Task LoadReportDoanhThuCoBan(string NgayHienTai, bool isTienThucCo)
    {
        try
        {
            data_doanhthucoban = await reportService.GetDoanhThuCoBanAsync(idcompany, NgayHienTai, isTienThucCo) ?? new();
        }
        catch { data_doanhthucoban = new(); }
    }

    string FormatVND(double? amount)
    {
        return string.Format("{0:n0}đ", amount ?? 0);
    }

    /// <summary>Rút gọn: 1.5M, 250K…</summary>
    string FormatShortVND(double? amount)
    {
        if (!amount.HasValue || amount == 0) return "0đ";
        var v = amount.Value;
        if (v >= 1_000_000_000) return $"{v / 1_000_000_000:0.0}T";
        if (v >= 1_000_000) return $"{v / 1_000_000:0.0}M";
        if (v >= 1_000) return $"{v / 1_000:0.#}K";
        return $"{v:0}đ";
    }

    int SparkPct(double? value, double max)
    {
        if (max <= 0 || !value.HasValue) return 0;
        return Math.Min(100, (int)(100.0 * value.Value / max));
    }

