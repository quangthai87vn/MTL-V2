	async Task ThemHangHoaDialog()
	{
		MTL_GetAllProductsInCompanyResult product = new MTL_GetAllProductsInCompanyResult();
		var parameters = new DialogParameters<DialogAddHangHoa>();
		parameters.Add(x => x.isNew, true);
		parameters.Add(x => x.userSession, userSession);
		parameters.Add(x => x.NhomHangParentList, NhomHangParentList);
		parameters.Add(x => x.BaoHanhList, BaoHanhList);
		parameters.Add(x => x.ThuongHieuList, ThuongHieuList);
		parameters.Add(x => x.ViTriList, ViTriList);
		parameters.Add(x => x.DVTList, DVTList);
		parameters.Add(x => x.LoaiHHDVList, LoaiHHDVList);
		parameters.Add(x => x.UserList, UserList);
		parameters.Add(x => x.idLoaiHHDV, _filter.v_loaihh);
		parameters.Add(x => x.HangHoa, this.ToProduct(product, true));
		string headerText = "THÊM HÀNG HÓA";
		var dialog = await DialogService.ShowEx<DialogAddHangHoa>(headerText, parameters, options_FullScreen);
