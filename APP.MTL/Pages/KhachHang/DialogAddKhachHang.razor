	}


	async Task SDT_TextChanged(string Dienthoai)
	{
		model.Dienthoai = Dienthoai.Replace("_", "");
		_tmpDienThoai = Dienthoai.Replace("_", "");
		model = await khachHangService.CheckSDTKhachHangExitsAsync(idcompany, model);
		if (model.Dienthoai == null) // chưa có thông tin khách
		{
			model.Idnhomkhachhang = Idnhomkhachhang;// chọn nhóm
			model.Fullname = "Khách VIP";
			model.Dienthoai = _tmpDienThoai;
		}
		else
		{
			await LayDuLieuKhachHang();
		}

	}

	async Task SaveAsync()
	{
		await form.Validate();
		if (form.IsValid)
		{
			khach = await khachHangService.SaveKhachHangAsync(model, userSession);
			KhachHang.Id = khach.Id;
			string mess = $"Cập nhật thông tin [{model.Fullname}] thành công";
			_HandleCommon.OpenSusscessSnackbarDialog(SnackbarService, mess);
			await OnDialogCallback.InvokeAsync(KhachHang);

			MudDialog.Close(DialogResult.Ok(khach));
		}
		else
		{
			_HandleCommon.OpenErrorSnackbarDialog(SnackbarService, "Có lỗi xảy ra, vui lòng xem lại !");
		}
	}

	async Task ClosePopup()
	{
		MudDialog.Cancel();
	}

	public string FormatCurrency(double? amount)
	{
		return string.Format("{0:n0}", amount);
	}

	static string TruncateZnsContent(string? s, int max)
	{
		if (string.IsNullOrEmpty(s)) return "";
		var t = s.Trim();
		return t.Length <= max ? t : t[..max] + "…";
	}

	/// <summary>Format ngày gửi ZNS, xử lý năm không hợp lệ.</summary>
	static string FormatNgayGui(DateTime ngaygui) =>
		ngaygui.Year >= 1900 ? ngaygui.ToString("dd/MM/yyyy HH:mm") : "—";

	async Task LoadZnsHistoryAsync()
	{
		try
		{
			var phone = model?.Dienthoai;
			if (!string.IsNullOrWhiteSpace(phone))
			{
				ListZnsHistory = await znsCampaignService.GetZnsHistoryByPhoneAsync(
					idcompany, phone);
			}
		}
		catch (Exception)
		{
			ListZnsHistory = new();
		}
	}

}

