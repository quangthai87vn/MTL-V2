		StateHasChanged();
	}

	void SyncSplitForThanhToanFooterChange()
	{
		var tt = hdbh.Thanhtoan ?? 0;
		var id = hdbh.Idhinhthucthanhtoan ?? MTLEnum.HinhThucThanhToan.TienMat;
		if (id == MTLEnum.HinhThucThanhToan.TienMat)
			hdbh.Tienmat = tt;
		else if (id == MTLEnum.HinhThucThanhToan.ChuyenKhoan || id == MTLEnum.HinhThucThanhToan.Quetthe)
		{
			hdbh.Tienmat = 0;
			hdbh.Tienchuyenkhoan = tt;
		}
		else if (id == MTLEnum.HinhThucThanhToan.TienMatVaChuyenKhoan)
		{
			var total = hdbh.Tongtiensauvat ?? 0;
			var ck = hdbh.Tienchuyenkhoan ?? 0;
			var tm = hdbh.Tienmat ?? 0;
			var sum = tm + ck;
			if (sum < 0.01)
			{
				ck = Math.Min((double)tt, total);
				hdbh.Tienchuyenkhoan = ck;
				hdbh.Tienmat = total - ck;
			}
			else
			{
				var r = (double)tt / sum;
				hdbh.Tienchuyenkhoan = Math.Round(ck * r, 0);
				hdbh.Tienmat = total - (hdbh.Tienchuyenkhoan ?? 0);
			}
			hdbh.Thanhtoan = tt;
		}
		else if (id == MTLEnum.HinhThucThanhToan.Tragop)
		{
			var total = hdbh.Tongtiensauvat ?? 0;
			hdbh.Tienmat = tt;
			hdbh.Tienchuyenkhoan = 0;
			hdbh.Conlai = total - tt;
			hdbh.Tienchuyenkhoandukien = hdbh.Conlai;
		}
	}

	bool NeedsChonNganHang()
	{
		var htt = hdbh.Idhinhthucthanhtoan ?? 0;
