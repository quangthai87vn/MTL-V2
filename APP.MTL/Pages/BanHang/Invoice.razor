	string InvoiceModelLabel(MTL_GetAllInvoiceResult inv) =>
		string.IsNullOrWhiteSpace(inv.Model) ? "—" : inv.Model.Trim();

	/// <summary>Render tag chips từ danh sách ID (đã join bằng ',').</summary>
	RenderFragment RenderTagChips(string? listIdTags)
	{
		if (string.IsNullOrWhiteSpace(listIdTags)) return __builder => { };

		RenderFragment rf = chipBuilder =>
		{
			var parts = listIdTags.Split(',', StringSplitOptions.RemoveEmptyEntries);
			var seq = 0;
			foreach (var part in parts)
			{
				if (int.TryParse(part.Trim(), out var tagId) && _tagById.TryGetValue(tagId, out var tag))
				{
					var baseSeq = seq * 10;
					chipBuilder.OpenComponent<MudChip<string>>(baseSeq);
					chipBuilder.AddAttribute(baseSeq + 1, "Icon", tag.Icon ?? "");
					chipBuilder.AddAttribute(baseSeq + 2, "Size", Size.Small);
					chipBuilder.AddAttribute(baseSeq + 3, "T", string.Empty);
					chipBuilder.AddAttribute(baseSeq + 4, "Style", $"color:{tag.Textcolor};background:{tag.Backgroundcolor};");
					chipBuilder.AddAttribute(baseSeq + 5, "ChildContent", (RenderFragment)(b => b.AddContent(baseSeq + 6, $" {tag.Name}")));
					chipBuilder.CloseComponent();
					seq++;
				}
			}
		};
		return rf;
	}

