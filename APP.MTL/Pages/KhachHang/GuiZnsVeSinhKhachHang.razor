	async Task ExecuteSendAsync()
	{
		var toSend = _filteredRows.Where(r =>
			!string.IsNullOrEmpty(r.mahd) && _selectedMahd.Contains(r.mahd!) && CanSelectInvoiceForZns(r.mahd)).ToList();
		if (toSend.Count == 0)
		{
			SnackbarService.Add("Không có hóa đơn nào đủ điều kiện gửi (đã lọc theo mẫu / nhật ký). Kiểm tra lại bước 2.", Severity.Warning);
			return;
		}

		_sendStarted = true;
		_sending = true;
		_results = toSend.Select(inv => new ZnsSendRowResult(
			inv.mahd!, inv.tenkh ?? "", ZnsSendLineStatus.Queued, false, 0, "", null)).ToList();
		await InvokeAsync(StateHasChanged);
		// Cho UI kịp vẽ bảng đủ dòng «Chờ gửi» trước khi dòng đầu chuyển «Đang gửi»
		await Task.Yield();
		await InvokeAsync(StateHasChanged);

		var templateName = ZnsTemplates.FirstOrDefault(t => t.Id == _selectedTemplateId)?.Mota ?? "";
		var nguoi = _session.FullName ?? _session.user?.Fullname ?? "";

		for (var i = 0; i < toSend.Count; i++)
		{
			var inv = toSend[i];
			var loai = ResolveLoaiFor(inv);
			var tenMay = TenMayTinh(inv);
			var preview = ZnsVeSinhCampaignService.BuildVeSinhPreviewBody(
				inv.tenkh ?? "", inv.sodienthoai ?? "", loai, inv.mahd ?? "", tenMay, inv.ngaytraphieu);

			_results[i] = _results[i] with { LineStatus = ZnsSendLineStatus.Sending };
			await InvokeAsync(StateHasChanged);

			try
			{
				var ngay = inv.ngaytraphieu ?? DateTime.Today;
				var (ok, code, body, url) = await znsCampaignService.SendVeSinhWebhookAsync(
					inv.sodienthoai ?? "", inv.tenkh ?? "", "Vệ sinh", ngay,
					inv.mahd ?? "", inv.ghichukohienbill ?? "", loai, tenMay, nguoi);

				var sentAt = DateTime.Now;
				await znsCampaignService.InsertLogAsync(new TblZnsGuiNhatKy
				{
					Idcompany = _idcompany,
					Iduser = _iduser,
					Mahd = inv.mahd,
					Idkhachhang = inv.idkhachhang,
					Sodienthoai = inv.sodienthoai,
					Tenkhachhang = inv.tenkh,
					Idtemplate = _selectedTemplateId,
					Tenmau = templateName,
					Loaidichvu = loai,
					Noidungxemtruoc = preview,
					RequestUrl = Truncate(url, 1990),
					HttpStatus = code,
					ResponseBody = Truncate(body, 8000),
					Thanhcong = ok,
					Ghichu = ok ? null : Truncate(body, 900),
					Ngaygui = sentAt
				});

				_results[i] = _results[i] with
				{
					LineStatus = ZnsSendLineStatus.Done,
					Success = ok,
					HttpStatus = code,
					Detail = ok ? "Thành công" : body,
					SentAt = sentAt
				};
			}
			catch (Exception ex)
			{
				var sentAt = DateTime.Now;
				_results[i] = _results[i] with
				{
					LineStatus = ZnsSendLineStatus.Done,
					Success = false,
					HttpStatus = 0,
					Detail = ex.Message,
					SentAt = sentAt
				};
				await znsCampaignService.InsertLogAsync(new TblZnsGuiNhatKy
				{
					Idcompany = _idcompany,
					Iduser = _iduser,
					Mahd = inv.mahd,
					Idkhachhang = inv.idkhachhang,
					Sodienthoai = inv.sodienthoai,
					Tenkhachhang = inv.tenkh,
					Idtemplate = _selectedTemplateId,
					Tenmau = templateName,
					Loaidichvu = loai,
					Noidungxemtruoc = preview,
					Thanhcong = false,
					Ghichu = Truncate(ex.Message, 900),
					Ngaygui = sentAt
				});
			}

			await InvokeAsync(StateHasChanged);
		}

		_sending = false;
		await LoadZnsLogsAsync();
		SnackbarService.Add($"Đã xử lý {_results.Count} tin.", Severity.Success);
		await InvokeAsync(StateHasChanged);
	}

	async Task ResetWizardAsync()
	{
		_wizardStep = 0;
		_sendStarted = false;
		_sending = false;
		_results.Clear();
		_selectedMahd.Clear();
		_manualLoaiVeSinh = AutoLoaiToken;
		await ApplyFilterAsync();
	}

	int SendProgressTotal => _results.Count;
	int SendProgressDone => _results.Count(r => r.LineStatus == ZnsSendLineStatus.Done);
	double SendProgressPercent => SendProgressTotal <= 0 ? 0 : 100.0 * SendProgressDone / SendProgressTotal;

	enum ZnsSendLineStatus { Queued, Sending, Done }

	sealed record ZnsSendRowResult(
		string Mahd,
		string TenKh,
		ZnsSendLineStatus LineStatus,
		bool Success,
		int HttpStatus,
		string Detail,
		DateTime? SentAt);
}
