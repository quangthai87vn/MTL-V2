	async Task AddRowSPThanhPhan(MTL_GetSanPhamThanhPhanResult thanhphan)
	{
		thanhphan.tensp = thanhphan.tensp;
		if (thanhphan.idhanghoathanhphan == null) // là SP ảo
			thanhphan.idhanghoathanhphan = 0;
		// else thanhphan.idhanghoathanhphan = thanhphan.idhanghoathanhphan;
		thanhphan.masp = thanhphan.masp;
		thanhphan.sl = thanhphan.sl;
		thanhphan.giaban = thanhphan.giaban;
		thanhphan.thanhtien = thanhphan.sl * thanhphan.giaban;
		thanhphan.idbaohanh = thanhphan.idbaohanh;
		thanhphan.beginupdate = DateTime.Now;
		thanhphan.lastupdate = DateTime.Now;
		thanhphan.chietkhau = 0;
		ListHangHoaThanhPhan.Add(thanhphan);
		// cập nhật giá tổng
		model.Giaban = ListHangHoaThanhPhan.Sum(x => x.thanhtien);
	}

	async Task UpdateRowSPThanhPhan(MTL_GetSanPhamThanhPhanResult thanhphan)
	{
		// Tìm phần tử cần cập nhật trong danh sách dựa vào id
		var itemToUpdate = ListHangHoaThanhPhan.FirstOrDefault(x => x.id == thanhphan.id);

		// Tìm chỉ số của phần tử cần cập nhật
		var index = ListHangHoaThanhPhan.FindIndex(x => x.id == thanhphan.id);

		if (index != -1) // Nếu tìm thấy phần tử
		{
			// Cập nhật các thuộc tính của phần tử đã tìm thấy
			ListHangHoaThanhPhan[index].tensp = thanhphan.tensp;
			ListHangHoaThanhPhan[index].masp = thanhphan.masp;
			ListHangHoaThanhPhan[index].sl = thanhphan.sl;
			ListHangHoaThanhPhan[index].giaban = thanhphan.giaban;
			ListHangHoaThanhPhan[index].thanhtien = thanhphan.sl * thanhphan.giaban;
			ListHangHoaThanhPhan[index].idbaohanh = thanhphan.idbaohanh;
			ListHangHoaThanhPhan[index].lastupdate = DateTime.Now;
			ListHangHoaThanhPhan[index].chietkhau = thanhphan.chietkhau;
			ListHangHoaThanhPhan[index].issanphamao = thanhphan.issanphamao;
			// Cập nhật giá tổng sau khi thay đổi
			model.Giaban = ListHangHoaThanhPhan.Sum(x => x.thanhtien);
		}

	}
