POSTGRES_DB=mtl_v2
POSTGRES_USER=mtl_app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
MTL_ADMIN_EMAIL=admin@mtl.vn
MTL_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
MTL_COMPANY_NAME=MỸ THO LAPTOP

# Production deployment. docker-compose.yml local không sử dụng các biến này.
MTL_BIND_ADDRESS=127.0.0.1
MTL_HTTP_PORT=8080
# Để false khi kiểm tra bằng localhost/LAN; chuyển true sau khi proxy HTTPS hoạt động.
MTL_REQUIRE_HTTPS=false
IMAGE_TAG=main

