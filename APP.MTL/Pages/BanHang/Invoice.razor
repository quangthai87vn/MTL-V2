	/// <summary>Filter search + build cache — gọi khi data hoặc searchString thay đổi.
	/// ĐÃ TỐI ƯU: 1 pass duy nhất, phân loại trực tiếp vào các danh sách.</summary>
	void BuildFilteredCache()
	{
		_searchCache = searchString ?? "";
		var hasSearch = !string.IsNullOrEmpty(_searchCache);
		string lower = hasSearch ? _searchCache.ToLowerInvariant() : "";

		var source = data ?? new List<MTL_GetAllInvoiceResult>();

		// Single-pass: phân loại trực tiếp vào 4 danh sách
		var filteredAll = new List<MTL_GetAllInvoiceResult>();
		var filteredBaoGia = new List<MTL_GetAllInvoiceResult>();
		var filteredChuaXuLy = new List<MTL_GetAllInvoiceResult>();
		var filteredDaXuLy = new List<MTL_GetAllInvoiceResult>();

		// Cache ngày thành chuỗi tìm kiếm (tránh lặp ToString)
		string? searchDate = hasSearch ? DateTime.Now.ToString("dd/MM/yyyy") : null;

		foreach (var inv in source)
		{
			// Check search match trước
			bool matchSearch = !hasSearch || MatchSearch(inv, lower);

			if (!matchSearch) continue;

			// Phân loại vào đúng danh sách
			filteredAll.Add(inv);

			int idLoai = inv.idLoaiPhieu ?? 0;
			if (idLoai == 4)
			{
				filteredBaoGia.Add(inv);
			}
			else
			{
				if (inv.isDichVuDaXuLy != true)
					filteredChuaXuLy.Add(inv);
				else
					filteredDaXuLy.Add(inv);
			}
		}

		_filteredData = filteredAll.AsReadOnly();
		_baoGiaData = filteredBaoGia.AsReadOnly();
		_chuaXuLyData = filteredChuaXuLy.AsReadOnly();
		_daXuLyData = filteredDaXuLy.AsReadOnly();
	}

	/// <summary>Kiểm tra invoice có match với search string không.
	/// ĐÃ TỐI ƯU: dùng switch expression và short-circuit evaluation.</summary>
	bool MatchSearch(MTL_GetAllInvoiceResult inv, string lower)
	{
		// Short-circuit: kiểm tra nhanh nhất trước (có thể null)
		if (inv.mahd?.Contains(lower, StringComparison.OrdinalIgnoreCase) == true) return true;
		if (inv.sodienthoai?.Contains(lower, StringComparison.OrdinalIgnoreCase) == true) return true;
		if (inv.tenkh?.Contains(lower, StringComparison.OrdinalIgnoreCase) == true) return true;
		if (inv.Model?.Contains(lower, StringComparison.OrdinalIgnoreCase) == true) return true;
		if (inv.ghichukohienbill?.Contains(lower, StringComparison.OrdinalIgnoreCase) == true) return true;

		// Check ngày - ít khi match nên để cuối
		if (inv.ngaytraphieu.HasValue &&
			inv.ngaytraphieu.Value.ToString("dd/MM/yyyy").Contains(lower, StringComparison.OrdinalIgnoreCase)) return true;
		if (inv.ngaylapphieu.HasValue &&
			inv.ngaylapphieu.Value.ToString("dd/MM/yyyy").Contains(lower, StringComparison.OrdinalIgnoreCase)) return true;

		return false;
	}

