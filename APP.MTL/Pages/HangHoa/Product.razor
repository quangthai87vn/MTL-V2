	private bool FilterFunc(MTL_GetAllProductsInCompanyResult element)
	{
		if (string.IsNullOrWhiteSpace(searchString))
			return true;
		if (element.tensp != null && element.tensp.Contains(searchString, StringComparison.OrdinalIgnoreCase))
			return true;
		if (element.masp != null && element.masp.Contains(searchString, StringComparison.OrdinalIgnoreCase))
			return true;
		if (element.model != null && element.model.Contains(searchString, StringComparison.OrdinalIgnoreCase))
			return true;
		return false;
	}

	/// <summary>Lọc sản phẩm theo loại HHDV (tab) — không gọi API lại.</summary>
	IReadOnlyList<MTL_GetAllProductsInCompanyResult> GetItemsByLoaiHH(int loaiId)
	{
		if (ListProduct == null) return [];
		var search = searchString?.Trim().ToLowerInvariant() ?? "";
		// null idloaihanghoadichvu → coi là Hàng hóa (1) để vẫn hiện trong tab
		var query = ListProduct.Where(p => (p.idloaihanghoadichvu ?? LoaiHinhKinhDoanh.HangHoa) == loaiId);
		if (!string.IsNullOrEmpty(search))
		{
			query = query.Where(p =>
				(p.tensp?.ToLowerInvariant().Contains(search) ?? false) ||
				(p.masp?.ToLowerInvariant().Contains(search) ?? false) ||
				(p.model?.ToLowerInvariant().Contains(search) ?? false));
		}
		return query.ToList();
	}

