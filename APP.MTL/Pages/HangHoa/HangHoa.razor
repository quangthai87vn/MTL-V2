@page "/product1111"
@using Blazored.Toast
@using MTL.APP.Models
@using Blazored.LocalStorage;
@using Blazored.Toast
@using Blazored.Toast.Services
@using MTL.APP.Services
@using MTL.APP.Utils
@using MTL.APP.Models;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject IJSRuntime JSRuntime
@inject HangHoaService hangHoaService
@inject UserService userService
@inject NavigationManager NavigationManager
@inject IToastService toastService
@inject ProtectedLocalStorage BrowserStorage
@inject APIWooService wooAPIService
@inject Configs configs
@attribute [Authorize]

<style>
	.my-style {
		font-weight: bold !important;
		color: #0d6efd;
	}
</style>

<AuthorizeView>
	<Authorized>
		<div class="card-body">
			<DxFormLayout CssClass="w-100">
				<DxFormLayoutItem Caption="" ColSpanSm="2" Context="sohd">
					<DxButton RenderStyle="ButtonRenderStyle.Primary" CssClass="w-100"
							  Text="THÊM" Title="THÊM"
							  Enabled=!IsLoading
							  SizeMode="SizeMode.Large"
							  IconCssClass="fas fa-plus-circle" Click="ShowNewForm" />
				</DxFormLayoutItem>
				<DxFormLayoutItem Caption="" ColSpanSm="2" Context="sohd">
					<DxButton RenderStyle="ButtonRenderStyle.Danger" CssClass="w-100"
							  Text="EXCELL" Title="XUẤT EXCELL"
							  Enabled=!IsLoading
							  SizeMode="SizeMode.Large"
							  IconCssClass="fas fa-file-export" Click="ExportXlsx" />
				</DxFormLayoutItem>
				<DxFormLayoutItem Caption="Tồn kho:" ColSpanMd="2" Context="TonKho">
					<DxComboBox Data=@MTLEnum.TonKho.data CssClass="w-100"
								Enabled=!IsLoading
								Value=@_filter.v_tonkho
								ValueChanged="@((string v) => ValueChangedHandler_TonKho(v))" />
				</DxFormLayoutItem>
				<DxFormLayoutItem Caption="Loại hình KD:" ColSpanMd="2" Context="LoaiHH">
					<DxComboBox Data="@LoaiHHDVList" CssClass="w-100"
								Enabled=!IsLoading
								NullText="Chọn loại hàng hóa - dịch vụ ..."
								ShowValidationIcon="true"
								TextFieldName="Loaihanghoadichvu"
								ValueFieldName="Id"
								Value="_filter.v_loaihh"
								ValueChanged="@((int v) => ValueChangedHandler_LoaiHH(v))" />
				</DxFormLayoutItem>
				<DxFormLayoutItem Caption="Theo ngày:" ColSpanMd="2" Context="TheoNgay">
					<DxComboBox Data=@MTLEnum.SapXepTheoNgay.data CssClass="w-100"
								Enabled=!IsLoading
								Value="@_filter.v_theongay"
								ValueChanged="@((string v) => ValueChangedHandler_Day(v))" />
				</DxFormLayoutItem>
				<DxFormLayoutItem Caption="Số dòng:" ColSpanMd="2" Context="sodong">
					<DxComboBox Data=@MTLEnum.SoDongHienThi.data CssClass="w-100"
								Enabled=!IsLoading
								ShowValidationIcon="true"
								Value=_filter.v_sodong
								ValueChanged="@((int v) => ValueChangedHandler_SoDong(v))"
								NullText="Chọn số dòng">
					</DxComboBox>
				</DxFormLayoutItem>
				<SpinLoader IsLoading=@IsLoading Spinner="SpinnerType.Chase">
					<LoadingTemplate>
						<Loading />
					</LoadingTemplate>
					<ContentTemplate>
						@{
							<DxFormLayoutItem Caption="" ColSpanMd="12" Context="sosptrentrang">
								<DxGrid Data="@ListProduct" @ref=MyGrid
										KeyFieldName="id"
										CssClass=" MTLGrid dx-datagrid-headers "
										PageSize=_filter.v_sodong
										PagerPosition="GridPagerPosition.Bottom"
										ShowFilterRow="true"
										ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
										CustomizeCellDisplayText="Grid_CustomizeCellDisplayText"
										CustomizeElement="Grid_CustomizeElement"
										CustomizeEditModel="Grid_CustomizeEditModel"
										EditModelSaving="OnEditModelSaving"
										PageIndexChanged=OnPageProductListIndexChanged
										UnboundColumnData=ProductListCustomUnboundColumnData
										ShowSearchBox="true"
										SearchBoxInputDelay="200"
										SearchBoxNullText="Gõ nội dung cần tìm ..."
										PopupEditFormCssClass="PopupEditFormService"
										EditFormButtonsVisible=false
										VirtualScrollingEnabled="false"
										EditMode="GridEditMode.PopupEditForm">
									<Columns>
										<DxGridCommandColumn Width="150px" NewButtonVisible=false>
											<CellDisplayTemplate Context="Edit_Delete">
												@*
											@{
											string urledit = string.Format("/ThemHangHoa/{0}/{1}", _filter.v_loaihh, (Edit_Delete.DataItem as MTL_GetAllProductsResult).id);
											}
											<a href=@urledit class="btn btn-primary" role="button">
											<span class="btn-label"><i class="fas fa-edit"></i></span>
											</a>*@
												<a @onclick="@(() => ShowEditForm(Edit_Delete))" class="btn btn-primary" role="button">
													<span class="btn-label"><i class="fas fa-edit"></i></span>
												</a>
												<a @onclick="@(() => OnDeleteButtonClick(Edit_Delete))" class="btn btn-danger" role="button">
													<span class="btn-label"><i class="fas fa-trash"></i></span>
												</a>
												<a @onclick="@(() => OnPrintButtonClick(Edit_Delete))" target="_blank" class="btn btn-warning" role="button">
													<span class="btn-label"><i class="fas fa-print"></i></span>
												</a>
											</CellDisplayTemplate>
										</DxGridCommandColumn>
										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.active) Caption="H.HÀNG" Width="70px" UnboundType="GridUnboundColumnType.Boolean">
											<CellDisplayTemplate Context="c_active">
												<DxCheckBox CssClass="d-inline-block"
															CheckType="CheckType.Switch"
															Enabled="false"
															Checked="!(bool)c_active.Value" />
											</CellDisplayTemplate>
										</DxGridDataColumn>
										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.pic00) Caption="ẢNH" Width="60" FilterRowOperatorType="GridFilterRowOperatorType.Contains">
											<CellDisplayTemplate Context="c_model">
												@{
													string url_anhdaidien = company.Logourl;
													if (((MTL_GetAllProductsResult)c_model.DataItem).pic00 != null)
													{
														url_anhdaidien = ((MTL_GetAllProductsResult)c_model.DataItem).pic00;
													}
													<img src=@url_anhdaidien alt="" width="50px" height="50px">
												}
											</CellDisplayTemplate>
										</DxGridDataColumn>
										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.tensp) Caption="SẢN PHẨM" Width="350" FilterRowOperatorType="GridFilterRowOperatorType.Contains" />
										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.idnhomhang) Caption="NHÓM HÀNG" Width="150" TextAlignment="GridTextAlignment.Right" SortMode="GridColumnSortMode.DisplayText">
											<FilterRowCellTemplate Context="c_nhomhangparent">
												<DxComboBox Value="(int?)c_nhomhangparent.FilterRowValue"
															ValueChanged="(int? v) => c_nhomhangparent.FilterRowValue = v"
															Data=NhomHangParentList ValueFieldName="id" TextFieldName="nhomhang"
															FilteringMode="DataGridFilteringMode.Contains"
															ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
											</FilterRowCellTemplate>
										</DxGridDataColumn>
										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.giaban) Caption="GIÁ BÁN" Width="100" DisplayFormat="C0" TextAlignment="GridTextAlignment.Right" />
										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.iddonvitinh) Caption="ĐVT" Width="70" TextAlignment="GridTextAlignment.Right">
											<FilterRowCellTemplate Context="c_DVTList">
												<DxComboBox Value="(int?)c_DVTList.FilterRowValue"
															ValueChanged="(int? v) => c_DVTList.FilterRowValue = v"
															Data=DVTList ValueFieldName="Id" TextFieldName="Donvitinh"
															FilteringMode="DataGridFilteringMode.Contains"
															ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
											</FilterRowCellTemplate>
										</DxGridDataColumn>

										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.masp) Caption="MÃ HÀNG" Width="120" TextAlignment="GridTextAlignment.Right" />
										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.model) Context="model" Caption="MODEL" Width="140" TextAlignment="GridTextAlignment.Right">
											<HeaderCaptionTemplate>
												<span title="Click xem chi tiết ">MODEL</span>
											</HeaderCaptionTemplate>
											<CellDisplayTemplate Context="c_model">
												@{
													var webUrl = ((MTL_GetAllProductsResult)c_model.DataItem).link;
													var t_Model = c_model.Value;
													if (webUrl != null)
													{
														if (webUrl != "")
														{
															<a target="_blank" href=@webUrl style="color: red">@t_Model</a>
														}
														else
														{
															<a target="_blank" style="color: black">@t_Model</a>
														}
													}
													else
													{
														<a target="_blank" style="color: black">@t_Model</a>
													}
												}
											</CellDisplayTemplate>
										</DxGridDataColumn>
										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.idthuonghieu) Caption="T.HIỆU" Width="80" TextAlignment="GridTextAlignment.Right" SortMode="GridColumnSortMode.DisplayText">
											<FilterRowCellTemplate Context="c_ThuongHieuList">
												<DxComboBox Value="(int?)c_ThuongHieuList.FilterRowValue"
															ValueChanged="(int? v) => c_ThuongHieuList.FilterRowValue = v"
															Data=ThuongHieuList ValueFieldName="id" TextFieldName="thuonghieu"
															FilteringMode="DataGridFilteringMode.Contains"
															ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
											</FilterRowCellTemplate>
										</DxGridDataColumn>
										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.woo_id) Caption="WOO" Width="60" DisplayFormat="N0" TextAlignment="GridTextAlignment.Right">
											<CellDisplayTemplate Context="c_model">
												@{
													var webUrl = ((MTL_GetAllProductsResult)c_model.DataItem).link;
													var t_Model = c_model.Value;
													if (webUrl != null)
													{
														if (webUrl != "")
														{
															<a target="_blank" href=@webUrl style="color: red">@t_Model</a>
														}
														else
														{
															<a target="_blank" style="color: black">@t_Model</a>
														}
													}
													else
													{
														<a target="_blank" style="color: black">@t_Model</a>
													}
												}
											</CellDisplayTemplate>
										</DxGridDataColumn>
										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.idBaoHanh) Caption="B.HÀNH" Width="80" TextAlignment="GridTextAlignment.Right">
											<FilterRowCellTemplate Context="c_BaoHanhList">
												<DxComboBox Value="(int?)c_BaoHanhList.FilterRowValue"
															ValueChanged="(int? v) => c_BaoHanhList.FilterRowValue = v"
															Data=BaoHanhList ValueFieldName="Id" TextFieldName="Baohanh"
															FilteringMode="DataGridFilteringMode.Contains"
															ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
											</FilterRowCellTemplate>
										</DxGridDataColumn>
										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.giathuong) Caption="G.THƯỜNG" Width="100" DisplayFormat="C0" TextAlignment="GridTextAlignment.Right" />
										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.giavon) Caption="GÍA NHẬP" Width="100" DisplayFormat="C0" TextAlignment="GridTextAlignment.Right" />
										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.idvitri) Caption="KHO HÀNG" Width="140" TextAlignment="GridTextAlignment.Right">
											<FilterRowCellTemplate Context="c_ViTriList">
												<DxComboBox Value="(int?)c_ViTriList.FilterRowValue"
															ValueChanged="(int? v) => c_ViTriList.FilterRowValue = v"
															Data=ViTriList ValueFieldName="Id" TextFieldName="Vitri"
															FilteringMode="DataGridFilteringMode.Contains"
															ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
											</FilterRowCellTemplate>
										</DxGridDataColumn>
										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.lastupdate) Caption="CẬP NHẬT" Width="100" TextAlignment="GridTextAlignment.Right" DisplayFormat="dd/MM/yyyy HH:mm:ss">
											<FilterRowCellTemplate Context="c_lastupdate">
												<DxDateEdit Date="(DateTime?)c_lastupdate.FilterRowValue"
															DateChanged="(DateTime? v) => c_lastupdate.FilterRowValue = v"
															ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never" />
											</FilterRowCellTemplate>
										</DxGridDataColumn>
										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.iduserlastupdate) Caption="NGƯỜI UPDATE" Width="150" TextAlignment="GridTextAlignment.Right" SortMode="GridColumnSortMode.DisplayText">
											<FilterRowCellTemplate Context="c_iduserlastupdate">
												<DxComboBox Value="(int?)c_iduserlastupdate.FilterRowValue"
															ValueChanged="(int? v) => c_iduserlastupdate.FilterRowValue = v"
															Data=UserList ValueFieldName="userid" TextFieldName="Fullname"
															FilteringMode="DataGridFilteringMode.Contains"
															ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
											</FilterRowCellTemplate>
										</DxGridDataColumn>
										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.beginupdate) Caption="NGÀY TẠO" Width="100" TextAlignment="GridTextAlignment.Right" DisplayFormat="dd/MM/yyyy HH:mm:ss">
											<FilterRowCellTemplate Context="c_beginupdate">
												<DxDateEdit Date="(DateTime?)c_beginupdate.FilterRowValue"
															DateChanged="(DateTime? v) => c_beginupdate.FilterRowValue = v"
															ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never" />
											</FilterRowCellTemplate>
										</DxGridDataColumn>
										<DxGridDataColumn FieldName=@nameof(MTL_GetAllProductsResult.iduserlastcreate) Caption="NGƯỜI TẠO" Width="150" TextAlignment="GridTextAlignment.Right" SortMode="GridColumnSortMode.DisplayText">
											<FilterRowCellTemplate Context="c_iduserlastcreate">
												<DxComboBox Value="(int?)c_iduserlastcreate.FilterRowValue"
															ValueChanged="(int? v) => c_iduserlastcreate.FilterRowValue = v"
															Data=UserList ValueFieldName="userid" TextFieldName="Fullname"
															FilteringMode="DataGridFilteringMode.Contains"
															ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
											</FilterRowCellTemplate>
										</DxGridDataColumn>
									</Columns>
									<EditFormTemplate Context="EditForm">
										<SpinLoader IsLoading=@IsLoadingSave Spinner="SpinnerType.Chase">
											<LoadingTemplate>
												<Loading />
											</LoadingTemplate>
											<ContentTemplate>
												@{
													mtl_product = (MTL_GetAllProductsResult)EditForm.EditModel;
													if ((MTL_GetAllProductsResult)EditForm.EditModel != null)
													{
														<div class="card-body">
															<DxFormLayout CssClass="w-100">
																<DxFormLayoutItem Caption="" ColSpanSm="12" Context="luu">
																	<DxButton RenderStyle="ButtonRenderStyle.Primary" CssClass="w-100"
																			  Text="LƯU THÔNG TIN" Title="LƯU THÔNG TIN"
																			  SubmitFormOnClick="true"
																			  SizeMode="SizeMode.Large"
																			  Enabled=!IsLoadingAPI
																			  IconCssClass="fas fa-save" />
																</DxFormLayoutItem>
																<DxFormLayoutItem Caption="Loại hình KD :" ColSpanSm="12" BeginRow=true Context="luu">
																	<DxComboBox Data="@LoaiHHDVList_EditForm"
																				NullText="Chọn loại hình KD ..."
																				ShowValidationIcon="true"
																				ValueFieldName="@nameof(TblLoaihanghoadichvu.Id)"
																				TextFieldName="@nameof(TblLoaihanghoadichvu.Loaihanghoadichvu)"
																				@bind-Value=mtl_product.idloaihanghoadichvu
																				Enabled=false />
																</DxFormLayoutItem>
																<DxFormLayoutItem Caption="" ColSpanSm="12" BeginRow=true Context="luu">
																	@{
																		var tenWoo = "WOO - " + @mtl_product.woo_id.ToString();
																	}
																	<DxTabs TabsPosition=TabsPosition.Top ScrollMode="TabsScrollMode.Auto" @bind-ActiveTabIndex="@ActiveTabIndex">
																		<DxTab Text="THÔNG TIN" TabIconCssClass="fas fa-home"></DxTab>
																		<DxTab Text="MÔ TẢ" TabIconCssClass="fas fa-university"></DxTab>
																		<DxTab Text=@tenWoo TabIconCssClass="fab fa-wordpress"></DxTab>
																		<DxTab Text="THÀNH PHẦN" TabIconCssClass="fas fa-vector-square"></DxTab>
																		<DxTab Text="BỔ SUNG" TabIconCssClass="fas fa-vector-square"></DxTab>
																	</DxTabs>
																</DxFormLayoutItem>
																<DxFormLayoutItem Caption="" ColSpanSm="12" BeginRow=true Context="luu">
																	@switch (ActiveTabIndex)
																	{
																		case 0:
																			<DxFormLayout CssClass="w-100">
																				<div class="col-md-4">
																					<div class="row">
																						<div class="col-md-12">
																							<DxFormLayoutItem Caption="" ColSpanMd="12" Context="anh" BeginRow="true">
																								<SpinLoader IsLoading="IsLoadingAPI" Spinner="SpinnerType.Chase">
																									<LoadingTemplate>
																										<Loading />
																									</LoadingTemplate>
																									<ContentTemplate>
																										<p>
																											@{
																												<img src="@image_product" class="img-fluid" />
																											}
																										</p>
																									</ContentTemplate>
																								</SpinLoader>
																							</DxFormLayoutItem>
																						</div>
																					</div>
																				</div>
																				<div class="col-md-8">
																					<DxFormLayoutGroup Caption="THÔNG TIN CƠ BẢN" CssClass="w-100" CaptionCssClass="my-style">
																						<DxFormLayoutItem Context="_nhomhang" Caption="Nhóm hàng:" ColSpanMd="12" BeginRow=true>
																							<DxComboBox Data=@NhomHangParentList CssClass="w-100" Enabled=!IsLoadingAPI
																										@bind-Value="mtl_product.idnhomhang"
																										ValueFieldName="id"
																										TextFieldName="nhomhang"
																										ShowValidationIcon="true"
																										SelectedItemChanged="@((MTL_GetAllNhomHangResult n_hang) => SelectedNhomHangChanged(n_hang))"
																										NullText="Chọn nhóm hàng ...">
																							</DxComboBox>
																						</DxFormLayoutItem>
																						<DxFormLayoutItem Caption="Mã hàng:" ColSpanMd="6" Context="MaHang" BeginRow="true">
																							<DxTextBox NullText="Nhập mã hàng ..." CssClass="w-100"
																									   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
																									   ShowValidationIcon="true" Enabled=!IsLoadingAPI
																									   @bind-Text="mtl_product.masp" />
																						</DxFormLayoutItem>
																						<DxFormLayoutItem Caption="Model:" ColSpanMd="6" Context="Model">
																							<DxTextBox NullText="Nhập Model ..." CssClass="w-100"
																									   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
																									   ShowValidationIcon="true" Enabled=!IsLoadingAPI
																									   Text="@mtl_product.model"
																									   TextExpression="@(() => mtl_product.model)"
																									   TextChanged="@((value) => OnTextChanged_Model(value))" />
																						</DxFormLayoutItem>
																						<DxFormLayoutItem Caption="Tên hàng:" ColSpanMd="12" Context="TenHang" BeginRow="true">
																							<DxTextBox NullText="Nhập tên hàng ..." CssClass="w-100"
																									   ShowValidationIcon="true" Enabled=!IsLoadingAPI
																									   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
																									   @bind-Text="mtl_product.tensp" />
																						</DxFormLayoutItem>
																						<DxFormLayoutItem Caption="Đường dẩn:" ColSpanMd="10" Context="DuongDanTinh">
																							<DxTextBox NullText="Nhập tên đường dẩn ..." ReadOnly=true
																									   style="color:var(--mud-palette-primary); font-weight: bold;"
																									   ShowValidationIcon="true" Enabled=!IsLoadingAPI
																									   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
																									   @bind-Text="mtl_product.link" />
																						</DxFormLayoutItem>
																						<DxFormLayoutItem Caption="" ColSpanMd="2" Context="DuongDanTinh">
																							<DxButton RenderStyle="ButtonRenderStyle.Primary"
																									  Text="Mở" Title="Mở Website" CssClass="w-100"
																									  SizeMode="SizeMode.Medium" Enabled=!IsLoadingAPI
																									  Click="btMoLinkWeb"
																									  IconCssClass="fas fa-globe-europe" />
																						</DxFormLayoutItem>
																						<DxFormLayoutItem Context="_giavon" Caption="Giá nhập:" ColSpanMd="4" BeginRow=true>
																							<DxSpinEdit @bind-Value="mtl_product.giavon"
																										style="color:red; font-weight: bold;"
																										NullText="Nhập giá mua vào ..." Enabled=!IsLoadingAPI
																										ShowValidationIcon="true"
																										DisplayFormat="C0"
																										InputCssClass="spinEditInput" />
																						</DxFormLayoutItem>
																						<DxFormLayoutItem Context="_giaban" Caption="Giá bán:" ColSpanMd="4">
																							<DxSpinEdit @bind-Value="mtl_product.giaban"
																										style="color:red; font-weight: bold;" Enabled=!IsLoadingAPI
																										NullText="Nhập giá bán lẻ ..."
																										ShowValidationIcon="true"
																										DisplayFormat="C0" InputCssClass="spinEditInput" />
																						</DxFormLayoutItem>
																						<DxFormLayoutItem Context="_giathuong" Caption="Giá thường:" ColSpanMd="4">
																							<DxSpinEdit @bind-Value="mtl_product.giathuong" Enabled=!IsLoadingAPI
																										style="color:red; font-weight: bold;"
																										NullText="Nhập giá chưa khuyến mãi ..."
																										ShowValidationIcon="true"
																										DisplayFormat="C0"
																										InputCssClass="spinEditInput" />
																						</DxFormLayoutItem>
																						@{
																							if ((bool)company.IsThuongHieu)
																							{
																								<DxFormLayoutItem Context="_thuonghieu" Caption="Thương hiệu:" ColSpanMd="10" BeginRow=true>
																									<DxComboBox Data=@ThuongHieuList CssClass="w-100"
																												@bind-Value="mtl_product.idthuonghieu" Enabled=!IsLoadingAPI
																												ValueFieldName="id"
																												TextFieldName="thuonghieu"
																												ShowValidationIcon="true"
																												FilteringMode="DataGridFilteringMode.Contains"
																												SelectedItemChanged="@((MTL_GetAllThuongHieuResult t_hieu) => SelectedThuongHieuChanged(t_hieu))"
																												NullText="Chọn thương hiệu ...">
																									</DxComboBox>
