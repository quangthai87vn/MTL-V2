@page "/ContentAPI"
@using Blazored.LocalStorage;
@using Blazored.Toast
@using Blazored.Toast.Services
@using MTL.APP.Models;
@using MTL.APP.Services
@using MTL.APP.Utils
@using Microsoft.Extensions.Options;
@using System.Data;
@using System.Globalization;
@using MudBlazor.Extensions.Options

@inject IJSRuntime JSRuntime
@inject UserService userService
@inject IToastService toastService
@inject ISnackbar SnackbarService
@inject Configs configs
@inject MudBlazor.IDialogService DialogService
@inject WordPressRESTAPI wordPressRESTAPI
@inject ContentService contentService
@attribute [Authorize]

<style>
	.my-style {
		font-weight: bold !important;
		color: #0d6efd;
	}
</style>

<AuthorizeView Context="auth">
	<Authorized>
		<PageStandardHeader Icon="@Icons.Material.Filled.Web" Title="DANH SÁCH BÀI VIẾT TỪ WEB">
			<Actions>
				<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
					<MudSelect T="int" Value="idduan" ValueChanged="DuAnValueChanged"
							   Label="Dự án" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width:200px">
						@foreach (var item in ListDuAn) { <MudSelectItem T="int" Value="@item.Id">@item.Tenduan</MudSelectItem> }
					</MudSelect>
					<MudButton Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.FileDownload" Class="mtl-header-action-btn"
							   Disabled=IsLoading OnClick="ExportXlsx" Color="Color.Error">XUẤT EXCEL</MudButton>
				</MudStack>
			</Actions>
		</PageStandardHeader>

		@if (IsLoading)
		{
			<Loading IsFullPage="true" />
		}
		else
		{
			<MudPaper Elevation="3" Class="rounded-lg overflow-hidden">
				<MudDataGrid T="WordPressRestAPI.Post"
							 Items="@ListPost"
							 Filterable="false"
							 Sortable="true"
							 Hover="true"
							 Striped="true"
							 Bordered="true"
							 Dense="true"
							 RowsPerPage="100"
							 ShowMenuIcon="false"
							 ShowColumnOptions="true"
							 ColumnResizeMode="ResizeMode.Container"
							 Loading="IsLoading"
							 class="MTLGrid">
					<NoRecordsContent><MudText Typo="Typo.body1">Không có bài viết.</MudText></NoRecordsContent>
					<LoadingContent><MudText Typo="Typo.body2">Đang tải dữ liệu...</MudText></LoadingContent>
					<ToolBarContent>
						<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="px-2 py-1" Style="width:100%; min-height:48px;">
							<MudIcon Icon="@Icons.Material.Filled.ViewColumn" Size="Size.Small" Style="opacity:0.85" />
							<MudText Typo="Typo.subtitle2" Style="font-weight:600">Bảng dữ liệu</MudText>
							<MudText Typo="Typo.caption" Class="mud-text-secondary">Ẩn/hiện cột: biểu tượng bên phải</MudText>
							<MudSpacer />
						</MudStack>
					</ToolBarContent>
							<Columns>
								<TemplateColumn T="WordPressRestAPI.Post" Title="ID" HeaderStyle="width:100px;" Filterable="false" Sortable="false">
									<CellTemplate>
										@{ var webUrl = context.Item.link; }
										@if (!string.IsNullOrEmpty(webUrl))
										{
											<a target="_blank" href="@webUrl" style="color: red">@context.Item.id</a>
										}
										else
										{
											<MudText>@context.Item.id</MudText>
										}
									</CellTemplate>
								</TemplateColumn>
								<TemplateColumn T="WordPressRestAPI.Post" Title="TIÊU ĐỀ" Filterable="false" Sortable="false">
									<CellTemplate>
										@{ var rendered = context.Item.title?.rendered; }
										<MudText>@rendered</MudText>
									</CellTemplate>
								</TemplateColumn>
								<PropertyColumn Property="x => x.status" Title="TRẠNG THÁI" HeaderStyle="width:100px;" Filterable="false" />
								<PropertyColumn Property="x => x.date" Title="NGÀY ĐĂNG" HeaderStyle="width:200px;" Filterable="false" Format="dd/MM/yyyy HH:mm:ss" />
							</Columns>
							<NoRecordsContent>
								<MudText Typo="Typo.body1">Không tìm thấy dữ liệu.</MudText>
							</NoRecordsContent>
							<PagerContent>
								<MudText Typo="Typo.body2" Class="pa-2">
									Tổng số: <strong>@(ListPost?.Count ?? 0)</strong> bài viết
								</MudText>
								<MudDataGridPager T="WordPressRestAPI.Post" PageSizeOptions="new int[] { 50, 100, 200 }" />
							</PagerContent>
						</MudDataGrid>
			</MudPaper>
		}
	</Authorized>
</AuthorizeView>

@code {

	UserSession userSession { get; set; }
	MTL.APP.Utils.HandleCommon _HandleCommon = new MTL.APP.Utils.HandleCommon();
	int Sodonghienthi = 100;
	bool IsLoading = true;
	private ToastParameters _toastParameters;
	List<MTL_GetAllUserCompanyResult>? UserList { get; set; }
	List<TimeSheetDuAn>? ListDuAn { get; set; }
	List<WordPressRestAPI.Post>? ListPost { get; set; }
	int idduan = 1;
	TimeSheetDuAn duan { get; set; }

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			IsLoading = true;
			userSession = await configs.LoadAllConfig();
			ListDuAn = await contentService.GetAllDuAnAsync();
			if (userSession.company.IsActiveApi)
			{
				await FilterDataList();
			}
			IsLoading = false;
			StateHasChanged();
		}
		await base.OnAfterRenderAsync(firstRender);
	}

	async Task FilterDataList()
	{
		duan = ListDuAn.Where(p => p.Id == idduan).FirstOrDefault();
		ListPost = await wordPressRESTAPI.GetPostsAsync(duan.Url, duan.Username, duan.Password);
		await SearchSanPham();
	}

	async Task ExportXlsx()
	{
		if (ListPost == null || !ListPost.Any())
		{
			SnackbarService.Add("Không có dữ liệu để xuất.", Severity.Warning);
			return;
		}
		var exportData = ListPost.Select(p => new
		{
			p.id,
			TieuDe = p.title?.rendered,
			p.status,
			p.date
		}).ToList();
		await JSRuntime.InvokeVoidAsync("exportToExcel",
			"DanhSachNoiDung",
			new[] { "ID", "Tiêu đề", "Trạng thái", "Ngày đăng" },
			exportData.Select(e => new object[] { e.id, e.TieuDe, e.status, e.date }).ToList()
		);
	}

	async Task SearchSanPham()
	{
	}

	async Task DuAnValueChanged(int newValue)
	{
		idduan = newValue;
		IsLoading = true;
		await FilterDataList();
		IsLoading = false;
	}
}
