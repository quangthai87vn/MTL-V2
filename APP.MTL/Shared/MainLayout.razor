@using MTL.APP.Authentication
@using System.Security.Claims
@using MTL.APP.Models
@using MTL.APP.Services
@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider authStateProvider
@inject IJSRuntime js
@inject ProtectedLocalStorage ProtectedLocalStorage
@inject UserService userService
@inject AppThemeService AppTheme

@* MudBlazor 7: MudThemeProvider không nhận ChildContent — đặt cùng cấp với các provider khác *@
<MudThemeProvider Theme="@_mudTheme" IsDarkMode="@_isDark" IsDarkModeChanged="@OnDarkModeChangedHandler" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="mtl-theme-root @(_isDark ? "mtl-dark" : null)" data-mtl-theme="@AppTheme.ThemeId">
	<MudLayout>
			<MudAppBar Elevation="4" Dense="false" Color="Color.Primary" Fixed="true"
					   Class="mtl-appbar-gradient"
					   Style="z-index: 300; position: fixed; top: 0; left: 0; right: 0;">
				@* XS: menu trái → brand; SM+: dashboard → brand → menu ngang *@
				<MudHidden Breakpoint="Breakpoint.SmAndUp">
					<NavMenu MobileOnly="true" />
				</MudHidden>
				@* SM+: nút tổng quan; XS: ẩn (đã có trong drawer menu) *@
				<MudHidden Breakpoint="Breakpoint.Xs">
					<MudIconButton Icon="@Icons.Material.Filled.Dashboard" Color="Color.Inherit"
								   Title="Trang tổng quan" OnClick="@(() => navigationManager.NavigateTo("/", true))" />
				</MudHidden>
				<MudText Typo="Typo.h6" Class="ml-2 mr-2 mtl-appbar-brand" Style="font-weight:800; letter-spacing:0.05em; color:white">
					@Welcome
				</MudText>

				<MudHidden Breakpoint="Breakpoint.Xs">
					<NavMenu DesktopOnly="true" />
				</MudHidden>

				<MudSpacer />

				<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
					<MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
						<ActivatorContent>
							<MudIconButton Icon="@Icons.Material.Filled.Palette"
										   Color="Color.Inherit" Title="Giao diện" />
						</ActivatorContent>
						<ChildContent>
							<MudText Typo="Typo.caption" Class="px-4 py-2" Style="opacity:0.8">Chọn theme</MudText>
							<MudDivider />
							@foreach (var opt in AppThemeCatalog.Options)
							{
								var id = opt.Id;
								var swatch = opt.SwatchHex;
								<MudMenuItem OnClick="@(() => ApplyThemeAsync(id))" Class="mtl-theme-menu-item">
									<div class="d-flex align-center" style="gap:12px; min-width:220px; max-width:min(92vw,320px);">
										<div class="mtl-theme-menu-item__icon" style="width:22px; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
											@if (AppTheme.ThemeId == id)
											{
												<MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Primary" Size="Size.Small" />
											}
											else
											{
												<span class="mtl-theme-swatch-dot" style="background:@swatch" title="@opt.Label"></span>
											}
										</div>
										<MudText Typo="Typo.body2" Style="flex:1;">@opt.Label</MudText>
									</div>
								</MudMenuItem>
							}
						</ChildContent>
					</MudMenu>

					<MudDivider Vertical="true" FlexItem="true" DividerType="DividerType.Middle" Style="height:28px; opacity:0.5" />
					<MudMenu AnchorOrigin="Origin.BottomRight"
							 TransformOrigin="Origin.TopRight"
							 PopoverClass="mtl-user-menu-popover"
							 Dense="true">
						<ActivatorContent>
							<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Class="mtl-appbar-user-activator">
								<MudChip T="string" Icon="@Icons.Material.Filled.Person"
										 Class="mtl-appbar-user-chip"
										 Color="Color.Inherit"
										 Style="background:rgba(255,255,255,0.2); color:white; font-weight:600; cursor:pointer; max-width:min(38vw,200px)"
										 Text="@TenUser" />
								<MudIconButton Icon="@Icons.Material.Filled.Person" Color="Color.Inherit"
											   Class="mtl-appbar-user-icon-only"
											   Title="@TenUser"
											   Style="color:white" />
							</MudStack>
						</ActivatorContent>
						<ChildContent>
							<MudMenuItem Icon="@Icons.Material.Filled.AccountBox" Class="mtl-user-menu-item"
										 OnClick="@(() => navigationManager.NavigateTo("/profile", true))">
								TÀI KHOẢN
							</MudMenuItem>
							<MudDivider Class="my-0" />
							<MudMenuItem Icon="@Icons.Material.Filled.Logout" Class="mtl-user-menu-item"
										 OnTouch="@Logout" OnClick="@Logout">
								ĐĂNG XUẤT
							</MudMenuItem>
						</ChildContent>
					</MudMenu>
				</MudStack>
			</MudAppBar>

			<MudMainContent Class="px-0 mtl-main-with-fixed-footer">
				<AuthorizeView>
					<Authorized>
						<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4 px-3 mtl-main-container-tight-xs">
							@Body
						</MudContainer>
					</Authorized>
					<NotAuthorized>
						@{
							navigationManager.NavigateTo("/login");
						}
					</NotAuthorized>
				</AuthorizeView>
			</MudMainContent>

			<MudAppBar Bottom="true" Top="false" Elevation="2" Dense="true" Fixed="true"
					   Color="Color.Dark" Class="mtl-footer-appbar" Style="z-index: 300; position: fixed; bottom: 0; left: 0; right: 0;">
				<MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Style="width:100%; min-height:100%">
					<MudText Typo="Typo.caption" Class="mtl-footer-copyright" Style="color:#9e9e9e; text-align:center">
						&copy; @DateTime.Now.Year @Welcome — Thiết kế &amp; phát triển bởi MTL TECHNOLOGY
					</MudText>
				</MudStack>
			</MudAppBar>
	</MudLayout>
</div>

<style>
	/* Footer AppBar cố định (Dense): chừa khoảng trống để nội dung không bị che khi cuộn */
	.mtl-theme-root {
		--mtl-footer-appbar-height: 48px;
		--mtl-footer-safe-gap: 12px;
	}

	.mtl-theme-root .mtl-main-with-fixed-footer.mud-main-content {
		padding-bottom: calc(var(--mtl-footer-appbar-height) + var(--mtl-footer-safe-gap) + env(safe-area-inset-bottom, 0px)) !important;
		min-height: calc(100vh - 64px - var(--mtl-footer-appbar-height) - var(--mtl-footer-safe-gap)) !important;
	}

	.mud-main-content {
		min-height: calc(100vh - 128px) !important;
	}

	.crm-menu-item:hover {
		background: rgba(255, 255, 255, 0.12) !important;
		border-radius: 6px;
	}

	.crm-menu-item.active {
		background: rgba(255, 255, 255, 0.2) !important;
		border-radius: 6px;
		border-bottom: 3px solid white;
	}

	.mtl-theme-root.mtl-dark .mtl-footer-appbar {
		background: #161b22 !important;
	}

	.mtl-user-menu-popover {
		border-radius: 10px !important;
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.18) !important;
		border: 1px solid rgba(0, 0, 0, 0.08) !important;
		overflow: hidden;
		margin-top: 6px !important;
	}

	.mtl-user-menu-item {
		min-height: 44px !important;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.mtl-theme-swatch-dot {
		display: block;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.14);
	}

	.mtl-theme-menu-item.mud-menu-item {
		padding-top: 8px !important;
		padding-bottom: 8px !important;
	}

</style>

@code {

	[CascadingParameter]
	public Task<AuthenticationState>? authenticationState { get; set; }

	MudTheme _mudTheme = AppThemeCatalog.GetMudTheme(AppThemeCatalog.CrmRed);
	bool _isDark;

	ClaimsPrincipal? user;
	string Welcome = "MTL CRM";
	string TenUser = "User";
	Company company { get; set; } = new();
	UserSession userSession { get; set; } = new();

	protected override void OnInitialized()
	{
		_mudTheme = AppTheme.CurrentMudTheme;
		_isDark = AppTheme.IsDarkMode;
		AppTheme.ThemeChanged += OnAppThemeChanged;
	}

	protected override async Task OnInitializedAsync()
	{
		if (authenticationState is not null)
		{
			var authState = await authenticationState;
			var u = authState?.User;
			if (u?.Identity is not null && u.Identity.IsAuthenticated)
			{
				await LoadAllConfig();
				Welcome = company?.Name?.ToUpperInvariant() ?? "MTL CRM";
				TenUser = userSession?.user?.Fullname ?? "User";
			}
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await AppTheme.InitializeAsync();
			SyncThemeFromService();
			StateHasChanged();
		}
	}

	void OnAppThemeChanged()
	{
		SyncThemeFromService();
		StateHasChanged();
	}

	void SyncThemeFromService()
	{
		_mudTheme = AppTheme.CurrentMudTheme;
		_isDark = AppTheme.IsDarkMode;
	}

	Task OnDarkModeChangedHandler(bool isDark)
	{
		_isDark = isDark;
		return Task.CompletedTask;
	}

	async Task ApplyThemeAsync(string id)
	{
		await AppTheme.SetThemeAsync(id);
	}

	async Task LoadAllConfig()
	{
		try
		{
			var CompanyStorageResult = await ProtectedLocalStorage.GetAsync<Company>("Company");
			if (CompanyStorageResult.Success && CompanyStorageResult.Value != null)
				company = CompanyStorageResult.Value;

			var UserSessionStorageResult = await ProtectedLocalStorage.GetAsync<UserSession>("UserSession");
			if (UserSessionStorageResult.Success && UserSessionStorageResult.Value != null)
				userSession = UserSessionStorageResult.Value;
		}
		catch { }
	}

	private async Task Logout()
	{
		var customAuthStateProvider = (CustomAuthenticationStateProvider)authStateProvider;
		await customAuthStateProvider.UpdateAuthenticationState(null);
		navigationManager.NavigateTo("/login", true);
	}

	public void Dispose()
	{
		AppTheme.ThemeChanged -= OnAppThemeChanged;
	}
}
