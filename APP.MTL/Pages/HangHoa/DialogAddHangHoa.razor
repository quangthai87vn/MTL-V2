	async Task<bool> SaveHangHoa(bool isCreateContentAuto)
	{
		try
		{
			bool val_return = false;
			IsLoadingSave = true;
			await Task.Delay(5);
			MTL.APP.WooRestAPI.Product reurn_product = new APP.WooRestAPI.Product();
			bool isUpdate = false;
			if (isNew)
			{
				isUpdate = false;
				model = this.GetData(model, isNew);
				if (userSession.company.IsActiveApi)
				{
					if (model.WooId != null && model.WooId != 0) // chọn WooID có sẳn, ko tạo WooID mới
					{
						model.WooId = model.WooId;
						model.Link = model.Link;
					}
					else
					{
						reurn_product = await SaveWoocommerce(isUpdate,isCreateContentAuto);
						model.WooId = int.Parse(reurn_product.id);
						model.Link = reurn_product.permalink;
						model.WooSlug = reurn_product.slug;

					

					}
				}
				model = await hangHoaService.CreateProductAsync(model);//.SaveAsync("Product/CreateProduct", edit_sanpham);
				string mess = $"Tạo thành công hàng hóa [{model.Tensp}] ";
				_HandleCommon.OpenSusscessSnackbarDialog(SnackbarService, mess);
			}
			else
			{
				isUpdate = true;
				model = this.GetData(model, isNew);
				if (userSession.company.IsActiveApi)
				{
					reurn_product = await SaveWoocommerce(isUpdate, isCreateContentAuto);
					if (reurn_product.id != null)
					{
						model.WooId = int.Parse(reurn_product.id);
						model.WooSlug = reurn_product.slug;
						model.Link = reurn_product.permalink;

						if (reurn_product.images.Count > 0)
							model.Hinhanh1 = reurn_product.images[0].src.ToString();
					}
				}
				int id = model.Id;
				model = await hangHoaService.UpdateProductAsync(model);
				bool result = await hangHoaService.SaveHangHoaThanhPhanAsync(ListHangHoaThanhPhan, model.Id);

				string mess = $"Cập nhật thành công hàng hóa [{model.Tensp}]";
				_HandleCommon.OpenSusscessSnackbarDialog(SnackbarService, mess);
			}
			IsLoadingSave = false;
			return true;
		}
		catch (Exception)
		{
			IsLoadingSave = false;
			return false;
		}
	}


