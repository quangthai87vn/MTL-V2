	static readonly HashSet<string> _pendingUrls = new();

	/// <summary>Preload ảnh: gọi khi user hover hoặc scroll vào viewport.</summary>
	async Task PreloadImageAsync(string? url)
	{
		if (string.IsNullOrWhiteSpace(url) || _urlImageCache.ContainsKey(url) || _pendingUrls.Contains(url))
			return;
		_pendingUrls.Add(url);
		try
		{
			var jsResult = await JSRuntime.InvokeAsync<ImageCacheResult>("MTLImageCache.cacheImage", url, "");
			if (jsResult.data != null)
			{
				_urlImageCache[url] = jsResult.data;
				StateHasChanged();
			}
		}
		catch { }
		finally
		{
			_pendingUrls.Remove(url);
		}
	}

