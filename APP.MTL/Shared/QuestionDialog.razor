@inject ISnackbar SnackbarService
@attribute [Authorize]
<MudDialog Class="blur dialog-background"
		   TitleClass="blur dialog-background-title"
		   ContentClass="dialog-background-surface pa-4"
		   ActionsClass="dialog-background-surface">
	<DialogContent>
		<MudGrid Spacing=1>
			<MudItem xs="12" sm="12" md="12">
				<img class="mx-auto d-block" src=@UrlAnhThaoTac width="80" />
			</MudItem>
			<MudItem xs="12" sm="12" md="12">
				<MudText Typo="Typo.h5" Class="mtl-dialog-confirm-title">@TieuDeLon</MudText>
			</MudItem>
			<MudItem xs="12" sm="12" md="12">
				<MudText Typo="Typo.h6" Class="mtl-dialog-confirm-subtitle">@NoiDung</MudText>
			</MudItem>
			<MudItem xs="12" sm="12" md="12">
				<img class="mx-auto d-block" src=@LinkAnh width="150" />
			</MudItem>
			<MudItem xs="12" sm="12" md="12">
				<MudText Typo="Typo.body2" Class="mtl-dialog-confirm-hint">@TieuDeNho</MudText>
			</MudItem>
		</MudGrid>
	</DialogContent>
	<DialogActions>
		<div class="dlg-footer">
			<MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Check"
					   OnClick="OnConfirmClick" Color="Color.Success">ĐỒNG Ý</MudButton>
			<div class="dlg-footer__spacer"></div>
			<MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close"
					   OnClick="OnCancelClick" Color="Color.Error">HỦY BỎ</MudButton>
		</div>
	</DialogActions>
</MudDialog>

@code {
	[CascadingParameter] MudDialogInstance MudDialog { get; set; }
	[Parameter]
	public string NoiDung { get; set; }
	[Parameter]
	public string TieuDeLon { get; set; }
	[Parameter]
	public string TieuDeNho { get; set; }
	[Parameter]
	public string UrlAnhThaoTac { get; set; }
	[Parameter]
	public bool Visible { get; set; }
	[Parameter]
	public string LinkAnh { get; set; }
	[Parameter]
	public EventCallback<string> OnDeleteCallback { get; set; }

	async Task OnConfirmClick()
	{
		try
		{
			MudDialog.Close(DialogResult.Ok(true));
		}
		catch (Exception)
		{
		}
	}
	void OnCancelClick()
	{
		MudDialog.Cancel();
	}

}
