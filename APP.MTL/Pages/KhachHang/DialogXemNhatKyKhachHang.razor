@using MTL.APP.Models
@using MTL.APP.Services
@inject ISnackbar SnackbarService
@inject IJSRuntime JSRuntime
@inject KhachHangService khachHangService
@attribute [Authorize]
<MudDialog Class="blur dialog-background"
		   TitleClass="blur dialog-background-title"
		   ContentClass="dialog-background-surface pa-4"
		   ActionsClass="dialog-background-surface mtl-themdon-dialog-actions">
	<DialogContent>
		@if (IsLoading)
		{
			<Loading IsFullPage="false" HideText="true" />
		}
		else
		{
			<MudPaper Class="pa-4">
				<MudGrid Spacing=1>
					<MudItem xs="12" sm="12" md="12">
						<MudTable Items="@ListAllGhiChuKhachHang"
							Hover="true"
							Striped="true"
							Bordered="false"
							RowsPerPage="50"
							Class="mudtable-center-header">
							<HeaderContent>
								<MudTh Style="width:120px; text-align:center;">NGÀY G.CHÚ</MudTh>									
								<MudTh Style="width:300px; text-align:center;">KHÁCH HÀNG</MudTh>
								<MudTh>NỘI DUNG</MudTh>
							</HeaderContent>
							<RowTemplate Context="contextGhiChu">
								<MudTd DataLabel="NGÀY G.CHÚ">
									@Convert.ToDateTime(contextGhiChu.Ngayghichu).ToString("dd/MM/yyyy")										
								</MudTd>
								<MudTd DataLabel="KHÁCH HÀNG">
									@ListKhachHang.Where(p => p.Id == (int)@contextGhiChu.Idkhachhang).FirstOrDefault().Fullname - @ListKhachHang.Where(p => p.Id == (int)@contextGhiChu.Idkhachhang).FirstOrDefault().Dienthoai 
									<MudExGradientText Animate="false" Typo="Typo.h6" style="text-align:left">@LoaiChamSocKhachHang.Where(p => p.Id == (int)@contextGhiChu.Idghichu).FirstOrDefault().Loaichamsoc</MudExGradientText>
								</MudTd>
								<MudTd DataLabel="NỘI DUNG">
									@contextGhiChu.Noidung
								</MudTd>
							</RowTemplate>
							<FooterContent>
								<MudTd ColSpan="2" Class="mtl-dialog-confirm-title" Style="text-align:right;">Số ghi chú: @ListAllGhiChuKhachHang.Count</MudTd>
							</FooterContent>
							<PagerContent>
								<MudTablePager PageSizeOptions="new int[] { 50, 100 }" />
							</PagerContent>
						</MudTable>
					</MudItem>
				</MudGrid>
			</MudPaper>
		}
	</DialogContent>
	<DialogActions>
		<div class="dlg-footer">
			<div class="dlg-footer__spacer"></div>
			<MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close"
					   OnClick="OnCancelDeleteClick" Color="Color.Error">HỦY BỎ</MudButton>
		</div>
	</DialogActions>
</MudDialog>

@code {
	[CascadingParameter] MudDialogInstance MudDialog { get; set; }

	[Parameter]
	public List<TblUser>? ListKhachHang { get; set; }
	bool IsLoading = false;
	

	public List<TblKhachHangGhiChu> ListAllGhiChuKhachHang { get; set; }
	public List<TblLoaiChamSocKh> LoaiChamSocKhachHang { get; set; }


	protected override async Task OnInitializedAsync()
	{
		try
		{
			IsLoading = true;
			LoaiChamSocKhachHang = await khachHangService.GetAllLoaiChamSocKhachHangAsync();
			// string NgayHD = ((DateTime)NgayHoaDon).ToString("dd/MM/yyyy");
			// khachhangghichu.Noidung = $"Mỹ Tho Laptop xin chào {KhachHang.Fullname}. Máy tính của Anh/Chị đã mua ngày {NgayHD} đến nay đã khá lâu.Anh/Chị nên mang máy đến shop tiến hành vệ sinh lại đồng thời kiểm tra miễn phí để máy hoạt động ổn định hơn. Vui lòng giữ lại tin nhắn này để được giảm giá 20 % khi thanh toán tại Mỹ Tho Laptop. Xin cám ơn! ";
			// khachhangghichu.Idkhachhang = KhachHang.Id;
			// khachhangghichu.Idghichu = 1;
			// khachhangghichu.Ngayghichu = (DateTime?)(DateTime.Now);
			// ThongTinKhachHang = $"{KhachHang.Fullname} - {KhachHang.Dienthoai}";
			ListAllGhiChuKhachHang = await khachHangService.GetAllGhiChuKhachHangAsync();
			IsLoading = false;
		}
		catch (Exception)
		{
			IsLoading = false;
		}
	}

	void OnCancelDeleteClick()
	{
		MudDialog.Cancel();
	}





}
