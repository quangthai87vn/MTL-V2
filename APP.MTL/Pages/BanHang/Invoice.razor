@page "/invoice"
@using Blazored.LocalStorage;
@using Blazored.Toast
@using Blazored.Toast.Services
@using MTL.APP.Models;
@using System.Collections;
@using MTL.APP.Services
@using MTL.APP.Utils
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor.Extensions.Options
@using MudBlazor.Services
@inject IJSRuntime JSRuntime
@inject InvoiceService invoiceService
@inject NavigationManager NavigationManager
@inject KhachHangService khachHangService
@inject HangHoaService hangHoaService
@inject UserService userService
@inject Configs configs
@inject ISnackbar SnackbarService
@inject MudBlazor.IDialogService DialogService
@attribute [Authorize]

<AuthorizeView>
	<Authorized>
		<MudDrawerContainer Class="mud-height-full">
			<MudDrawer Width="320px" @bind-Open="@open" Fixed="true" Elevation="24"
					   Style="background-color:var(--mud-palette-surface);position:fixed;top:64px;"
					   Variant="@DrawerVariant.Temporary" DisableOverlay="true"
					   Anchor="Anchor.End">
				<MudDrawerHeader Class="px-4 py-3" Style="border-bottom:1px solid var(--mud-palette-lines-default);">
					<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width:100%;">
						<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
							<MudIcon Icon="@Icons.Material.Filled.FilterList" Color="Color.Primary" Size="Size.Medium" />
							<MudText Typo="Typo.h6" Style="font-weight:700;" Class="ma-0">BỘ LỌC HÓA ĐƠN</MudText>
						</MudStack>
						<MudIconButton OnClick="@ToggleDrawer"
									   Icon="@Icons.Material.Filled.Close" Variant="Variant.Filled"
									   Color="Color.Default" Size="Size.Small" />
					</MudStack>
				</MudDrawerHeader>
				<MudContainer MaxWidth="MaxWidth.False" Class="pa-3">
					@* Nhóm 1: Thời gian *@
					<MudPaper Elevation="0" Class="mb-3 rounded-lg" Style="border:1px solid var(--mud-palette-lines-default);">
						<MudStack Spacing="1" Class="pa-3">
							<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
								<MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Primary" />
								<MudText Typo="Typo.subtitle2" Style="font-weight:600;" Class="ma-0">THỜI GIAN</MudText>
							</MudStack>
							<MudSelect FullWidth="true" Label="Lọc theo" T="string"
									   Value="_filter.v_theongay" Disabled="IsLoading"
									   ValueChanged="ValueChangedHandler_Day"
									   AnchorOrigin="Origin.BottomCenter" Required="true">
								@foreach (var item in s_theongay)
								{
									<MudSelectItem T="string" Value="@item">@item</MudSelectItem>
								}
							</MudSelect>
							<MudSwitch Value="@isLocNgay" Disabled="IsLoading" Label="Chọn khoảng ngày"
									   ValueChanged="LocNgay_CheckedChanged" T="bool" Color="Color.Primary" />
							<MudGrid Spacing="1" Class="mt-1">
								<MudItem xs="6">
									<MudDatePicker Label="Từ ngày" Date="@_TuNgay" DateChanged="(e => OnDateChanged(e, true))" OpenTo="OpenTo.Year"
												  ReadOnly="IsLoading" Disabled="!isLocNgay" />
								</MudItem>
								<MudItem xs="6">
									<MudDatePicker Label="Đến ngày" Date="@_DenNgay" DateChanged="(e => OnDateChanged(e, false))" OpenTo="OpenTo.Year"
												  ReadOnly="IsLoading" Disabled="!isLocNgay" />
								</MudItem>
							</MudGrid>
						</MudStack>
					</MudPaper>

					@* Nhóm 2: Loại phiếu & Tình trạng *@
					<MudPaper Elevation="0" Class="mb-3 rounded-lg" Style="border:1px solid var(--mud-palette-lines-default);">
						<MudStack Spacing="1" Class="pa-3">
							<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
								<MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" Color="Color.Warning" />
								<MudText Typo="Typo.subtitle2" Style="font-weight:600;" Class="ma-0">LOẠI PHIẾU & TRẠNG THÁI</MudText>
							</MudStack>
							<MudSelect Label="Loại phiếu" T="int"
									   Value="_filter.v_loaiphieu" Disabled="IsLoading"
									   ValueChanged="ValueChangedHandler_LoaiPhieu"
									   AnchorOrigin="Origin.BottomCenter" Required="true">
								@foreach (var item in MTLEnum.GetListLoaiPhieu())
								{
									<MudSelectItem T="int" Value="@item.Id">@item.Loaiphieu</MudSelectItem>
								}
							</MudSelect>
							<MudSelect Label="Tình trạng" T="string"
									   Value="_filter.v_dichvuxuly" Disabled="IsLoading"
									   ValueChanged="ValueChangedHandler_TinhTrangDichVu"
									   AnchorOrigin="Origin.BottomCenter" Required="true">
								@foreach (var item in s_dichvuxuly)
								{
									<MudSelectItem T="string" Value="@item">@item</MudSelectItem>
								}
							</MudSelect>
							<MudSwitch Value="@isHienCongNo" Disabled="IsLoading" Label="Hiển thị công nợ"
									   ValueChanged="HienCongNo_CheckedChanged" T="bool" Color="Color.Warning" />
						</MudStack>
					</MudPaper>

					@* Nhóm 3: Tags & Hiển thị *@
					<MudPaper Elevation="0" Class="mb-3 rounded-lg" Style="border:1px solid var(--mud-palette-lines-default);">
						<MudStack Spacing="1" Class="pa-3">
							<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
								<MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" Color="Color.Info" />
								<MudText Typo="Typo.subtitle2" Style="font-weight:600;" Class="ma-0">TAGS & HIỂN THỊ</MudText>
							</MudStack>
							<MudExChipSelect Label="Lọc theo thẻ"
											 ChipSize="Size.Medium"
											 SearchBoxAutoFocus="true"
											 AvailableItems="@ListTag" SelectedValues="SelectedTag"
											 T="MTL.APP.Models.Tag"
											 Adornment="Adornment.Start"
											 AdornmentIcon="@Icons.Material.Filled.FilterList"
											 SelectedValuesChanged="TagsValueChanged"
											 ToStringFunc="@(e=> e==null?null : $"{e.Name}")" />
							<MudSelect FullWidth="true" Label="Số dòng mỗi trang" T="int" Disabled="IsLoading"
									   Value="_filter.v_sodong" ValueChanged="ValueChangedHandler_SoDong"
									   AnchorOrigin="Origin.BottomCenter" Required="true">
								@foreach (var item in s_sodong)
								{
									<MudSelectItem T="int" Value="@item">@item dòng</MudSelectItem>
								}
							</MudSelect>
						</MudStack>
					</MudPaper>

					@* Nút đặt lại *@
					<MudStack Row="true" Justify="Justify.Center" Spacing="2">
						<MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RestartAlt"
								   OnClick="ResetFilters" Color="Color.Default" FullWidth="true">
							ĐẶT LẠI
						</MudButton>
					</MudStack>
				</MudContainer>
			</MudDrawer>
		</MudDrawerContainer>

		<div class="card-body">
			<PageStandardHeader Icon="@Icons.Material.Filled.ReceiptLong" Title="HÓA ĐƠN">
				<Actions>
					<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
						<MudButton Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" Class="mtl-header-action-btn"
								   Disabled="IsLoading" OnClick="@(() => ThemHoaDonDialog(2))" Color="Color.Primary">HÓA ĐƠN</MudButton>
						<MudButton Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.ElectricalServices" Class="mtl-header-action-btn"
								   Disabled="IsLoading" OnClick="@(() => ThemHoaDonDialog(3))" Color="Color.Primary">DỊCH VỤ</MudButton>
						<MudButton Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList" Class="mtl-header-action-btn"
								   Disabled="IsLoading" OnClick="@ToggleDrawer" Color="Color.Success">BỘ LỌC</MudButton>
						<MudButton Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.TableView" Class="mtl-header-action-btn"
								   Disabled="IsLoading" OnClick="@ExportExcel" Color="Color.Tertiary">EXCEL</MudButton>
					</MudStack>
				</Actions>
				<ChildContent>
					<MudTextField Value="@searchString" Placeholder="Gõ nội dung cần tìm..." Adornment="Adornment.Start"
								  Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" FullWidth="true"
								  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mtl-page-header-search"
								  ValueChanged="EventCallback.Factory.Create<string>(this, OnSearchChanged)" />
				</ChildContent>
			</PageStandardHeader>

			<MudPaper Elevation="3" Class="rounded-lg overflow-hidden mb-3">
			@if (IsLoading)
			{
				<Loading IsFullPage="false" PageName="HÓA ĐƠN" />
			}
			else
			{
				<MudDivider Class="mud-width-full" />
				<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Stretch" Justify="Justify.Center"
							  Class="pa-2 mtl-invoice-tab-bar"
							  Style="flex-wrap:wrap; gap:8px; border-bottom:1px solid var(--mud-palette-lines-default);">
						<MudButton Variant="@(_invoiceTabIndex == 0 ? Variant.Filled : Variant.Outlined)"
								   Color="Color.Info"
								   StartIcon="@Icons.Material.Filled.Description"
								   OnClick="@(() => SetInvoiceTab(0))">
							BÁO GIÁ (@_baoGiaData.Count)
						</MudButton>
						<MudButton Variant="@(_invoiceTabIndex == 1 ? Variant.Filled : Variant.Outlined)"
								   Color="Color.Warning"
								   StartIcon="@Icons.Material.Filled.WarningAmber"
								   OnClick="@(() => SetInvoiceTab(1))">
							CHƯA XỬ LÝ (@_chuaXuLyData.Count)
						</MudButton>
						<MudButton Variant="@(_invoiceTabIndex == 2 ? Variant.Filled : Variant.Outlined)"
								   Color="Color.Success"
								   StartIcon="@Icons.Material.Filled.CheckCircle"
								   OnClick="@(() => SetInvoiceTab(2))">
							ĐÃ XỬ LÝ (@_daXuLyData.Count)
						</MudButton>
					</MudStack>
					<MudTable Items="@ActiveInvoiceTabData"
							  Hover="true"
							  Striped="true"
							  Bordered="true"
							  Dense="true"
							  RowsPerPage="50"
							  HorizontalScrollbar="true"
							  Loading="false"
							  LoadingProgressColor="Color.Primary"
							  RowClassFunc="@InvoiceRowClassFunc"
							  Class="mudtable-center-header mtl-standard-grid mtl-invoice-table mtl-hide-table-toolbar-xs mtl-invoice-master-table">
						<ToolBarContent>
							<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="px-2 py-1" Style="width:100%; min-height:48px;">
								<MudIcon Icon="@Icons.Material.Filled.ViewColumn" Size="Size.Small" Style="opacity:0.85" />
								<MudText Typo="Typo.subtitle2" Style="font-weight:600">@ActiveInvoiceTabTitle</MudText>
								<MudText Typo="Typo.caption" Class="mud-text-secondary">(@ActiveInvoiceTabData.Count() hóa đơn) — bấm mũi tên để xem chi tiết và dòng hàng</MudText>
								<MudSpacer />
							</MudStack>
						</ToolBarContent>
						<HeaderContent>
							<MudTh Style="width:44px; min-width:44px; text-align:center;" Class="mud-text-secondary">
								<MudIcon Icon="@Icons.Material.Filled.UnfoldMore" Size="Size.Small" title="Mở chi tiết" />
							</MudTh>
							<MudTh Class="mtl-invoice-th-actions" Style="width:200px; min-width:160px; text-align:center;">THAO TÁC</MudTh>
							<MudTh Style="width:220px; min-width:180px; text-align:center;">KHÁCH HÀNG</MudTh>
							<MudTh Style="width:100px; min-width:100px; text-align:center;"><MudTableSortLabel SortBy="new Func<MTL_GetAllInvoiceResult, object>(x => x.ngaylapphieu)">N.LẬP</MudTableSortLabel></MudTh>
							<MudTh Style="width:100px; min-width:100px; text-align:center;"><MudTableSortLabel SortBy="new Func<MTL_GetAllInvoiceResult, object>(x => x.ngaytraphieu)">N.HĐ</MudTableSortLabel></MudTh>
							<MudTh Style="text-align:center;">ĐƠN HÀNG</MudTh>
							<MudTh Style="width:160px; min-width:130px; text-align:right;"><MudTableSortLabel SortBy="new Func<MTL_GetAllInvoiceResult, object>(x => x.thanhtoan)">T.TOÁN</MudTableSortLabel></MudTh>
						</HeaderContent>
						<RowTemplate Context="inv">
							@{
								var rowStyle = GetRowStyle(inv);
								var maHd = inv.mahd ?? "";
							}
							<MudTd DataLabel="MỞ RỘNG" Style="@rowStyle" Class="mtl-invoice-td-expand">
								<MudIconButton Icon="@(IsInvoiceExpanded(maHd) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
											   Color="Color.Default"
											   Size="Size.Small"
											   title="@(IsInvoiceExpanded(maHd) ? "Thu gọn" : "Xem chi tiết")"
											   OnClick="@(() => ToggleInvoiceExpand(maHd))" />
							</MudTd>
							<MudTd DataLabel="THAO TÁC" Style="@rowStyle" Class="mtl-invoice-td-actions">
								<MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center" Class="mtl-invoice-action-compact">
									<MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" OverrideStyles="false">
										<MudIconButton Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" title="Sửa"
													   OnClick="@(() => SuaHoaDonDialog(inv))" />
										<MudIconButton Icon="@Icons.Material.Filled.Delete" Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" title="Xóa"
													   OnClick="@(() => XoaHoaDonDialog(inv))" />
										<MudIconButton Icon="@Icons.Material.Filled.CopyAll" Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" title="Sao chép"
													   OnClick="@(() => SaoChepDonDialog(inv))" />
									</MudButtonGroup>
									<MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
										<ActivatorContent>
											<MudIconButton Icon="@Icons.Material.Filled.MoreVert" Variant="Variant.Filled" Color="Color.Default" Size="Size.Small" title="In &amp; khác" />
										</ActivatorContent>
										<ChildContent>
											<MudMenuItem Icon="@Icons.Material.Filled.Print" Href="@($"/HoaDon/A4/{maHd}")" Target="_blank">In A4</MudMenuItem>
											<MudMenuItem Icon="@Icons.Material.Filled.Receipt" Href="@($"/HoaDon/BILL/{maHd}")" Target="_blank">In bill</MudMenuItem>
											<MudMenuItem Icon="@Icons.Material.Filled.NoteAdd" OnClick="@(() => ThemNhatKyKhachHangDialog(inv))">Nhật ký (NOTE)</MudMenuItem>
											<MudMenuItem Icon="@Icons.Material.Filled.Send" OnClick="@(() => AddZNSDialog(inv))">Gửi ZNS</MudMenuItem>
										</ChildContent>
									</MudMenu>
								</MudStack>
							</MudTd>
							<MudTd DataLabel="KHÁCH HÀNG" Style="@rowStyle" Class="mtl-invoice-td-customer">
								<div class="mtl-invoice-customer-row">
									<div class="mtl-invoice-customer-main">
										<MudText Typo="Typo.body2" Style="font-weight:600;">
											@(inv.SoLanMuaHang?.ToString() ?? "0") - @(inv.tenkh ?? "")
										</MudText>
										<MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Dense="true"
												   OnClick="@(() => UpdateSearchString(inv.sodienthoai ?? ""))"
												   Style="font-weight:600; padding:0; height:auto; text-transform:none;">
											@(inv.sodienthoai ?? "")
										</MudButton>
									</div>
									<span class="mtl-invoice-loai-pill" style="@GetLoaiPhieuPillStyle(inv.idLoaiPhieu)" title="@GetLoaiPhieuTagLabel(inv.idLoaiPhieu)">
										@GetLoaiPhieuTagLabel(inv.idLoaiPhieu)
									</span>
								</div>
							</MudTd>
							<MudTd DataLabel="N.LẬP" Style="@($"{rowStyle}text-align:center;")">@(inv.ngaylapphieu?.ToString("dd/MM/yyyy") ?? "")</MudTd>
							<MudTd DataLabel="N.HĐ" Style="@($"{rowStyle}text-align:center;")">@(inv.ngaytraphieu?.ToString("dd/MM/yyyy") ?? "")</MudTd>
							<MudTd DataLabel="ĐƠN HÀNG" Style="@rowStyle" Class="mtl-invoice-td-order">
								<MudStack Spacing="1">
									<MudText Typo="Typo.body2" Class="mtl-invoice-order-title">@(inv.ghichukohienbill ?? "")</MudText>
									@if (HasInvoiceOrderMetaLine(inv))
									{
										<MudStack Row="true" Spacing="1" Class="flex-wrap mtl-invoice-order-meta" AlignItems="AlignItems.Center">
											<MudText Typo="Typo.caption" Class="mud-text-secondary mtl-invoice-order-model-label">@InvoiceModelLabel(inv) :</MudText>
											@if (!string.IsNullOrWhiteSpace(inv.ListIDTag))
											{
												@RenderTagChips(inv.ListIDTag)
											}
										</MudStack>
									}
								</MudStack>
							</MudTd>
							<MudTd DataLabel="T.TOÁN" Style="@($"{rowStyle}text-align:right;")">
								<MudText Typo="Typo.body2" Style="font-weight:700; color:var(--mud-palette-error);">
									@FormatCurrency(inv.thanhtoan)
								</MudText>
								<MudText Typo="Typo.caption" Class="mud-text-secondary" Style="line-height:1.25; display:block; max-width:200px; margin-left:auto;">
									@FormatPaymentOneLine(inv)
								</MudText>
							</MudTd>
						</RowTemplate>
						<ChildRowContent Context="inv">
							@if (IsInvoiceExpanded(inv.mahd))
							{
								<MudTr Class="mtl-invoice-detail-tr">
									<MudTd ColSpan="7" Style="padding:0; vertical-align:top;">
										<MudPaper Elevation="0" Class="pa-3 mx-2 mb-2 rounded-lg mtl-invoice-detail-paper">
											<MudStack Spacing="2">
												<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap" Justify="Justify.SpaceBetween">
													<MudText Typo="Typo.caption" Style="font-weight:600;">
														@FormatInvoiceMetaCaption(inv)
													</MudText>
													<MudButton Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Rounded.PointOfSale" Color="Color.Tertiary"
															   OnClick="@(() => UpdateSearchString(inv.sodienthoai ?? ""))">
														@(inv.SoLanMuaHang?.ToString() ?? "0") — @(inv.tenkh ?? "") — @(inv.sodienthoai ?? "")
													</MudButton>
												</MudStack>
												<MudPaper Elevation="0" Class="pa-2 rounded-lg" Style="border:1px solid var(--mud-palette-lines-default); background:var(--mud-palette-surface);">
													<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="flex-wrap">
														<MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" Class="mud-text-secondary" />
														<MudText Typo="Typo.caption" Style="font-weight:600;">Chi tiết thanh toán</MudText>
													</MudStack>
													<MudStack Row="true" Spacing="1" Class="flex-wrap mt-1" AlignItems="AlignItems.Center">
														@foreach (var chip in GetPaymentDetailChips(inv))
														{
															<MudChip T="string" Size="Size.Small" Color="@chip.Color" Variant="Variant.Filled" Icon="@chip.Icon">
																@chip.Text
															</MudChip>
														}
													</MudStack>
													@if ((inv.conlai ?? 0) >= 0.01)
													{
														<MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
															Còn lại / công nợ: <strong style="color:var(--mud-palette-warning);">@FormatCurrency(inv.conlai)</strong>
														</MudText>
													}
												</MudPaper>
												@if (HasInvoiceOrderMetaLine(inv))
												{
													<MudStack Row="true" Spacing="1" Class="flex-wrap mtl-invoice-order-meta" AlignItems="AlignItems.Center">
														<MudText Typo="Typo.caption" Class="mud-text-secondary mtl-invoice-order-model-label">@InvoiceModelLabel(inv) :</MudText>
														@if (!string.IsNullOrWhiteSpace(inv.ListIDTag))
														{
															@RenderTagChips(inv.ListIDTag)
														}
													</MudStack>
												}
												<MudText Typo="Typo.caption" Class="mud-text-secondary">
													Tạo: @GetUserName(inv.iduserlastcreate) @(inv.beginupdate?.ToString("dd/MM/yyyy HH:mm") ?? "") · Cập nhật: @GetUserName(inv.iduserlastupdate) @(inv.lastupdate?.ToString("dd/MM/yyyy HH:mm") ?? "")
												</MudText>
												@if (!string.IsNullOrWhiteSpace(inv.serial))
												{
													<MudText Typo="Typo.caption">Serial: <strong>@inv.serial</strong></MudText>
												}
												<MudDivider Class="my-1" />
												<MudText Typo="Typo.subtitle2" Style="font-weight:600">Chi tiết dòng hàng</MudText>
												<InvoiceChiTietPanel MaHD="@(inv.mahd ?? "")" @key="@($"ct-{inv.mahd}")" />
											</MudStack>
										</MudPaper>
									</MudTd>
								</MudTr>
							}
						</ChildRowContent>
						<FooterContent>
							<MudTd ColSpan="4" Style="text-align:right; font-weight:bold;">Số HĐ: @ActiveInvoiceTabData.Count()</MudTd>
							<MudTd ColSpan="2" Style="text-align:right; font-weight:bold;">Tổng cộng:</MudTd>
							<MudTd Style="text-align:right; font-weight:bold;" Class="mtl-cell-total">@FormatCurrency(ActiveInvoiceTabData.Sum(x => x.thanhtoan))</MudTd>
						</FooterContent>
						<NoRecordsContent>
							<MudText>Không tìm thấy hóa đơn nào.</MudText>
						</NoRecordsContent>
						<LoadingContent>
							<MudText>Đang tải dữ liệu...</MudText>
						</LoadingContent>
						<PagerContent>
							<MudTablePager PageSizeOptions="new int[] { 50, 100 }" />
						</PagerContent>
					</MudTable>
				}
			</MudPaper>
		</div>
	</Authorized>
</AuthorizeView>

@code
{
	DialogOptionsEx options = new DialogOptionsEx
	{
		MaxWidth = MaxWidth.ExtraExtraLarge,
		MaximizeButton = false,
		CloseButton = true,
		Position = DialogPosition.Center,
		DragMode = MudDialogDragMode.Simple,
		CloseOnEscapeKey = true,
		FullScreen = true
	};

