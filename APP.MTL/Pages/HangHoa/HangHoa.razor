	async Task OnEditModelSaving_HangHoaThanhPhan(GridEditModelSavingEventArgs e)
	{
		MTL_GetSanPhamThanhPhanResult thanhphan = (MTL_GetSanPhamThanhPhanResult)e.EditModel;
		int index = ListHangHoaThanhPhan.FindIndex(c => c.idhanghoathanhphan == filter_detail.v_idhanghoathanhphan);
		thanhphan.sl = filter_detail.v_sl;
		thanhphan.giaban = filter_detail.v_dongia;
		thanhphan.idbaohanh = filter_detail.v_baohanh;
		thanhphan.tensp = filter_detail.v_tenspEdit;
		//  thanhphan.idhanghoathanhphan = filter_detail.v_tensp;
		thanhphan.masp = filter_detail.v_masp;
		thanhphan.idhanghoathanhphan = filter_detail.v_idhanghoathanhphan_edittmp;
		thanhphan.thanhtien = thanhphan.sl * thanhphan.giaban;
		thanhphan.beginupdate = DateTime.Now;
		thanhphan.lastupdate = DateTime.Now;
		thanhphan.chietkhau = 0;
		ListHangHoaThanhPhan[index] = thanhphan;
		MyGrid_ThanhPhan.RefreshSummary();
	}

	async Task ShowEditForm_HangHoaThanhPhan(GridCommandColumnCellDisplayTemplateContext context)
	{
		MyGrid_ThanhPhan.BeginUpdate();
		MTL_GetSanPhamThanhPhanResult thanhphan = (context.DataItem as MTL_GetSanPhamThanhPhanResult);
		filter_detail.v_sl = (int)thanhphan.sl;
		filter_detail.v_dongia = (double)thanhphan.giaban;
		filter_detail.v_baohanh = (int)thanhphan.idbaohanh;
		filter_detail.v_tenspEdit = thanhphan.tensp;
		filter_detail.v_tensp = (int)thanhphan.idhanghoathanhphan;
		filter_detail.v_masp = thanhphan.masp;
		filter_detail.v_idhanghoathanhphan = (int)thanhphan.idhanghoathanhphan;
		MyGrid_ThanhPhan.PopupEditFormHeaderText = string.Format("CHỈNH SỬA: {0}", thanhphan.tensp);
		MyGrid_ThanhPhan.StartEditRowAsync(context.VisibleIndex);
		MyGrid_ThanhPhan.EndUpdate();
	}

