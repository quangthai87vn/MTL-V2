	private async Task DongBoWoo(APP.WooRestAPI.Product context)
	{
		product_woo = context;
		string mess = $"Bạn có muốn đồng bộ sản phẩm [{product_woo.name}] ";
		MudBlazor.MessageBoxOptions messs = new MudBlazor.MessageBoxOptions();
		var res = await DialogService.ShowConfirmationDialogAsync("ĐỒNG BỘ DỮ LIỆU", mess, "ĐỒNG Ý", "THOÁT", Icons.Material.Sharp.Abc);

		if (res)
		{
			if (product_woo.sale_price == "") product_woo.sale_price = "0";
			if (product_woo.regular_price == "") product_woo.regular_price = "0";
			product_woo_id = int.Parse(product_woo.id);
			model.WooId = int.Parse(product_woo.id);
			model.Tensp = product_woo.name;
			model.Giaban = double.Parse(product_woo.sale_price);
			model.Giathuong = double.Parse(product_woo.regular_price);
			model.Link = product_woo.permalink;
			if (product_woo.images.Count != 0)
				model.Pic00 = product_woo.images[0].src.ToString();
			if (product_woo.stock_status == "outofstock")
				model.Active = false;
			else if (product_woo.stock_status == "instock")
				model.Active = true;
		}
		else
		{

		}
	}

