	async Task OnPrintButtonClick(MTL_GetAllProductsInCompanyResult product)
	{
		var p = new MTL_GetAllProductsInCompanyResult
		{
			id = product.id,
			tensp = product.tensp
		};
		string noidung = string.Format("{0}", product.tensp);
		var parameters = new DialogParameters<HangHoaPrintDialog>();
		parameters.Add(x => x.NoiDung, noidung);
		parameters.Add(x => x.product, p);
		string headerText = "IN THÔNG TIN HÀNG HÓA";
		var dialog = await DialogService.ShowEx<HangHoaPrintDialog>(headerText, parameters, options);
		var result = await dialog.Result;
	}

	async Task XoaHangHoaDialog(MTL_GetAllProductsInCompanyResult product)
	{
		string noidungXoa = string.Format("{0}", product.tensp);
		string linkAnhXoa = userSession.company.Logourl;
		if (product.hinhanh1 != null)
			linkAnhXoa = string.Format("{0}", product.hinhanh1);
		var parameters = new DialogParameters<DeleteDialog>();
		parameters.Add(x => x.NoiDung, noidungXoa);
		parameters.Add(x => x.LinkAnh, linkAnhXoa);
		parameters.Add(x => x.OnDeleteCallback, EventCallback.Factory.Create<string>(this, async _ =>
		{
			await hangHoaService.DeleteProductAsync(product.id);
			await FilterDataList();
			string mess = $"Xóa thành công hàng hóa [{product.tensp}]";
			_HandleCommon.OpenSusscessSnackbarDialog(SnackbarService, mess);
		}));
		var dialog = await DialogService.ShowEx<DeleteDialog>("XÓA HÀNG HÓA", parameters, options);
		var result = await dialog.Result;
	}

	TblSanpham ToProduct(MTL_GetAllProductsInCompanyResult mtl_sanpham, bool isNew)
	{
		_sanpham.Idcompany = userSession.company.Id;
