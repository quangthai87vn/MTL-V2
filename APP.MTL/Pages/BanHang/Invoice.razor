	async Task ExportExcel()
	{
		var src = _filteredData?.ToList() ?? new List<MTL_GetAllInvoiceResult>();
		if (!src.Any())
		{
			SnackbarService.Add("Không có dữ liệu để xuất.", Severity.Warning);
			return;
		}
		var exportData = src.Select(d => new
		{
			d.mahd,
			NgayLap = d.ngaylapphieu?.ToString("dd/MM/yyyy"),
			NgayHD = d.ngaytraphieu?.ToString("dd/MM/yyyy"),
			d.ghichukohienbill,
			d.sodienthoai,
			d.tenkh,
			d.giamgia,
			d.thanhtoan,
			d.conlai,
			LoaiPhieu = GetLoaiPhieuText(d.idLoaiPhieu),
			NguoiXuat = GetNguoiXuatText(d.idnguoixuat),
			d.serial
		}).ToList();
		try
		{
			await JSRuntime.InvokeVoidAsync("exportToExcel",
				"DanhSachHoaDon",
				new[] { "Mã HĐ", "Ngày lập", "Ngày HĐ", "Thông tin đơn hàng", "SĐT", "Khách hàng", "Thành tiền", "Thanh toán", "Nợ", "Loại phiếu", "Người xuất", "Serial" },
				exportData.Select(e => new object[] { e.mahd, e.NgayLap, e.NgayHD, e.ghichukohienbill, e.sodienthoai, e.tenkh, e.giamgia, e.thanhtoan, e.conlai, e.LoaiPhieu, e.NguoiXuat, e.serial }).ToList());
			SnackbarService.Add("Đã xuất file Excel.", Severity.Success);
		}
		catch (JSException)
		{
			SnackbarService.Add("Không xuất được Excel (thiếu thư viện XLSX).", Severity.Error);
		}
	}

