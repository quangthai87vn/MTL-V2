	async Task<MTL.APP.WooRestAPI.Product> SaveWoocommerce(bool isUpdate, bool isCreateContentAuto)
	{
		MTL.APP.WooRestAPI.Product product_return = new APP.WooRestAPI.Product();
		try
		{
			int? wooid = model.WooId;
			List<string> url_image = new List<string>();
			List<string> WooidCategory = new List<string>();
			double sale_price = (double)model.Giaban;
			string stock_status = "";
			double regular_price = (double)model.Giathuong;
			if (model.Active == null)
			{
				stock_status = "instock";
			}
			else
			{
				if ((bool)!model.Active) stock_status = "outofstock";
				else stock_status = "instock";
			}
			MTL.APP.WooRestAPI.Product new_pr = new MTL.APP.WooRestAPI.Product();
			new_pr.name = model.Tensp;
			new_pr.sale_price = sale_price.ToString();
			new_pr.stock_status = stock_status;
			new_pr.regular_price = regular_price.ToString();
			new_pr.slug = _HandleCommon.RemoveIllegalCharacters(model.Tensp);
			new_pr.categories = this.GetWooIdCategory(_filterAPI.v_wooid_all);

			if (isCreateContentAuto) // true tạo content
			{
				new_pr.description = block_woo_sanpham_ghepnoi;
			}
			

			if (isUpdate == true)
			{
				if (wooid != null && wooid != 0)
				{
					new_pr.id = wooid.ToString();
					product_return = await wooAPIService.UpdateProductAsync(new_pr, Wookey, Woosecret, Woourl);
					model.Link = product_return.permalink;
					if (product_return.images.Count > 0)
						model.Hinhanh1 = product_return.images[0].src.ToString();
				}
			}
			else
			{
				if (product_woo_id == 0)
				{
					// tạo mới , chưa có lần nào
					product_return = await wooAPIService.CreateProductAsync(new_pr, Wookey, Woosecret, Woourl);
				}
				else
				{
					// cập nhật,
					product_return = await wooAPIService.UpdateProductAsync(new_pr, Wookey, Woosecret, Woourl);
				}
				model.Link = product_return.permalink;
				if (product_return.images.Count > 0)
					model.Hinhanh1 = product_return.images[0].src.ToString();
			}
		}
		catch (Exception)
		{

		}

		return product_return;
	}

	List<MTL.APP.WooRestAPI.Category> GetWooIdCategory(string wooid_all)
	{
		List<string> WooidCategory = new List<string>();
		string[] arrayStr = wooid_all.Split(new string[] { "-" }, StringSplitOptions.RemoveEmptyEntries);
		for (int i = 0; i < arrayStr.Length; i++)
		{
			WooidCategory.Add(arrayStr[i]);
		}
		List<MTL.APP.WooRestAPI.Category> ct = new List<MTL.APP.WooRestAPI.Category> { };
		foreach (string phantu in WooidCategory)
		{
			ct.Add(new MTL.APP.WooRestAPI.Category { id = phantu });
		}

		return ct;
	}

