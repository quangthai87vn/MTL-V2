	async Task LoadConfigFromCompany()
	{
		userSession = await configs.LoadAllConfig();
		idcompany = userSession?.company?.Id ?? 0;
		if (userSession?.company != null)
		{
			Wookey = userSession.company.Wookey;
			Woosecret = userSession.company.Woosecret;
			Woourl = userSession.company.Woourl;
			_filter.v_sodong = userSession.company.Sodonghienthi;
		}
	}

	/// <summary>Tải toàn bộ dữ liệu trang — gọi từ OnInitializedAsync (Blazor Server, có circuit + JS).</summary>
	async Task LoadProductPageDataAsync()
	{
		try
		{
			IsLoading = true;
			await LoadConfigFromCompany();
			if (idcompany <= 0)
			{
				ListProduct = new List<MTL_GetAllProductsInCompanyResult>();
				SnackbarService.Add("Không lấy được mã công ty. Vui lòng đăng nhập lại.", Severity.Error);
				return;
			}

			await FilterDataList();
			NhomHangParentList = await hangHoaService.MTL_GetAllNhomHangAsync(_filter.v_loaihh, idcompany);
			ThuongHieuList = await hangHoaService.GetThuongHieuAllAsync(idcompany);
			BaoHanhList = await hangHoaService.GetBaoHanhAsync();
			ViTriList = await hangHoaService.GetViTriAsync(idcompany);
			DVTList = await hangHoaService.GetDonViTinhAsync();
			LoaiHHDVList = MTLEnum.GetListLoaiHinhKD();
			UserList = await userService.GetAllUserCompanyAsync(idcompany);
		}
		catch (Exception ex)
		{
			ListProduct = new List<MTL_GetAllProductsInCompanyResult>();
			SnackbarService.Add($"Lỗi tải hàng hóa: {ex.Message}", Severity.Error);
			Console.WriteLine($"[Product.razor] {ex}");
		}
		finally
		{
			IsLoading = false;
		}
	}

	async Task FilterDataList()
	{
		if (idcompany <= 0)
		{
			ListProduct = new List<MTL_GetAllProductsInCompanyResult>();
			return;
		}
		IsLoading = true;
		try
		{
			var rows = await hangHoaService.GetAllProductCompanyAsync(idcompany, _filter.v_tonkho, 0, _filter.v_theongay);
			ListProduct = rows ?? new List<MTL_GetAllProductsInCompanyResult>();
		}
		finally
		{
			IsLoading = false;
		}
	}

