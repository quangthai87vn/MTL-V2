@page "/ThuongHieu"
@using Blazored.LocalStorage;
@using Blazored.Toast
@using Blazored.Toast.Services
@using MTL.APP.Models
@using MTL.APP.Services
@using MTL.APP.Utils
@using MudBlazor.Extensions.Options
@inject IJSRuntime JSRuntime
@inject HangHoaService hangHoaService
@inject UserService userService
@inject IToastService toastService
@inject Configs configs
@inject ISnackbar SnackbarService
@inject MudBlazor.IDialogService DialogService
@attribute [Authorize]
<AuthorizeView>
	<Authorized>
		<PageStandardHeader Icon="@Icons.Material.Filled.BrandingWatermark" Title="THƯƠNG HIỆU">
			<Actions>
				<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
					<MudButton Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" Class="mtl-header-action-btn"
							   Disabled=IsLoading OnClick="ThemThuongHieuDialog" Color="Color.Primary">THÊM THƯƠNG HIỆU</MudButton>
				</MudStack>
			</Actions>
			<ChildContent>
				<MudTextField @bind-Value="searchString" Placeholder="Gõ nội dung cần tìm..." Adornment="Adornment.Start"
							  Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" FullWidth="true"
							  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mtl-page-header-search" />
			</ChildContent>
		</PageStandardHeader>

		<MudPaper Elevation="3" Class="rounded-lg overflow-hidden mb-3">
			@if (IsLoading)
			{
				<Loading IsFullPage="false" PageName="THƯƠNG HIỆU" />
			}
			else
			{
				<MudDivider Class="mud-width-full" />
				<MudTable Items="@ThuongHieuList"
					  Hover="true"
					  Striped="true"
					  Bordered="true"
					  Dense="true"
					  RowsPerPage="50"
					  Class="mudtable-center-header mtl-standard-grid"
					  Filter="new Func<MTL_GetAllThuongHieuResult,bool>(FilterFunc1)"
					  Loading="IsLoading"
					  LoadingProgressColor="Color.Primary">
				<ToolBarContent>
					<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="px-2 py-1" Style="width:100%; min-height:48px;">
						<MudIcon Icon="@Icons.Material.Filled.ViewColumn" Size="Size.Small" Style="opacity:0.85" />
						<MudText Typo="Typo.subtitle2" Style="font-weight:600">Bảng dữ liệu</MudText>
						<MudText Typo="Typo.caption" Class="mud-text-secondary">Ẩn/hiện cột: biểu tượng bên phải</MudText>
						<MudSpacer />
					</MudStack>
				</ToolBarContent>
				<HeaderContent>
					<MudTh Style="width:100px; text-align:center;">THAO TÁC</MudTh>
					<MudTh Style="width:200px;">THƯƠNG HIỆU</MudTh>
					<MudTh Style="width:100px;">SP LIÊN QUAN</MudTh>
					<MudTh Style="width:80px;">THỨ TỰ</MudTh>
					<MudTh Style="width:100px;">VIẾT TẮT</MudTh>
					<MudTh Style="width:150px;">NGÀY TẠO</MudTh>
					<MudTh Style="width:150px;">NGÀY UPDATE</MudTh>
				</HeaderContent>
				<RowTemplate Context="contextThuongHieu">
					<MudTd DataLabel="THAO TÁC" Style="text-align:center;">
						<MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" OverrideStyles=false>
							<MudIconButton @onclick="@(() => SuaThuongHieuDialog(contextThuongHieu))"
										   Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled"
										   Color="Color.Primary" Size="Size.Small" Title="Sửa" />
							<MudIconButton @onclick="@(() => XoaThuongHieuDialog(contextThuongHieu))"
										   Icon="@Icons.Material.Filled.Delete" Variant="Variant.Filled"
										   Color="Color.Error" Size="Size.Small" Title="Xóa" />
						</MudButtonGroup>
					</MudTd>
					<MudTd DataLabel="THƯƠNG HIỆU">@contextThuongHieu.thuonghieu</MudTd>
					<MudTd DataLabel="SP LIÊN QUAN">
						<MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">
							@contextThuongHieu.soluongsanphamlienquan
						</MudChip>
					</MudTd>
					<MudTd DataLabel="THỨ TỰ">@contextThuongHieu.order</MudTd>
					<MudTd DataLabel="VIẾT TẮT">@contextThuongHieu.viettat</MudTd>
					<MudTd DataLabel="NGÀY TẠO">@contextThuongHieu.beginupdate</MudTd>
					<MudTd DataLabel="NGÀY UPDATE">@contextThuongHieu.lastupdate</MudTd>
				</RowTemplate>
				<NoRecordsContent>
					<MudText>Không tìm thấy dữ liệu.</MudText>
				</NoRecordsContent>
				<LoadingContent>
					<MudText>Đang tải dữ liệu...</MudText>
				</LoadingContent>
				<PagerContent>
					<MudTablePager PageSizeOptions="new int[] { 10, 20, 50, 100 }" />
				</PagerContent>
				</MudTable>
			}
		</MudPaper>
	</Authorized>
</AuthorizeView>
	@code
	{
	UserSession userSession { get; set; }
	bool IsLoading = true;
	DialogOptionsEx options = new DialogOptionsEx
		{
			MaxWidth = MaxWidth.Medium,
			MaximizeButton = true,
			CloseButton = true,
			Position = DialogPosition.Center,
			DragMode = MudDialogDragMode.Simple,
			CloseOnEscapeKey = true,
			 
		};
	List<MTL_GetAllThuongHieuResult>? ThuongHieuList { get; set; }
	IEnumerable<MTL_GetAllUserCompanyResult>? UserList { get; set; }

	MTL.APP.Utils.HandleCommon _HandleCommon = new MTL.APP.Utils.HandleCommon();
	private string searchString = "";
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			userSession = await configs.LoadAllConfig();
			ThuongHieuList = await hangHoaService.GetThuongHieuAllAsync(userSession.company.Id);
			UserList = await userService.GetAllUserCompanyAsync(userSession.company.Id);
			IsLoading = false;
			StateHasChanged();
		}
		await base.OnAfterRenderAsync(firstRender);
	}

	TblThuonghieu convertMTL(MTL_GetAllThuongHieuResult mtl_thuonghieu)
	{
		TblThuonghieu _thuonghieu = new TblThuonghieu();
		_thuonghieu.Thuonghieu = mtl_thuonghieu.thuonghieu;
		_thuonghieu.Viettat = mtl_thuonghieu.viettat.Replace(" ", "");
		_thuonghieu.Order = mtl_thuonghieu.order;
		_thuonghieu.Active = mtl_thuonghieu.active;
		_thuonghieu.Idcompany = userSession.company.Id;
		_thuonghieu.Id = mtl_thuonghieu.id;
		_thuonghieu.Beginupdate = mtl_thuonghieu.beginupdate;
		_thuonghieu.Lastupdate = DateTime.Now;
		_thuonghieu.Iduserlastcreate = mtl_thuonghieu.iduserlastcreate;
		_thuonghieu.Iduserlastupdate = userSession.user.UserId;
		return _thuonghieu;
	}

	async Task XoaThuongHieuDialog(MTL_GetAllThuongHieuResult context)
	{
		MTL_GetAllThuongHieuResult _THIEU = context;
		string NoiDungXoa = string.Format("THƯƠNG HIỆU: {0}", _THIEU.thuonghieu);
		var parameters = new DialogParameters<DeleteDialog>();
		parameters.Add(x => x.NoiDung, NoiDungXoa);
		var dialog = await DialogService.ShowEx<DeleteDialog>("XÓA THÔNG TIN", parameters, options);
		var result = await dialog.Result;
		if (!result.Canceled)
		{
			await hangHoaService.DeleteThuongHieuAsync(_THIEU.id);
			string mess = $"Xóa thành công {_THIEU.thuonghieu} ";
			_HandleCommon.OpenSusscessSnackbarDialog(SnackbarService, mess);
			ThuongHieuList = await hangHoaService.GetThuongHieuAllAsync(userSession.company.Id);
		}
	}

	async Task ThemThuongHieuDialog()
	{
		var parameters = new DialogParameters<DialogAddThuongHieu>();
		parameters.Add(x => x.isNew, true);
		parameters.Add(x => x.userSession, userSession);
		string headerText = "THÊM THƯƠNG HIỆU MỚI";
		var dialog = await DialogService.ShowEx<DialogAddThuongHieu>(headerText, parameters, options);
		var result = await dialog.Result;
		if (!result.Canceled)
		{
			ThuongHieuList = await hangHoaService.GetThuongHieuAllAsync(userSession.company.Id);
		}
	}

	async Task SuaThuongHieuDialog(MTL_GetAllThuongHieuResult context)
	{
		TblThuonghieu thieu = convertMTL(context);
		var parameters = new DialogParameters<DialogAddThuongHieu>();
		parameters.Add(x => x.isNew, false);
		parameters.Add(x => x.userSession, userSession);
		parameters.Add(x => x.thuonghieu, thieu);
		string headerText = "SỬA THƯƠNG HIỆU";
		var dialog = await DialogService.ShowEx<DialogAddThuongHieu>(headerText, parameters, options);
		var result = await dialog.Result;
		if (!result.Canceled)
		{
			ThuongHieuList = await hangHoaService.GetThuongHieuAllAsync(userSession.company.Id);
		}
	}
	private bool FilterFunc1(MTL_GetAllThuongHieuResult element) => FilterFunc(element, searchString);
	private bool FilterFunc(MTL_GetAllThuongHieuResult element, string searchString)
	{
		if (string.IsNullOrWhiteSpace(searchString))
			return true;
		if (element.thuonghieu.Contains(searchString, StringComparison.OrdinalIgnoreCase))
			return true;		
		return false;
	}
}