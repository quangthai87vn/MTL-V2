@page "/Report/{MaHD}/{KieuIn}"
@inject NavigationManager Nav

@code {
	[Parameter] public string MaHD { get; set; } = "";
	[Parameter] public string KieuIn { get; set; } = "";

	protected override void OnInitialized()
	{
		var k = (KieuIn ?? "").Trim().ToUpperInvariant();
		if (k == "A4")
			Nav.NavigateTo($"/HoaDon/A4/{MaHD}", replace: true);
		else if (k == "BILL")
			Nav.NavigateTo($"/HoaDon/BILL/{MaHD}", replace: true);
		else
			Nav.NavigateTo("/invoice", replace: true);
	}
}
