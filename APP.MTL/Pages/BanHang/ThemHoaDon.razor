				hdbh.Idhinhthucthanhtoan = MTLEnum.HinhThucThanhToan.TienMat;

				ListHoaDonChiTiet = null;
				_filter.v_tensp = 1;
				_filter.v_SPAo = false;
				_filter.v_tenspEdit = "";
				_filter.v_sl = 1;
				_filter.v_dongia = 0;
				_filter.v_baohanh = 3;// 3 tháng
				_filter.v_model = ""; // xóa modell
				hdbh.IdLoaiPhieu = IdLoaiPhieu;
