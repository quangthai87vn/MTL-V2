		_sanpham.Link = mtl_sanpham.link;
		_sanpham.Idnhomhang = mtl_sanpham.idnhomhang;
		_sanpham.Idthuonghieu = mtl_sanpham.idthuonghieu;
		_sanpham.Idvitri = mtl_sanpham.idvitri;
		_sanpham.IdBaoHanh = mtl_sanpham.idBaoHanh;
		_sanpham.Iddonvitinh = mtl_sanpham.iddonvitinh;
		_sanpham.Giaban = mtl_sanpham.giaban;
		_sanpham.Giathuong = mtl_sanpham.giathuong;
		_sanpham.Giavon = mtl_sanpham.giavon;
		_sanpham.Mota = mtl_sanpham.mota;
		_sanpham.Motachitiet = mtl_sanpham.motachitiet;
		_sanpham.Ssd = mtl_sanpham.ssd;
		_sanpham.Ram = mtl_sanpham.ram;
		_sanpham.Cpu = mtl_sanpham.cpu;
		_sanpham.Vga = mtl_sanpham.vga;
		_sanpham.Active = !mtl_sanpham.hethang;
		_sanpham.Beginupdate = mtl_sanpham.beginupdate;
		_sanpham.Lastupdate = DateTime.Now;
		_sanpham.Iduserlastcreate = mtl_sanpham.iduserlastcreate;
		_sanpham.Iduserlastupdate = userSession.user.UserId;
		_sanpham.Isdelete = false; // ko xóa
		_sanpham.Hinhanh1 = mtl_sanpham.hinhanh1;
		_sanpham.Hinhanh2 = mtl_sanpham.hinhanh2;
		_sanpham.Hinhanh3 = mtl_sanpham.hinhanh3;
		_sanpham.Hinhanh4 = mtl_sanpham.hinhanh4;
		_sanpham.Hinhanh5 = mtl_sanpham.hinhanh5;
		_sanpham.Pic00 = image_product;
		_sanpham.Video = mtl_sanpham.video;
		_sanpham.Mavach = mtl_sanpham.mavach;
		_sanpham.WooId = mtl_sanpham.woo_id;
