		parameters.Add(x => x.NoiDung, $"Menu: {context._name}");
		string tieude = $"XÓA MENU CẤP CHO CÔNG TY [{_Company.Name}]";
		var dialog = await DialogService.ShowEx<DeleteDialog>(tieude, parameters, options);
		var result = await dialog.Result;
		if (!result.Canceled)
		{
			UnGrant_Menu = context;
			MenuOfCompany MOC = new MenuOfCompany();
			MOC.Idmenu = UnGrant_Menu.id;
